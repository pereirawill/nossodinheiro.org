---
import Base from "../layouts/Base.astro";
import Termo from "../components/Termo.astro";
import Glossario from "../components/Glossario.astro";
import { cada100 } from "../lib/cada100";
import funcoes from "../../public/data/poderes_funcao_2025.json";
import poderes from "../../public/data/poderes_2025.json";
import categorias from "../../public/data/poderes_categoria_2025.json";
import estados from "../../public/data/estados_2025.json";
import municipios from "../../public/data/municipios_2025.json";
import metaMun from "../../public/data/municipios_meta_2025.json";
import impostos from "../../public/data/impostos.json";
import divida from "../../public/data/divida.json";
import estatais from "../../public/data/estatais.json";
import saneamento from "../../public/data/saneamento.json";
import dep from "../../public/data/custo_deputado_2026.json";
import metaDep from "../../public/data/meta_2026.json";
import sen from "../../public/data/custo_senador_2026.json";
import metaSen from "../../public/data/meta_senado_2026.json";
import stf from "../../public/data/custo_ministro_stf_2026.json";
import metaStf from "../../public/data/meta_stf_2026.json";
import pres from "../../public/data/presidencia_cpgf_2026.json";
import rankings from "../../public/data/rankings.json";
import trabalho from "../../public/data/trabalho.json";
import renda from "../../public/data/renda.json";
import educacao from "../../public/data/educacao.json";
import seguranca from "../../public/data/seguranca.json";
import credito from "../../public/data/credito.json";
import saudeDados from "../../public/data/saude.json";  // "saude" já é usado abaixo para a função 10 da União
import inflacao from "../../public/data/inflacao.json";
import corrupcao from "../../public/data/corrupcao.json";
import previdencia from "../../public/data/previdencia.json";
import irpf from "../../public/data/irpf.json";
import obras from "../../public/data/obras.json";

const ANO = 2025;
const rendaPub = (renda.posicoes as any[]).find((p) => p.chave === "publico")?.valor ?? 0;
const rendaPriv = (renda.posicoes as any[]).find((p) => p.chave === "privado_com_carteira")?.valor ?? 1;
const top1 = (renda.distribuicao.classes as any[]).find((c) => c.classe === "p99_mais")?.massa_pct;
const idebAI = (educacao.brasil as any).ai?.total?.[String(educacao.ano)];
const inssTotal = (previdencia.especies as any[]).find((e) => e.chave === "total");
const inssAposent = (previdencia.especies as any[]).find((e) => e.chave === "aposentadorias");
const brl0 = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
// Na página inicial, por extenso: "R$ 5,06 trilhões", "R$ 30,4 bilhões", "R$ 224 milhões"
const compact = (v: number) =>
  v >= 1e12 ? `R$ ${(v / 1e12).toFixed(2).replace(".", ",")} trilhões` : v >= 1e9 ? `R$ ${(v / 1e9).toFixed(1).replace(".", ",")} bilhões` : v >= 1e6 ? `R$ ${(v / 1e6).toFixed(0)} milhões` : brl0(v);
const pct = (a: number, b: number) => `${Math.round((a / b) * 100)}%`;
const POP = 212_600_000;

// União: por função (LOA). Encargos especiais (função 28) = dívida e transferências a estados/municípios — separado.
const uniaoTotal = poderes.reduce((s, p) => s + p.pago, 0);
const encargos = funcoes.find((f) => f.funcao === "28")?.pago ?? 0;
const uniaoSemEncargos = uniaoTotal - encargos;
const fTop = funcoes.filter((f) => f.funcao !== "28").sort((a, b) => b.pago - a.pago);
const topN = fTop.slice(0, 9);
const outros = fTop.slice(9).reduce((s, f) => s + f.pago, 0);
const fatias = [...topN.map((f) => ({ nome: f.funcao_nome, v: f.pago })), { nome: "Demais funções", v: outros }];
// Cores bem distintas entre si (a pizza tem 10 fatias; tons parecidos confundem)
const CORES = ["#1d5a8a", "#e07b00", "#1f9d55", "#c2185b", "#6a1b9a", "#8d6e63", "#00a3c4", "#f1c232", "#d32f2f", "#9e9e9e"];
// A pizza cabe em 10 fatias, mas a tabela lista TODAS as funções: senão Segurança Pública, Transporte e Cultura
// somem dentro de "Demais funções" e parece que não existem (a pergunta veio do dono em 29/10/2026).
const todasFuncoes = fTop.map((f, i) => ({ nome: f.funcao_nome, v: f.pago, cor: i < 9 ? CORES[i] : "#9e9e9e" }));
const R = 86, C = 100; let ang = -Math.PI / 2;
const arcos = fatias.map((f, i) => { const fr = f.v / uniaoSemEncargos; const a0 = ang; ang += fr * 2 * Math.PI;
  const x0 = C + R * Math.cos(a0), y0 = C + R * Math.sin(a0), x1 = C + R * Math.cos(ang), y1 = C + R * Math.sin(ang);
  return { ...f, fr, cor: CORES[i], d: `M${C},${C} L${x0.toFixed(2)},${y0.toFixed(2)} A${R},${R} 0 ${fr > 0.5 ? 1 : 0} 1 ${x1.toFixed(2)},${y1.toFixed(2)} Z` }; });

// A mesma despesa COM dívida e transferências dentro (pedido de 28/10): a função 28 entra como fatia própria.
const fatiasCom = [{ nome: "Dívida e transferências (encargos especiais)", v: encargos },
                   ...fTop.slice(0, 8).map((f) => ({ nome: f.funcao_nome, v: f.pago })),
                   { nome: "Demais funções", v: fTop.slice(8).reduce((t, f) => t + f.pago, 0) }];
const CORES_COM = ["#444444", "#1d5a8a", "#e07b00", "#1f9d55", "#c2185b", "#6a1b9a", "#8d6e63", "#00a3c4", "#f1c232", "#9e9e9e"];
let angC = -Math.PI / 2;
const arcosCom = fatiasCom.map((f, i) => { const fr = f.v / uniaoTotal; const a0 = angC; angC += fr * 2 * Math.PI;
  const x0 = C + R * Math.cos(a0), y0 = C + R * Math.sin(a0), x1 = C + R * Math.cos(angC), y1 = C + R * Math.sin(angC);
  return { ...f, fr, cor: CORES_COM[i], d: `M${C},${C} L${x0.toFixed(2)},${y0.toFixed(2)} A${R},${R} 0 ${fr > 0.5 ? 1 : 0} 1 ${x1.toFixed(2)},${y1.toFixed(2)} Z` }; });

// Três níveis de governo
const estTotal = estados.reduce((s, e) => s + e.pago_total, 0);
const munTotal = metaMun.totais.pago_total;
const somaF = (k: string) => estados.reduce((s, e) => s + ((e as any)[k] || 0), 0);
const somaM = (k: string) => municipios.reduce((s, m) => s + ((m as any)[k] || 0), 0);
const uf = (cod: string) => funcoes.find((f) => f.funcao === cod)?.pago ?? 0;
// O que a União aplica DIRETO, sem os repasses a estados e municípios: é o único valor que pode ser somado ao
// gasto deles. Na saúde de 2025 são R$ 52,6 bi de R$ 216,0 bi — o resto é fundo a fundo e reaparece embaixo.
const ufDireta = (cod: string) => {
  const f = funcoes.find((x) => x.funcao === cod) as any;
  return f ? (f.pago_aplicacao_direta ?? f.pago) : 0;
};
const ufTransferido = (cod: string) => (funcoes.find((x) => x.funcao === cod) as any)?.pago_transferido_entes ?? 0;
const C100 = cada100({ funcoes: funcoes as any[], poderes: poderes as any[], categorias: categorias as any[],
                    estados: estados as any[], municipios: municipios as any[] });
// pizza de "cada R$ 100": 8 destinos + "todo o resto", mesma geometria e paleta das roscas abaixo
const fatias100 = [...C100.destinos, { nome: "Todo o resto", v: C100.resto }];
let ang100 = -Math.PI / 2;
const arcos100 = fatias100.map((f, i) => { const fr = f.v / C100.base; const a0 = ang100; ang100 += fr * 2 * Math.PI;
  const x0 = 100 + 86 * Math.cos(a0), y0 = 100 + 86 * Math.sin(a0), x1 = 100 + 86 * Math.cos(ang100), y1 = 100 + 86 * Math.sin(ang100);
  return { ...f, fr, cor: f.nome === "Todo o resto" ? "#9e9e9e" : CORES[i],
           d: `M100,100 L${x0.toFixed(2)},${y0.toFixed(2)} A86,86 0 ${fr > 0.5 ? 1 : 0} 1 ${x1.toFixed(2)},${y1.toFixed(2)} Z` }; });
const niveis = [
  { nome: "Saúde", uniao: ufDireta("10"), repasse: ufTransferido("10"), estados: somaF("pago_saude"), municipios: somaM("pago_saude") },
  { nome: "Educação", uniao: ufDireta("12"), repasse: ufTransferido("12"), estados: somaF("pago_educacao"), municipios: somaM("pago_educacao") },
  { nome: "Previdência", uniao: ufDireta("09"), estados: somaF("pago_previdencia"), municipios: null },
  { nome: "Segurança pública", uniao: ufDireta("06"), estados: somaF("pago_seguranca"), municipios: null },
  { nome: "Legislativo", uniao: ufDireta("01"), estados: somaF("pago_legislativa"), municipios: somaM("pago_legislativo") },
  { nome: "Judiciário", uniao: ufDireta("02"), estados: somaF("pago_judiciaria"), municipios: null },
  { nome: "Administração", uniao: ufDireta("04"), estados: somaF("pago_administracao"), municipios: somaM("pago_administracao") },
];
const maxNivel = Math.max(...niveis.map((n) => n.uniao + n.estados + (n.municipios ?? 0)));
const maquina = categorias.filter((c) => c.categoria === "Manter a máquina" && c.poder !== "Dívida/Transferências").reduce((s, c) => s + c.pago, 0);

// Cartões dos painéis
const jurosUlt = (divida.anos_juros as string[])[(divida.anos_juros as string[]).length - 1];
const jurosValor = (divida.juros_nominais as Record<string, number>)[jurosUlt];
const estatalUlt = (estatais as any).sest.anos[(estatais as any).sest.anos.length - 1];
const estatalLucro = (estatais as any).sest.agregado[estatalUlt];
const esgotoCenso = (saneamento as any).censo["2022"].esgoto;
const mediaDep = dep.reduce((s, r) => s + r.custo_total_estimado, 0) / dep.length / metaDep.meses_considerados;
const mediaSen = sen.reduce((s, r) => s + r.custo_total_estimado, 0) / sen.length / metaSen.meses_considerados;
const mediaStf = stf.reduce((s, r) => s + r.custo_mensal_medio, 0) / stf.length;
const arrec = impostos.anual[impostos.anual.length - 1];
const idh = (rankings.indices as any[]).find((i) => i.id === "idh")?.brasil;
const W = 920;
// Conclusões factuais, calculadas dos próprios dados (sem opinião)
const prev = uf("09"), saude = uf("10"), educ = uf("12"), assist = uf("08");
const resumo = [
  `De cada R$ 100 que a União pagou em ${ANO}, R$ ${Math.round(100 * encargos / uniaoTotal)} foram dívida e transferências a estados e municípios; R$ ${Math.round(100 * uniaoSemEncargos / uniaoTotal)} viraram políticas públicas e custo da máquina.`,
  `Da parte que não é dívida, ${pct(prev, uniaoSemEncargos)} é Previdência (${compact(prev)}). Saúde (${compact(saude)}) e Educação (${compact(educ)}) juntas ficam com ${pct(saude + educ, uniaoSemEncargos)}; Assistência Social, onde está o Bolsa Família, com ${pct(assist, uniaoSemEncargos)}.`,
  `Manter a máquina dos três Poderes (pessoal, aposentados, custeio) custou ${compact(maquina)}: ${pct(maquina, uniaoSemEncargos)} do que não é dívida.`,
  `Estados e municípios pagaram juntos ${compact(estTotal + munTotal)}, mais do que a União gastou em políticas e máquina (${compact(uniaoSemEncargos)}). Saúde e educação são, na prática, estaduais e municipais: da saúde paga no país, ${pct(somaF("pago_saude") + somaM("pago_saude"), ufDireta("10") + somaF("pago_saude") + somaM("pago_saude"))} sai do caixa deles — e boa parte desse dinheiro vem da própria União, que repassou ${compact(ufTransferido("10"))} fundo a fundo e por isso não entra duas vezes nesta conta.`,
  `Somar os três níveis exige cuidado: o que a União repassa a estados e municípios reaparece no gasto de quem recebeu, e o refinanciamento da dívida não é despesa nova. Tirando a dívida e as transferências, a União aplicou direto ${compact(uniaoSemEncargos)}; com estados e municípios, dá ${brl0((uniaoSemEncargos + estTotal + munTotal) / POP)} por habitante no ano.`,
];
const irpfTopo = irpf.faixas[irpf.faixas.length - 1];
const irpfPico = irpf.faixas.reduce((a, f) => (f.aliquota_efetiva ?? 0) > (a.aliquota_efetiva ?? 0) ? f : a, irpf.faixas[0]);
const pctIrpf = `${(100 * (irpfTopo.aliquota_efetiva ?? 0)).toFixed(1).replace(".", ",")}%`;
const pctIrpfPico = `${(100 * (irpfPico.aliquota_efetiva ?? 0)).toFixed(1).replace(".", ",")}%`;
const irpfMi = (irpf.declarantes / 1e6).toFixed(1).replace(".", ",");
const obrasParadas = obras.paradas.n.toLocaleString("pt-BR");
const obrasPrevisto = `R$ ${(obras.paradas.previsto / 1e9).toFixed(1).replace(".", ",")} bi`;
---
<Base title="Nosso Dinheiro — para onde vai o dinheiro público do Brasil" description="Quanto custa um deputado, para onde vão as emendas, quanto custa cada Poder. Dados oficiais, com a fonte de cada número e metodologia aberta." accent="var(--s1)">
  <h1>Para onde vai o nosso dinheiro?</h1>
  <p class="lede">
    O panorama: quanto a União, os estados e os municípios pagaram em {ANO}, em que, e quanto custa cada parte do Estado.
    Cada número tem a fonte oficial ao lado; o detalhe está nas abas. Sem nota, sem ranking de "bom ou ruim", sem opinião.
  </p>
  <p class="meta">fontes: SIOP (União, {ANO}), SICONFI/Tesouro (estados e municípios, {ANO}), Receita Federal, Câmara, Senado, STF, Portal da Transparência · <a href="/metodologia/">metodologia</a></p>

  <div class="hero">
    <div class="stat big"><b>{compact(uniaoTotal)}</b><span>pagos pela <strong>União</strong> em {ANO} · {compact(encargos)} são dívida e transferências a estados e municípios; {compact(uniaoSemEncargos)} em políticas e máquina</span></div>
    <div class="stat"><b>{compact(estTotal)}</b><span>pagos pelos <strong>26 estados e DF</strong> em {ANO}</span></div>
    <div class="stat"><b>{compact(munTotal)}</b><span>pagos por <strong>{metaMun.municipios_com_dca.toLocaleString("pt-BR")} municípios</strong> em {ANO}</span></div>
  </div>
  <div class="hero" style="margin-top:0">
    <div class="stat"><b>{compact(arrec.total)}</b><span>arrecadados pela União em {arrec.meses} meses de {arrec.ano} · <a href="/impostos/">impostos</a></span></div>
    <div class="stat"><b>{compact(maquina)}</b><span><Termo t="maquina">manter a máquina</Termo> dos três Poderes da União em {ANO} ({pct(maquina, uniaoSemEncargos)} do que não é dívida) · <a href="/poderes/">Poderes</a></span></div>
    <div class="stat"><b>{brl0((uniaoSemEncargos + estTotal + munTotal) / POP)}</b><span>por habitante por ano nos três níveis, sem a dívida e sem contar duas vezes o que a União repassa</span></div>
  </div>

  <h2>O que os números dizem</h2>
  <div class="card resumo">
    <ul>{resumo.map((r) => <li>{r}</li>)}</ul>
    <p class="src">Só aritmética sobre os dados oficiais desta página; nenhuma avaliação sobre se é muito ou pouco. Fontes nos cartões e nas abas.</p>
  </div>

  <h2>Para onde vai cada R$ 100 ({ANO})</h2>
  <div class="card">
    <p style="margin:0 0 10px">
      De cada <b>R$ 100</b> que União, estados e prefeituras gastaram em {ANO}, somados sem contar o mesmo real duas
      vezes, quanto foi para cada coisa. O maior item não é escola, hospital nem juros: é <b>aposentadoria e pensão</b>.
    </p>
    <div class="pizza" style="padding:0;border:0;box-shadow:none;background:transparent">
    <svg viewBox="0 0 200 200" width="240" role="img" aria-label={`Divisão de cada R$ 100 do gasto público em ${ANO}`}>
      {arcos100.map((a) => <path d={a.d} fill={a.cor} stroke="var(--card)" stroke-width="1"><title>{a.nome}: R$ {C100.r2(a.v)} de cada R$ 100 — {compact(a.v)} no ano</title></path>)}
      <circle cx="100" cy="100" r="46" fill="var(--card)" />
      <text x="100" y="96" text-anchor="middle" font-size="10" fill="var(--ink-2)">três níveis, {ANO}</text>
      <text x="100" y="112" text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">{compact(C100.base)}</text>
    </svg>
    <table>
      <thead><tr><th>Para onde vai</th><th class="num">De cada R$ 100</th><th class="num">No ano</th></tr></thead>
      <tbody>{arcos100.map((a) => (<tr><td><i class="sw" style={`background:${a.cor}`}></i>{a.nome}</td><td class="num"><b>R$ {C100.r2(a.v)}</b></td><td class="num">{compact(a.v)}</td></tr>))}</tbody>
    </table>
    </div>
    <p class="src">
      Base de {compact(C100.base)}: a União em políticas e máquina <b>sem os {compact(C100.repasses)} que repassou</b> a
      estados e municípios (já contados em quem gastou), mais os juros que ela pagou no ano, mais estados (sem encargos
      especiais) e prefeituras. Fora: o refinanciamento da dívida, que é rolagem. A folha de pessoal não é uma linha — o
      professor está em educação e o médico em saúde. Juros só da União, portanto piso. A conta inteira e a conferência
      de uma lista que circula estão em <a href="/conferir/#afirmacoes">Como conferir</a>.
    </p>
  </div>

  <h2>Em que a União gasta ({ANO}, sem dívida e transferências)</h2>
  <div class="card pizza">
    <svg viewBox="0 0 200 200" width="240" role="img" aria-label="Despesa da União por função">
      {arcos.map((a) => <path d={a.d} fill={a.cor} stroke="var(--card)" stroke-width="1"><title>{a.nome}: {compact(a.v)} ({pct(a.v, uniaoSemEncargos)})</title></path>)}
      <circle cx={C} cy={C} r="46" fill="var(--card)" />
      <text x={C} y={C - 4} text-anchor="middle" font-size="10" fill="var(--ink-2)">União {ANO}</text>
      <text x={C} y={C + 12} text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">{compact(uniaoSemEncargos)}</text>
    </svg>
    <table>
      <thead><tr><th>Função</th><th class="num"><Termo t="pago">Pago</Termo></th><th class="num">% do total</th><th class="num"><Termo t="per_capita">Por habitante</Termo></th></tr></thead>
      <tbody>{todasFuncoes.map((f) => (<tr><td><i class="sw" style={`background:${f.cor}`}></i>{f.nome}</td><td class="num">{compact(f.v)}</td><td class="num">{pct(f.v, uniaoSemEncargos)}</td><td class="num">{brl0(f.v / POP)}</td></tr>))}</tbody>
    </table>
    <p class="src" style="grid-column:1/-1"><b>Pago</b> = dinheiro que saiu do caixa no ano (não o orçado). <b>Por habitante</b> = pago ÷ 212,6 milhões de brasileiros (IBGE): só dá escala, não é quanto cada um recebeu.
      Função é a classificação oficial da Lei Orçamentária. "Encargos especiais" ({compact(encargos)}: juros, amortização e refinanciamento da dívida, transferências constitucionais a estados e municípios) ficam fora da pizza porque não são um serviço prestado; estão no total da União acima.
      <b>A pizza mostra as 9 maiores funções e junta o resto em "Demais"; a tabela lista todas as {todasFuncoes.length}.</b>
      É por isso que <b>Segurança Pública</b> parece ausente: a União pagou {compact(uf("06"))} nela em {ANO}, a {todasFuncoes.findIndex((f) => f.nome === "Segurança Pública") + 1}ª função —
      segurança é atribuição sobretudo dos estados, que gastaram {compact(somaF("pago_seguranca"))} no mesmo ano (veja a comparação entre os três níveis, logo abaixo). Fonte: SIOP.</p>
  </div>

  <h2>A mesma despesa, agora <strong>com</strong> dívida e transferências ({ANO})</h2>
  <div class="card pizza">
    <svg viewBox="0 0 200 200" width="240" role="img" aria-label="Despesa total da União por função, incluindo encargos especiais">
      {arcosCom.map((a) => <path d={a.d} fill={a.cor} stroke="var(--card)" stroke-width="1"><title>{a.nome}: {compact(a.v)} ({pct(a.v, uniaoTotal)})</title></path>)}
      <circle cx={C} cy={C} r="46" fill="var(--card)" />
      <text x={C} y={C - 4} text-anchor="middle" font-size="10" fill="var(--ink-2)">União {ANO}, total</text>
      <text x={C} y={C + 12} text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">{compact(uniaoTotal)}</text>
    </svg>
    <table>
      <thead><tr><th>Função</th><th class="num"><Termo t="pago">Pago</Termo></th><th class="num">% do total</th><th class="num"><Termo t="per_capita">Por habitante</Termo></th></tr></thead>
      <tbody>{arcosCom.map((a) => (<tr><td><i class="sw" style={`background:${a.cor}`}></i>{a.nome}</td><td class="num">{compact(a.v)}</td><td class="num">{pct(a.v, uniaoTotal)}</td><td class="num">{brl0(a.v / POP)}</td></tr>))}</tbody>
    </table>
    <p class="src" style="grid-column:1/-1">
      É a despesa inteira da União, {compact(uniaoTotal)}, com os <Termo t="encargos_especiais">encargos especiais</Termo>
      como primeira fatia: {compact(encargos)}, ou {pct(encargos, uniaoTotal)} de tudo. Dentro deles estão juros,
      amortização e <b>refinanciamento</b> da dívida — o Tesouro emitindo título novo para pagar título vencido, de modo
      que o mesmo dinheiro passa duas vezes pelo orçamento — e as transferências constitucionais que estados e municípios
      tornam a gastar nos orçamentos deles. É por isso que a pizza de cima, sem eles, é a que compara serviço com serviço,
      e esta é a que fecha com o total do orçamento. O detalhe por etapa (autorizado, empenhado, pago) está em
      <a href="/poderes/">Poderes</a>. Fonte: SIOP.
    </p>
  </div>

  <h2>Quem paga o quê: União, estados e municípios ({ANO})</h2>
  <div class="card">
    <div class="legend"><span><i style="background:var(--s1)"></i>União</span><span><i style="background:var(--s3)"></i>Estados e DF</span><span><i style="background:var(--s2)"></i>Municípios</span></div>
    <svg viewBox={`0 0 ${W} ${niveis.length * 34 + 10}`} width="100%" role="img" aria-label="Despesa por função nos três níveis de governo">
      {niveis.map((n, i) => { const tot = n.uniao + n.estados + (n.municipios ?? 0); let x = 170; const seg = (v: number, c: string) => { const w = (v / maxNivel) * 600; const x0 = x; x += w; return <rect x={x0} y="6" width={Math.max(0, w)} height="22" fill={c}><title>{n.nome}: {compact(v)}</title></rect>; };
        return (<g transform={`translate(0 ${i * 34 + 5})`}>
          <text x="162" y="21" text-anchor="end" font-size="13" fill="var(--ink)">{n.nome}</text>
          {seg(n.uniao, "var(--s1)")}{seg(n.estados, "var(--s3)")}{n.municipios != null && seg(n.municipios, "var(--s2)")}
          <text x={x + 6} y="21" font-size="12" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{compact(tot)}{n.municipios == null ? " (sem municípios)" : ""}</text>
        </g>); })}
    </svg>
    <p class="src">Despesa paga por função em cada nível. Municípios: só saúde, educação, legislativo e administração estão carregados por enquanto; previdência, segurança e judiciário municipais não existem ou não foram extraídos. Na barra da União entra só o que ela <b>aplica direto</b>: o que ela repassa a estados e municípios (na saúde de {ANO}, {compact(ufTransferido("10"))} dos {compact(uf("10"))}) aparece na barra de quem gastou, e não nas duas. Fontes: SIOP e SICONFI.</p>
  </div>

  <h2>Quanto custa cada parte do Estado</h2>
  <div class="grade">
    <a class="card tile" href="/deputados/"><b>{brl0(mediaDep)}</b><span>por mês, um deputado federal (subsídio + cota + gabinete pelo teto) · {dep.length} deputados</span></a>
    <a class="card tile" href="/senadores/"><b>{brl0(mediaSen)}</b><span>por mês, um senador (subsídio + cota + gastos fora da cota; sem gabinete) · {sen.length} senadores</span></a>
    <a class="card tile" href="/presidencia/"><b>{compact(pres.totais.presidencia)}</b><span>cartão corporativo da Presidência em {pres.totais.meses_publicados} meses de 2026 · {pct(pres.totais.sigiloso, pres.totais.presidencia)} sob sigilo</span></a>
    <a class="card tile" href="/judiciario/"><b>{brl0(mediaStf)}</b><span>por mês, um ministro do STF com seu gabinete ({metaStf.ministros_ativos} ministros, folha real)</span></a>
    <a class="card tile" href="/poderes/"><b>{compact(maquina)}</b><span>manter a máquina dos Poderes da União em {ANO}: pessoal, aposentados, custeio</span></a>
    <a class="card tile" href="/divida/"><b>{compact(jurosValor)}</b><span>os juros da dívida federal em {jurosUlt}: o custo apropriado no ano, que não é o mesmo que saiu do caixa; amortização não é custo, e a página separa os três números</span></a>
    <a class="card tile" href="/estatais/"><b>{compact(estatalLucro)}</b><span>o lucro das estatais federais em {estatalUlt} · e quanto o Orçamento põe de volta nelas</span></a>
    <a class="card tile" href="/saneamento/"><b>{String(esgotoCenso.pct).replace(".", ",")}%</b><span>dos domicílios com esgoto ligado à rede no Censo de 2022 · água, esgoto e lixo desde 1991</span></a>
    <a class="card tile" href="/estados/"><b>{compact(somaF("pago_legislativa") + somaF("pago_judiciaria"))}</b><span>Assembleias, TCEs e Tribunais de Justiça dos estados em {ANO}</span></a>
    <a class="card tile" href="/municipios/"><b>{compact(metaMun.totais.pago_legislativo)}</b><span>Câmaras Municipais em {ANO} · {metaMun.totais.vereadores.toLocaleString("pt-BR")} vereadores</span></a>
    <a class="card tile" href="/emendas/"><b>R$ 47,1 bi</b><span>empenhados em emendas parlamentares em 2025 · veja por autor</span></a>
    <a class="card tile" href="/inflacao/"><b>{String(inflacao.doze_meses[inflacao.ultimo_mes]).replace(".", ",")}%</b><span>de alta de preços em 12 meses (IPCA) · por grupo de gasto, por região e comparado com a meta do Banco Central</span></a>
    <a class="card tile" href="/impostos/"><b>{compact(arrec.total)}</b><span>arrecadação federal em {arrec.meses} meses de {arrec.ano}, por base de incidência e por estado</span></a>
    <a class="card tile" href="/obras/"><b>{obrasParadas}</b><span>obras paralisadas ou inacabadas no cadastro federal · {obrasPrevisto} previstos nelas, por estado e por tipo</span></a>
    <a class="card tile" href="/imposto-de-renda/"><b>{pctIrpf}</b><span>de alíquota efetiva no topo do Imposto de Renda, contra {pctIrpfPico} na faixa que mais paga · {irpfMi} mi de declarantes em {irpf.ano_calendario}</span></a>
    <a class="card tile" href="/corrupcao/"><b>{corrupcao.ceis.registros.toLocaleString("pt-BR")}</b><span>sanções que impedem contratar com o poder público · empresas punidas, acordos de leniência e servidores expulsos</span></a>
    <a class="card tile" href="/rankings/"><b>{idh ? `${idh.posicao}º` : "—"}</b><span>posição do Brasil no IDH entre {idh?.total} países · 10 rankings e o histórico de 40 anos</span></a>
  </div>

  <h2>Como vive o país</h2>
  <div class="grade">
    <a class="card tile" href="/trabalho/"><b>{(trabalho.pnad.mil.ocupados / 1e3).toFixed(1).replace(".", ",")} mi</b><span>pessoas ocupadas ({trabalho.pnad.periodo}): carteira, conta própria, servidores, empresas e MEI, benefícios do INSS</span></a>
    <a class="card tile" href="/inss/"><b>{(inssTotal.quantidade / 1e6).toFixed(1).replace(".", ",")} mi</b><span>benefícios pagos pelo INSS por mês · {(100 * (1 - inssAposent.quantidade / inssTotal.quantidade)).toFixed(0)}% deles não são aposentadoria</span></a>
    <a class="card tile" href="/aposentadoria/"><b>{(inssAposent.quantidade / 1e6).toFixed(1).replace(".", ",")} mi</b><span>aposentadorias do INSS · e quanto custa o regime próprio dos servidores públicos</span></a>
    <a class="card tile" href="/renda/"><b>{(rendaPub / rendaPriv).toFixed(2).replace(".", ",")}×</b><span>rendimento médio no setor público ({brl0(rendaPub)}) em relação ao privado com carteira ({brl0(rendaPriv)}), {renda.ano} · o 1% mais rico fica com {String(top1).replace(".", ",")}% da renda</span></a>
    <a class="card tile" href="/educacao/"><b>{idebAI != null ? String(idebAI).replace(".", ",") : "—"}</b><span>IDEB do Brasil nos anos iniciais ({educacao.ano}) · por estado, capital e município, rede pública e privada</span></a>
    <a class="card tile" href="/seguranca/"><b>{String(seguranca.brasil.taxa_mvi).replace(".", ",")}</b><span>mortes violentas intencionais por 100 mil habitantes em {seguranca.ano} — {(seguranca.brasil.mvi / 1000).toFixed(1).replace(".", ",")} mil pessoas · por estado e por cidade</span></a>
    <a class="card tile" href="/saude/"><b>{(100 - saudeDados.planos.brasil.taxa).toFixed(1).replace(".", ",")}%</b><span>dos brasileiros não têm plano de saúde e contam só com o SUS ({saudeDados.planos.referencia}) · gasto público em saúde e indicadores por estado</span></a>
    <a class="card tile" href="/inadimplencia/"><b>{String(credito.brasil.PF.pct).replace(".", ",")}%</b><span>do crédito a pessoas físicas está vencido há mais de 90 dias ({credito.referencia}) · por estado, tipo de crédito e renda</span></a>
  </div>

  <Glossario termos={["pago", "empenhado", "maquina", "politicas_publicas", "divida_transferencias", "per_capita"]} />
</Base>
<style>
  .pizza { display: grid; grid-template-columns: 260px 1fr; gap: 16px; align-items: start; }
  @media (max-width: 720px) { .pizza { grid-template-columns: 1fr; } }
  .sw { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }
  .grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .tile { display: block; text-decoration: none; color: inherit; border-top: 4px solid var(--accent); }
  .tile b { display: block; font-family: var(--display); font-weight: 800; font-size: 2rem; line-height: 1; color: var(--accent); }
  .tile span { display: block; margin-top: 8px; font-size: 13px; color: var(--ink-2); }
  .tile:hover { border-color: var(--s3); }
  .resumo ul { margin: 0; padding-left: 20px; } .resumo li { margin: 6px 0; font-size: 15px; }
</style>
