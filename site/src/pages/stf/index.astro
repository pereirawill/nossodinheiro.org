---
import Base from "../../layouts/Base.astro";
import Termo from "../../components/Termo.astro";
import Glossario from "../../components/Glossario.astro";
import BeneficiosBox from "../../components/BeneficiosBox.astro";
import rows from "../../../public/data/custo_ministro_stf_2026.json";
import fotos from "../../../public/data/fotos.json";
import meta from "../../../public/data/meta_stf_2026.json";

const brl0 = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
// Fotos oficiais dos ministros, servidas por este site (baixadas da página de composição da Biblioteca do STF por
// `python -m etl.fotos.baixar`). O manifesto evita imagem quebrada se faltar alguma.
const comFoto = new Set<string>(((fotos as any).stf ?? []).map(String));
const fotoDe = (r: any) => (comFoto.has(String(r.matricula)) ? `/fotos/stf/${r.matricula}.jpg` : null);
const temFoto = rows.some((r: any) => fotoDe(r));
const compact = (v: number) =>
  v >= 1e9 ? `R$ ${(v / 1e9).toFixed(2).replace(".", ",")} bi` : v >= 1e6 ? `R$ ${(v / 1e6).toFixed(1).replace(".", ",")} mi` : brl0(v);
// Celular: "1,00 mi", "954 mil", "49,6 mil" — a célula leva os dois textos e a CSS mostra um por tela;
// o `data-v` guarda o número bruto para o sort.js, que senão leria os dois textos juntos.
const mil = (v: number) =>        // sem o "R$ ": são 22 px por coluna que decidem se a tabela cabe; a nota embaixo diz que é em reais
  v >= 1e6 ? `${(v / 1e6).toFixed(2).replace(".", ",")} mi` : v >= 1e5 ? `${Math.round(v / 1e3)} mil` : `${(v / 1e3).toFixed(1).replace(".", ",")} mil`;
const MESES = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];
const n = rows.length;
const nMeses = meta.meses_com_folha.length;
const totalMes = rows.reduce((s, r) => s + r.custo_mensal_medio, 0);
const mediaMes = totalMes / n;
const remMes = rows.reduce((s, r) => s + r.remuneracao_mensal_media, 0) / n;
const liqMes = rows.reduce((s, r) => s + r.remuneracao_liquida / r.meses_com_folha, 0) / n;
const remMin = Math.min(...rows.map((r) => r.remuneracao_mensal_media)), remMax = Math.max(...rows.map((r) => r.remuneracao_mensal_media));
const gabMes = rows.reduce((s, r) => s + r.gabinete_mensal_medio, 0) / n;
const anualTotal = rows.reduce((s, r) => s + r.custo_anual_projetado, 0);
const proj = meta.anual_e_projecao ? " (projeção)" : "";
const quando = new Date(meta.gerado_em_utc);
const fmt = new Intl.DateTimeFormat("pt-BR", { timeZone: "America/Sao_Paulo", day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" });
const dataFmt = fmt.format(quando).replace(",", " às") + " (Brasília)";
const max = Math.max(1, ...rows.map((r) => r.custo_mensal_medio));
const W = 920, labelW = 260, plotW = W - labelW - 110, rowH = 30;
const x = (v: number) => (v / max) * plotW;
---
<Base title="Quanto custa um ministro do STF? — Nosso Dinheiro" accent="var(--s5)">
  <h1>Quanto custa um ministro do STF?</h1>
  <p class="lede">
    <Termo t="remuneracao_bruta">Remuneração</Termo> de cada ministro e <Termo t="gabinete_stf">folha do seu gabinete</Termo>
    (servidores, assessores, juízes auxiliares), mês a mês, como o próprio STF publica. {meta.ano}:
    {nMeses} meses com folha ({MESES[meta.meses_com_folha[0] - 1]} a {MESES[meta.ultimo_mes - 1]}), {n} ministros em atividade.
  </p>
  <p class="meta">Dados atualizados em {dataFmt} · fonte: STF, Portal da Transparência → Remuneração (exportação CSV por cargo e por lotação) · atualização mensal, quando o STF publica a folha</p>

  <div class="hero">
    <div class="stat big"><b>{brl0(mediaMes)}</b><span>custo médio de um ministro, <strong>por mês</strong>: remuneração + gabinete</span></div>
    <div class="stat"><b>{brl0(remMes)}</b><span><Termo t="remuneracao_bruta">remuneração bruta</Termo> média do ministro por mês · de {brl0(remMin)} a {brl0(remMax)} · líquido médio {brl0(liqMes)}</span></div>
    <div class="stat"><b>{brl0(gabMes)}</b><span><Termo t="gabinete_stf">gabinete</Termo> por mês, em média ({Math.round(rows.reduce((s, r) => s + r.gabinete_pessoas_ultimo_mes, 0) / n)} pessoas por gabinete em {MESES[meta.ultimo_mes - 1]})</span></div>
  </div>
  <div class="hero" style="margin-top:0">
    <div class="stat"><b>{compact(anualTotal)}</b><span>os {n} ministros e seus gabinetes <strong>por ano</strong>{proj ? <> (<Termo t="projecao">projeção</Termo>)</> : ""}</span></div>
    <div class="stat"><b>{brl0(meta.aposentados.bruto_ultimo_mes)}</b><span>pagos em {MESES[meta.ultimo_mes - 1]} a {meta.aposentados.quantidade_ultimo_mes} <Termo t="ministro_aposentado">ministros aposentados</Termo> (fora do total)</span></div>
    <div class="stat"><b>{compact(meta.totais.custo_total_estimado)}</b><span>total gasto com os {n} ministros e seus gabinetes em {nMeses} meses de {meta.ano}: {compact(meta.totais.remuneracao_bruta)} de remuneração dos ministros + {compact(meta.totais.gabinetes)} de gabinetes</span></div>
  </div>

  <div class="disclaimer">
    <span aria-hidden="true">ⓘ</span>
    <div><b>É folha publicada, não estimativa.</b> O subsídio (salário-base) é R$ 46.366,19 para todos; o que mostramos é a coluna
    "remuneração bruta após o teto constitucional somada com outras verbas" do STF: o subsídio mais vantagens pessoais (adicional por
    tempo de serviço, VPNI), abono de permanência e eventuais retroativos, que explicam a diferença entre ministros. A média
    mensal é dos meses já pagos; 13º e férias caem em meses específicos e elevam o total do ano. Líquido = bruto menos imposto de
    renda e previdência. O gabinete é a soma da mesma coluna para todas as
    pessoas lotadas no gabinete. O presidente do Tribunal aparece com o Gabinete da Presidência, menor que um gabinete de ministro.
    Não entram: prédio, segurança, viagens, aposentados. <a href="/metodologia/">Metodologia</a>.</div>
  </div>
  <BeneficiosBox casa="stf" />

  <h2>Por ministro, por mês</h2>
  <div class="card">
    <div class="legend"><span><i style="background:var(--s3)"></i>Remuneração do ministro</span><span><i style="background:var(--s1)"></i>Folha do gabinete</span></div>
    <svg viewBox={`0 0 ${W} ${rows.length * rowH + 20}`} width="100%" role="img" aria-label="Custo mensal médio por ministro do STF">
      {rows.map((r, i) => (
        <g transform={`translate(0 ${10 + i * rowH})`}>
          <text x={labelW - 8} y={rowH / 2 + 4} text-anchor="end" font-size="12" fill="var(--ink)">{r.nome_curto}</text>
          <rect x={labelW} y="5" width={Math.max(0, x(r.remuneracao_mensal_media) - 1)} height={rowH - 10} fill="var(--s3)" rx="2"><title>Remuneração: {brl0(r.remuneracao_mensal_media)}/mês</title></rect>
          <rect x={labelW + x(r.remuneracao_mensal_media)} y="5" width={Math.max(0, x(r.gabinete_mensal_medio) - 1)} height={rowH - 10} fill="var(--s1)" rx="2"><title>Gabinete: {brl0(r.gabinete_mensal_medio)}/mês, {r.gabinete_pessoas_ultimo_mes} pessoas em {MESES[meta.ultimo_mes - 1]}</title></rect>
          <text x={labelW + x(r.custo_mensal_medio) + 6} y={rowH / 2 + 4} font-size="12" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{brl0(r.custo_mensal_medio)}</text>
        </g>
      ))}
    </svg>
    <p class="src">Média dos {nMeses} meses com folha publicada em {meta.ano}. Fonte: STF, Remuneração (CSV). <a href="/metodologia/">metodologia</a></p>
  </div>

  <h2>Todos os ministros</h2>
  <table>
    <thead><tr><th class="oculta-m">#</th>{temFoto ? <th class="oculta-m col-foto"><span class="vis-oculto">Foto</span></th> : null}<th>Ministro(a)</th><th class="oculta-m">Lotação</th><th class="num"><Termo t="remuneracao_bruta">Bruto</Termo> / mês</th><th class="oculta-m num">Líquido / mês</th><th class="num"><Termo t="gabinete_stf">Gabinete</Termo> / mês</th><th class="oculta-m num"><Termo t="pessoas_gabinete">Pessoas ({MESES[meta.ultimo_mes - 1]})</Termo></th><th class="num">Custo / mês</th><th class="oculta-m num">Custo / ano{proj}</th></tr></thead>
    <tbody>
      {rows.map((r, i) => (
        <tr><td class="oculta-m rank">{i + 1}</td>{temFoto ? <td class="oculta-m cel-foto">{fotoDe(r) ? <img src={fotoDe(r)} alt="" width="36" height="36" loading="lazy" decoding="async" /> : null}</td> : null}<td>{r.nome_curto}</td><td class="oculta-m">{r.observacao ? <Termo t="gabinete_presidencia">{r.unidade.replace("GABINETE ", "").toLowerCase()}</Termo> : r.unidade.replace("GABINETE ", "").toLowerCase()}</td>
            <td class="num" data-v={r.remuneracao_mensal_media}><span class="so-pc">{brl0(r.remuneracao_mensal_media)}</span><span class="so-m">{mil(r.remuneracao_mensal_media)}</span></td><td class="oculta-m num">{brl0(r.remuneracao_liquida / r.meses_com_folha)}</td><td class="num" data-v={r.gabinete_mensal_medio}><span class="so-pc">{brl0(r.gabinete_mensal_medio)}</span><span class="so-m">{mil(r.gabinete_mensal_medio)}</span></td><td class="oculta-m num">{r.gabinete_pessoas_ultimo_mes}</td>
            <td class="num" data-v={r.custo_mensal_medio}><span class="so-pc">{brl0(r.custo_mensal_medio)}</span><span class="so-m">{mil(r.custo_mensal_medio)}</span></td><td class="oculta-m num">{brl0(r.custo_anual_projetado)}</td></tr>
      ))}
    </tbody>
  </table>
  <p class="src">Clique no cabeçalho para ordenar.<span class="so-m"> No celular os valores aparecem abreviados e em reais: 954 mil = R$ 954.000; 1,00 mi = R$ 1.000.000.</span></p>
  <Glossario termos={["remuneracao_bruta", "teto_constitucional", "gabinete_stf", "pessoas_gabinete", "gabinete_presidencia", "ministro_aposentado", "projecao"]} />
</Base>
