---
import Base from "../../layouts/Base.astro";
import Termo from "../../components/Termo.astro";
import Glossario from "../../components/Glossario.astro";
import d from "../../../public/data/inflacao.json";
import precos from "../../../public/data/precos.json";
import cambio from "../../../public/data/cambio.json";
import renda from "../../../public/data/renda.json";
import credito from "../../../public/data/credito.json";

const pct = (v: number | null | undefined, c = 2) => v == null ? "—" : `${v.toFixed(c).replace(".", ",")}%`;
const brl = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 2 });
const quando = new Date(d.gerado_em_utc);
const fmt = new Intl.DateTimeFormat("pt-BR", { timeZone: "America/Sao_Paulo", day: "2-digit", month: "2-digit", year: "numeric" });
const MESES = ["janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto", "setembro", "outubro", "novembro", "dezembro"];
const indice = d.indice as Record<string, number>;
const doze = d.doze_meses as Record<string, number>;
const anual = d.anual as Record<string, number>;
const metas = d.meta_bcb as Record<string, number>;
const ultimo = d.ultimo_mes, anoAtual = ultimo.slice(0, 4);
const mesPorExtenso = `${MESES[+ultimo.slice(4) - 1]} de ${anoAtual}`;
const ipca12 = doze[ultimo], ipcaAno = anual[anoAtual], metaAno = metas[anoAtual];
const inpc12 = (d.inpc_doze_meses as Record<string, number>)[ultimo];

// série de 12 meses a partir de 1996 (antes, a hiperinflação deixa o gráfico ilegível)
const meses12 = Object.keys(doze).filter((p) => p >= "199601").sort();
const SW = 920, SH = 240, padL = 44, padB = 24;
const maxD = Math.max(...meses12.map((p) => doze[p]));
const sx = (i: number) => padL + (i * (SW - padL - 10)) / (meses12.length - 1);
const sy = (v: number) => 8 + (SH - padB - 8) * (1 - v / maxD);

// anos fechados desde 1999 (início do regime de metas) com meta e realizado
const anos = Object.keys(anual).filter((a) => a >= "1999" && (a !== anoAtual || !d.parcial_ano_corrente)).sort();
const anosGraf = Object.keys(anual).filter((a) => a >= "1999").sort();
const maxA = Math.max(...anosGraf.map((a) => Math.max(anual[a] ?? 0, metas[a] ?? 0)));
const BW = 920, BH = 230;
const bx = (i: number) => padL + (i * (BW - padL - 14)) / (anosGraf.length - 1);
const by = (v: number) => 8 + (BH - padB - 8) * (1 - v / maxA);
const larguraBarra = Math.max(8, (BW - padL - 14) / anosGraf.length - 5);

const grupos = [...d.grupos].sort((a, b) => (b.doze ?? 0) - (a.doze ?? 0));
const maxG = Math.max(...grupos.map((g) => Math.abs(g.doze ?? 0)));
const regioes = d.regioes as any[];

// quanto os preços subiram desde cada ano (índice de dezembro)
const equivalente = (ano: string) => {
  const base = indice[`${ano}12`];
  return base ? indice[ultimo] / base : null;
};
const ANOS_REF = ["1995", "2000", "2005", "2010", "2015", "2020", "2024"].filter((a) => indice[`${a}12`]);
const desde1980 = indice[ultimo] / indice["198012"];

// Série longa por grupo e por item (ago/1999 em diante) e os pesos das duas cestas
const longo = (d as any).longo ?? {};
const pesosCestas = (d as any).pesos_cestas ?? {};
const mesesLongo = Object.keys((longo["0"]?.indice) ?? {}).sort();
const baseLongo = mesesLongo[0], fimLongo = mesesLongo[mesesLongo.length - 1];
const multGeral = longo["0"] ? longo["0"].indice[fimLongo] / 100 : 1;
const smLongo = (precos as any).salario_minimo ?? {};
const linhasLongo = Object.entries(longo).filter(([k]) => k !== "0").map(([k, v]: [string, any]) => ({
  codigo: k, nome: v.nome, tipo: v.tipo, mult: v.indice[fimLongo] / 100,
})).map((l) => ({ ...l, nome: l.nome.replace(" - ", " "), vsGeral: 100 * (l.mult / multGeral - 1) }))
  .sort((a, b) => b.mult - a.mult);
const itemMaior = linhasLongo[0], itemMenor = linhasLongo[linhasLongo.length - 1];
const brl0 = (v: number) => `R$ ${v.toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const inteiro = (v: number) => Math.round(v).toLocaleString("pt-BR");
const pao = linhasLongo.find((l) => /Pão francês/.test(l.nome));
const linhasPeso = Object.entries(pesosCestas).map(([k, v]: [string, any]) => ({
  codigo: k, nome: v.nome, ipca: v.ipca, inpc: v.inpc, dif: (v.inpc ?? 0) - (v.ipca ?? 0),
  mult: longo[k] ? longo[k].indice[fimLongo] / 100 : null,
})).sort((a, b) => b.dif - a.dif);
const n1l = (v: number) => v.toLocaleString("pt-BR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const n2l = (v: number) => v.toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const mesPtBr = (m: string) => `${["janeiro","fevereiro","março","abril","maio","junho","julho","agosto","setembro","outubro","novembro","dezembro"][+m.slice(5) - 1]} de ${m.slice(0, 4)}`;


// O que aconteceu com quem RECEBE, não só com a nota: rendimento real por posição (PNADC, já a preços do último
// ano), o salário mínimo deflacionado pelo IPCA médio do ano e a parcela da renda que vai para dívida (BC).
const posicoes = (renda as any).posicoes as any[];
const anoRenda = String((renda as any).ano);
const anoBaseRenda = "2012";
const linhaRenda = (chave: string, rotulo: string) => {
  const s = posicoes.find((x) => x.chave === chave)?.serie ?? {};
  return s[anoBaseRenda] && s[anoRenda] ? { rotulo, de: s[anoBaseRenda], ate: s[anoRenda], var: 100 * (s[anoRenda] / s[anoBaseRenda] - 1) } : null;
};
const mediaAno = (serie: Record<string, number>, ano: string) => { const v = Object.keys(serie).filter((m) => m.startsWith(ano)).map((m) => serie[m]); return v.length ? v.reduce((a, b) => a + b, 0) / v.length : null; };
const ipcaIdx = (precos as any).indices?.ipca ?? {};
const smMedBase = mediaAno(smLongo, anoBaseRenda), smMedAte = mediaAno(smLongo, anoRenda);
const ipcaMedBase = mediaAno(ipcaIdx, anoBaseRenda), ipcaMedAte = mediaAno(ipcaIdx, anoRenda);
const smRealVar = smMedBase && smMedAte && ipcaMedBase && ipcaMedAte ? 100 * ((smMedAte / smMedBase) / (ipcaMedAte / ipcaMedBase) - 1) : null;
const rendas = [
  linhaRenda("total", "Todos os que trabalham"),
  linhaRenda("privado_com_carteira", "Empregado com carteira (setor privado)"),
  linhaRenda("privado_sem_carteira", "Empregado sem carteira (setor privado)"),
  linhaRenda("conta_propria", "Conta própria"),
  linhaRenda("publico", "Setor público"),
  linhaRenda("empregador", "Empregador"),
].filter(Boolean) as any[];
const fam = (credito as any).familias ?? {};
const comprometimento = fam.comprometimento?.pontos ?? {};
const mesesComp = Object.keys(comprometimento).sort();
const compBase = comprometimento[`${anoBaseRenda}-12`] ?? null, compHoje = comprometimento[mesesComp[mesesComp.length - 1]] ?? null;
const mesCompHoje = mesesComp[mesesComp.length - 1];

// Salário mínimo real por período: valor de dezembro de cada marco, deflacionado pelo IPCA para o último mês.
// Os marcos são anos de troca de governo; o dado é o que é, sem atribuir causa.
const smRealEm = (m: string) => (smLongo[m] && ipcaIdx[m] && ipcaIdx[fimLongo] ? smLongo[m] * ipcaIdx[fimLongo] / ipcaIdx[m] : null);
const MARCOS_SM = ["1994-12", "1998-12", "2002-12", "2006-12", "2010-12", "2014-12", "2018-12", "2022-12", fimLongo];
const periodosSM = MARCOS_SM.map((m) => ({ mes: m, real: smRealEm(m), nominal: smLongo[m] })).filter((x) => x.real)
  .map((x, i, arr) => ({ ...x, var: i ? 100 * ((x.real as number) / (arr[i - 1].real as number) - 1) : null,
                         de: i ? arr[i - 1].mes.slice(0, 4) : null }));
const rotuloMarco = (m: string) => (m === fimLongo ? mesPtBr(m) : `dezembro de ${m.slice(0, 4)}`);
// as contas da casa, isoladas da lista de 20 itens
const CASA = ["2101001", "2202003", "2"];
const contasCasa = linhasLongo.filter((l) => CASA.includes(l.codigo)).sort((a, b) => a.mult - b.mult);
const comida = linhasLongo.find((l) => l.codigo === "1");

// Poder de compra do real: quanto R$ 100 de julho de 1994 (quando a moeda nasceu) compram em cada mês desde então
const REAL = "199407";
const mesesReal = Object.keys(indice).filter((m) => m >= REAL).sort();
const poder = (m: string) => (100 * indice[REAL]) / indice[m];       // em reais de hoje, o que R$ 100 de 1994 valem
const poderHoje = (100 * indice[REAL]) / indice[ultimo];
const perdaReal = 100 - poderHoje;                                    // % do poder de compra que se foi
const PW = 920, PH = 240, pPadL = 44, pPadB = 24;
const px = (i: number) => pPadL + (i * (PW - pPadL - 10)) / (mesesReal.length - 1);
const py = (v: number) => 8 + (PH - pPadB - 8) * (1 - v / 100);
const anosMarca = ["1995", "2000", "2005", "2010", "2015", "2020", "2025"].filter((a) => indice[`${a}12`]);
// Câmbio: dólar mês a mês desde o Plano Real e o índice de câmbio efetivo real
const usd = cambio.usd_mensal as Record<string, number>;
const mesesUsd = Object.keys(usd).sort();
const usdIni = usd[cambio.usd_primeiro_mes], usdFim = usd[cambio.usd_ultimo_mes];
const efetiva = cambio.efetiva_real as Record<string, number>;
const mesesEf = Object.keys(efetiva).sort();
const efHoje = efetiva[mesesEf[mesesEf.length - 1]];
const efMin = mesesEf.reduce((m, k) => (efetiva[k] < efetiva[m] ? k : m), mesesEf[0]);
const efMax = mesesEf.reduce((m, k) => (efetiva[k] > efetiva[m] ? k : m), mesesEf[0]);
const CW = 920, CH = 230, cPadL = 46, cPadB = 24;
const maxUsd = Math.max(...Object.values(usd)) * 1.08;
const ux = (i: number) => cPadL + (i * (CW - cPadL - 10)) / (mesesUsd.length - 1);
const uy = (v: number) => 8 + (CH - cPadB - 8) * (1 - v / maxUsd);
const EH = 160;
const maxEf = Math.max(...Object.values(efetiva)) * 1.05;
const ex = (i: number) => cPadL + (i * (CW - cPadL - 10)) / (mesesEf.length - 1);
const ey = (v: number) => 8 + (EH - cPadB - 8) * (1 - v / maxEf);
const mesNome = (m: string) => `${MESES[+m.slice(4) - 1]}/${m.slice(0, 4)}`;
const moedas = cambio.moedas as any[];
const brl4 = (v: number) => `R$ ${v.toLocaleString("pt-BR", { minimumFractionDigits: v < 1 ? 4 : 2, maximumFractionDigits: v < 1 ? 4 : 2 })}`;
const varPct = (v: number | null) => v == null ? "—" : `${v > 0 ? "+" : ""}${v.toFixed(1).replace(".", ",")}%`;

// quanto o dinheiro parado perde com a inflação atual, se ela se repetir
const guardado = (anos: number) => 100 * Math.pow(1 / (1 + ipca12 / 100), anos);
const CORES = ["var(--s1)", "var(--s2)", "var(--s3)", "var(--s4)", "var(--s5)", "#59a14f", "#9c755f", "#b07aa1", "var(--neutro)"];
const pesoTotal = grupos.reduce((s, g) => s + (g.peso ?? 0), 0);
---
<Base title="Inflação: o IPCA desde 1979 — Nosso Dinheiro" accent="var(--s4)" description="Quanto os preços subiram no Brasil: IPCA no mês, no ano e em 12 meses, por grupo de gasto e por região, com a meta do Banco Central e a série desde 1979.">
  <h1>Quanto os preços sobem no Brasil</h1>
  <p class="lede">
    O <Termo t="ipca">IPCA</Termo>, o índice oficial de inflação, no último mês publicado, no ano e em 12 meses; o que subiu mais
    em cada grupo de gasto (comida, transporte, moradia…); como varia entre as regiões; e a comparação com a
    <Termo t="meta_inflacao">meta do Banco Central</Termo> desde 1999. Tudo direto do IBGE e do Banco Central.
  </p>
  <p class="meta">atualizado em {fmt.format(quando)} · IBGE, IPCA de {mesPorExtenso} · meta: Banco Central (CMN) · <a href="/metodologia/">metodologia</a></p>

  <div class="hero">
    <div class="stat big"><b>{pct(ipca12)}</b><span>é a alta de preços dos últimos 12 meses até {mesPorExtenso}; no ano, {pct(ipcaAno)}; no mês, {pct(d.mensal[ultimo])}</span></div>
    <div class="stat"><b>{pct(metaAno, 1)}</b><span>é a meta de inflação para {anoAtual} definida pelo Conselho Monetário Nacional. O realizado em 12 meses está {ipca12 > metaAno ? "acima" : "abaixo"} dela</span></div>
    <div class="stat"><b>{pct(inpc12)}</b><span>é o <Termo t="inpc">INPC</Termo> em 12 meses, o índice das famílias de renda mais baixa (até 5 salários mínimos)</span></div>
  </div>

  <div class="disclaimer"><span aria-hidden="true">ⓘ</span>
    <div><b>Nenhum índice é "a sua inflação", e o IPCA não mede tudo o que pesa no bolso.</b> Ele acompanha o preço de uma
    cesta média das famílias que ganham de 1 a 40 salários mínimos nas 16 áreas pesquisadas pelo IBGE — e quase nenhum item
    sobe como a média (a tabela item por item está abaixo). <b>Ficam fora do índice</b>, por desenho: o preço de <b>comprar</b>
    uma casa (entra só o aluguel), os <b>juros</b> da dívida (cartão, cheque especial, prestação) e a redução de quantidade
    dentro da mesma embalagem. Boa parte da distância entre o número oficial e a sensação de quem paga as contas está nessas
    três coisas, e esta página mostra o que existe publicado sobre elas.</div>
  </div>

  <h2 id="poder-de-compra">Quanto o real perdeu de poder de compra</h2>
  <div class="card">
    <div class="hero" style="margin-top:0">
      <div class="stat big"><b>{brl(poderHoje)}</b><span>é o que R$ 100 de julho de 1994, quando o real foi criado, compram hoje. O resto a inflação levou</span></div>
      <div class="stat"><b>{pct(perdaReal, 1)}</b><span>do <Termo t="poder_de_compra">poder de compra</Termo> da moeda se perdeu em {(parseInt(ultimo.slice(0, 4)) - 1994)} anos — o mesmo dinheiro compra {(100 / poderHoje).toFixed(1).replace(".", ",")}× menos</span></div>
      <div class="stat"><b>R$ {(100 * desde1980 / 1e12).toFixed(1).replace(".", ",")} tri</b><span>é o que seria preciso hoje para comprar o que R$ 100 compravam em dezembro de 1980, antes de cinco trocas de moeda — a conta da hiperinflação</span></div>
    </div>
    <svg viewBox={`0 0 ${PW} ${PH}`} width="100%" role="img" aria-label="Poder de compra de R$ 100 de julho de 1994 ao longo do tempo">
      {[25, 50, 75, 100].map((v) => (<g><line x1={pPadL} x2={PW - 10} y1={py(v)} y2={py(v)} stroke="var(--line)" /><text x={pPadL - 6} y={py(v) + 4} text-anchor="end" font-size="11" fill="var(--ink-2)">R$ {v}</text></g>))}
      <polygon points={`${px(0)},${(PH - pPadB).toFixed(1)} ${mesesReal.map((m, i) => `${px(i).toFixed(1)},${py(poder(m)).toFixed(1)}`).join(" ")} ${px(mesesReal.length - 1)},${(PH - pPadB).toFixed(1)}`} fill="var(--s4)" opacity=".10" />
      <polyline points={mesesReal.map((m, i) => `${px(i).toFixed(1)},${py(poder(m)).toFixed(1)}`).join(" ")} fill="none" stroke="var(--s4)" stroke-width="2.5" />
      {anosMarca.map((a) => { const m = `${a}12`; const i = mesesReal.indexOf(m); return i > 0 && (<g>
        <circle cx={px(i)} cy={py(poder(m))} r="3" fill="var(--s4)" />
        <text x={px(i)} y={py(poder(m)) - 8} text-anchor="middle" font-size="10.5" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{brl(poder(m))}</text>
      </g>); })}
      {mesesReal.filter((m) => m.endsWith("12") && +m.slice(0, 4) % 5 === 0).map((m) => <text x={px(mesesReal.indexOf(m))} y={PH - 6} text-anchor="middle" font-size="11" fill="var(--ink-2)">{m.slice(0, 4)}</text>)}
    </svg>
    <p class="src">
      A linha mostra, mês a mês, quanto valem em compras os mesmos R$ 100 de julho de 1994 — não é cotação de moeda nem comparação com
      o dólar, é só o quanto o dinheiro compra. A queda é mais íngreme nos primeiros anos do real, quando a inflação ainda rodava perto
      de 20% ao ano, e vai ficando lenta depois de 1999. Calculado com o número-índice do IPCA (IBGE, SIDRA 1737).
      <b>Esta conta é sobre a cédula, não sobre a renda</b>: diz o que acontece com dinheiro que ficou parado. O que
      aconteceu com quem recebe salário está no quadro seguinte, e a medida em tempo de trabalho (quantos minutos
      custa um litro de gasolina, desde 2001) está em <a href="/economia/poder-de-compra/">Poder de compra</a>.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 6px">E o dinheiro parado, quanto perde?</h3>
    <p class="explica">Se a inflação dos últimos 12 meses ({pct(ipca12)}) se repetisse, é isto que aconteceria com R$ 100 guardados em casa, sem render nada:</p>
    <table>
      <thead><tr><th>Depois de</th><th class="num">R$ 100 compram o equivalente a</th><th class="num">Perda acumulada</th></tr></thead>
      <tbody>{[1, 2, 5, 10, 20].map((anos) => (<tr><td>{anos} {anos === 1 ? "ano" : "anos"}</td><td class="num">{brl(guardado(anos))}</td><td class="num">{pct(100 - guardado(anos), 1)}</td></tr>))}</tbody>
    </table>
    <p class="src">Projeção simples, não previsão: repete a inflação de 12 meses até {mesPorExtenso} para a frente. Serve para mostrar o efeito do juro composto ao contrário — a inflação futura pode ser maior ou menor, e dinheiro aplicado rende.</p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">E a renda de quem trabalha, acompanhou os preços?</h3>
    <p style="margin:0 0 10px">
      Depende de quem. Abaixo, o rendimento médio <b>já descontada a inflação</b>, por tipo de ocupação, de
      {" "}{anoBaseRenda} a {anoRenda} — o período mais longo em que o IBGE mede isso com a mesma pesquisa.
    </p>
    <table>
      <thead><tr><th>Quem</th><th class="num">Em {anoBaseRenda}</th><th class="num">Em {anoRenda}</th><th class="num">Mudança real em {+anoRenda - +anoBaseRenda} anos</th></tr></thead>
      <tbody>
        {rendas.map((r) => (<tr><td>{r.rotulo}</td><td class="num">{brl(r.de)}</td><td class="num">{brl(r.ate)}</td>
          <td class="num"><b>{r.var >= 0 ? "+" : "−"}{n1l(Math.abs(r.var))}%</b></td></tr>))}
        {smRealVar != null && <tr class="destaque"><td>Salário mínimo (valor de lei)</td><td class="num">{brl(smMedBase ?? 0)}</td><td class="num">{brl(smMedAte ?? 0)}</td>
          <td class="num"><b>{smRealVar >= 0 ? "+" : "−"}{n1l(Math.abs(smRealVar))}%</b> <span class="un">real</span></td></tr>}
      </tbody>
    </table>
    <p class="src">
      Rendimento médio mensal real de todos os trabalhos, a preços de {anoRenda} (IBGE, PNAD Contínua anual, tabela
      4659); salário mínimo médio de cada ano deflacionado pelo IPCA médio do ano. <b>Em treze anos, quem trabalha
      ganhou {n1l(rendas[0]?.var ?? 0)}% a mais em poder de compra — cerca de 1% ao ano.</b> Quem tem carteira
      assinada no setor privado ganhou {n1l(rendas.find((r) => /carteira \(setor privado\)/.test(r.rotulo) && /com/.test(r.rotulo))?.var ?? 0)}%, e o empregador
      médio, {(() => { const v = rendas.find((r) => r.rotulo === "Empregador")?.var ?? 0; return `${v < 0 ? "−" : "+"}${n1l(Math.abs(v))}`; })()}%. O salário mínimo subiu bem mais que isso
      <b> antes</b> de 2012 (de R$ 64,79 em julho de 1994 para R$ 622 em 2012, mais que o dobro em termos reais); desde então
      anda no passo dos demais.
      {compBase && compHoje && <span> <b>E a parcela da renda que vai para pagar dívida</b> foi de {n1l(compBase)}% em dezembro de
      {" "}{anoBaseRenda} para {n1l(compHoje)}% em {mesNome(mesCompHoje.replace("-", ""))} — o maior nível desde que o Banco Central
      mede (série 29034). Ou seja: a renda cresceu pouco, e uma fatia maior dela já sai comprometida antes de chegar ao
      mercado. Esse custo <b>não entra no IPCA</b>, e é parte do que o índice não captura. Detalhe em{" "}
      <a href="/inadimplencia/">Inadimplência</a>.</span>}
    </p>
    <h3 style="margin:16px 0 8px">Quando o salário mínimo subiu de verdade</h3>
    <table>
      <thead><tr><th>Em</th><th class="num">Valor da época</th><th class="num">A preços de hoje</th><th class="num">Ganho real no período</th></tr></thead>
      <tbody>{periodosSM.map((x) => (<tr class={x.var != null && x.var === Math.max(...periodosSM.map((y) => y.var ?? -1)) ? "destaque" : ""}>
        <td>{rotuloMarco(x.mes)}</td>
        <td class="num">{brl(x.nominal)}</td>
        <td class="num">{brl(x.real as number)}</td>
        <td class="num">{x.var == null ? "—" : <b>{x.var >= 0 ? "+" : "−"}{n1l(Math.abs(x.var))}%</b>}</td></tr>))}</tbody>
    </table>
    <p class="src">
      Salário mínimo de dezembro de cada ano (Banco Central, SGS 1619), convertido a preços de {mesPtBr(fimLongo)} pelo
      IPCA. Os marcos são os anos de troca de governo, para dar a referência que as pessoas usam de memória.
      <b>Metade do ganho real desde o Plano Real aconteceu entre 2002 e 2010</b>; de 2014 a 2022 o mínimo ficou
      praticamente parado em termos reais, oito anos. A política de valorização que vincula o reajuste ao PIB é lei
      desde 2007 e o período coincide com o ciclo de alta das commodities — esta página não separa o peso de cada
      coisa, porque isso é pesquisa, não dado publicado.
    </p>
  </div>

  <h2 id="contas-da-casa">Aluguel e contas da casa</h2>
  <div class="card">
    <p style="margin:0 0 10px">
      A pergunta mais comum é se foi a casa que ficou cara. Desde {mesPtBr(baseLongo)}, uma coisa que custava R$ 1,00
      custa hoje {brl0(multGeral)} na média de tudo. As contas da casa, isoladas:
    </p>
    <table>
      <thead><tr><th>O que custava R$ 1,00 em {mesPtBr(baseLongo).replace(" de ", "/")}…</th><th class="num">…custa hoje</th><th class="num">Contra a média</th></tr></thead>
      <tbody>
        {contasCasa.map((l) => (<tr><td>{l.nome}{l.tipo === "grupo" && <span class="un"> (aluguel, condomínio, água, luz, gás, reparos)</span>}</td>
          <td class="num"><span class="de">R$ 1,00 →</span> <b>{brl0(l.mult)}</b></td>
          <td class="num">{l.vsGeral >= 0 ? "+" : "−"}{n1l(Math.abs(l.vsGeral))}%</td></tr>))}
        {comida && <tr><td>{comida.nome} <span class="un">(para comparar)</span></td>
          <td class="num"><span class="de">R$ 1,00 →</span> <b>{brl0(comida.mult)}</b></td>
          <td class="num">{comida.vsGeral >= 0 ? "+" : "−"}{n1l(Math.abs(comida.vsGeral))}%</td></tr>}
        <tr class="destaque"><td><b>A média de tudo</b></td><td class="num"><span class="de">R$ 1,00 →</span> <b>{brl0(multGeral)}</b></td><td class="num">—</td></tr>
      </tbody>
    </table>
    <p class="src">
      <b>O aluguel foi um dos itens que menos subiram</b> no índice: {n1l(Math.abs(contasCasa[0]?.vsGeral ?? 0))}% abaixo
      da média. A conta da casa que correu acima foi a <b>luz</b>. Duas coisas que o número não cobre: o IPCA mede o aluguel
      médio das 16 áreas pesquisadas, não o de um bairro; e <b>o preço de comprar um imóvel fica fora do índice</b> por
      desenho — só o aluguel entra. Quem sente a casa pesando mais do que a tabela diz pode estar sentindo justamente o
      que o índice não mede.
    </p>
  </div>

  <h2 id="o-que-subiu-mais">Item por item: o que subiu mais desde 1999</h2>
  <div class="card">
    <p style="margin:0 0 10px">
      <b>Pense numa coisa que custava R$ 1,00 em {mesPtBr(baseLongo)}.</b> Se ela acompanhou a média dos preços,
      hoje custa {brl0(multGeral)}. Mas quase nada acompanha a média: <b>aquele</b> R$ 1,00,
      se tiver subido como o pão, virou {pao ? brl0(pao.mult) : "—"}; se tiver subido como um carro novo, virou
      {" "}{brl0((linhasLongo.find((l) => /Automóvel/.test(l.nome))?.mult) ?? 0)}. <b>Não é o preço do pão nem o do
      carro</b> — é o que acontece com um real de 1999 que siga a trajetória de cada um deles.
      É essa diferença, item por item, que a palavra "inflação" esconde — e é por isso que a conta do índice nunca
      bate com a lembrança de ninguém.
    </p>
    <table>
      <thead><tr>
        <th>O que custava R$ 1,00 em {mesPtBr(baseLongo).replace(" de ", "/")}…</th>
        <th class="num">…custa hoje</th>
        <th class="num">Subiu quanto a mais (ou a menos) que a média</th>
      </tr></thead>
      <tbody>{linhasLongo.map((l) => (<tr>
        <td>{l.nome} {l.tipo === "grupo" && <span class="un">(o grupo inteiro)</span>}{/Automóvel/.test(l.nome) && <span class="un"> — o mesmo modelo, não o carro mais barato à venda*</span>}</td>
        <td class="num"><span class="de">R$ 1,00 →</span> <b>{brl0(l.mult)}</b></td>
        <td class="num">{l.vsGeral >= 0 ? "+" : "−"}{n1l(Math.abs(l.vsGeral))}%</td></tr>))}
        <tr class="destaque">
          <td><b>A média de tudo (o índice geral)</b></td>
          <td class="num"><span class="de">R$ 1,00 →</span> <b>{brl0(multGeral)}</b></td>
          <td class="num">—</td></tr>
      </tbody>
    </table>
    <p class="src">
      <b>O que a tabela mostra:</b> comida, plano de saúde, luz e refeição fora de casa subiram <b>bem acima</b> da
      média; aluguel, roupa, eletrodoméstico, telefone e carro subiram bem abaixo. Quem gasta a maior parte da renda
      nos itens do topo viveu uma inflação maior que a oficial — e isso não é erro do índice, é a média fazendo o que
      médias fazem.
      <b>* Automóvel novo, o número que mais contraria a memória.</b> O IBGE coleta o preço de modelos especificados,
      na concessionária, e só compara "o mesmo produto" consigo mesmo — é a regra de todo o índice. Quando um modelo sai
      de linha e entra outro melhor, a troca não conta como inflação. Por isso a linha mede o quanto <b>o mesmo carro</b>
      encareceu, e não o quanto custa hoje <b>o carro mais barato que existe</b>: o "popular" 1.0 sem ar, sem airbag e
      sem ABS de 1999 não é mais vendido (airbag e ABS são obrigatórios desde 2014, controle de estabilidade desde 2024).
      A sensação de que o carro de entrada ficou fora de alcance é sobre um produto que mudou; o índice é sobre um que
      não mudou. Os dois estão certos e medem coisas diferentes.
      <b>Por que parte de R$ 1,00 e não do preço real:</b> o IBGE publica a <b>variação</b> do preço de cada item,
      nunca o preço em reais. Sabemos quanto o pão subiu; não sabemos quanto custava. Partir de R$ 1,00 usa só o que
      é medido. Variação mensal do IPCA por item, encadeada das tabelas 655, 2938, 1419 e 7060 do SIDRA.
    </p>
  </div>


  <h2>Quem sente mais: as duas cestas oficiais</h2>
  <div class="card">
    <p style="margin:0 0 10px">
      O IBGE calcula dois índices com a mesma coleta de preços e cestas diferentes: o <b>IPCA</b>, das famílias que
      ganham de 1 a 40 salários mínimos, e o <b>INPC</b>, das que ganham até 5. A diferença entre eles é só o peso de
      cada grupo — e o peso é onde se vê a vida de cada família.
    </p>
    <table>
      <thead><tr><th>Grupo de gasto</th><th class="num">Peso na cesta do IPCA</th><th class="num">Na cesta de quem ganha até 5 s.m.</th><th class="num">Diferença</th><th class="num">Quanto subiu desde 1999</th></tr></thead>
      <tbody>{linhasPeso.map((l) => (<tr>
        <td>{l.nome}</td>
        <td class="num">{n1l(l.ipca ?? 0)}%</td>
        <td class="num">{n1l(l.inpc ?? 0)}%</td>
        <td class="num">{l.dif >= 0 ? "+" : "−"}{n1l(Math.abs(l.dif))} p.p.</td>
        <td class="num">{l.mult ? `${n2l(l.mult)}×` : "—"}</td></tr>))}</tbody>
    </table>
    <p class="src">
      <b>Quem ganha menos gasta mais com comida e moradia</b> — os dois grupos que mais subiram — e menos com
      educação e despesas pessoais. No total, os dois índices andaram perto um do outro desde o Plano Real (preços
      ×8,40 pelo IPCA, ×8,51 pelo INPC), porque a família de menor renda também gasta relativamente mais com o que
      ficou barato (artigos de residência, comunicação). O INPC é o índice que mais se aproxima da cesta de quem
      ganha pouco; mesmo ele é uma média, e a tabela acima mostra o que a média esconde.
    </p>
  </div>

