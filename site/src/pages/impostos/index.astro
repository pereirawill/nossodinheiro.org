        {mediaOcde && <line x1={200 + (mediaOcde.ultimo / maxMundo) * 560} x2={200 + (mediaOcde.ultimo / maxMundo) * 560} y1="0" y2={linhasMundo.length * 24 + 4} stroke="var(--ink-2)" stroke-dasharray="3 3" />}
