---
import Base from "../../layouts/Base.astro";
import Termo from "../../components/Termo.astro";
import Glossario from "../../components/Glossario.astro";
import d from "../../../public/data/trabalho.json";

const mi = (v: number) => `${(v / 1e6).toFixed(1).replace(".", ",")} mi`;
const miMil = (v: number) => mi(v * 1e3); // PNAD vem em mil pessoas
const num = (v: number) => Math.round(v).toLocaleString("pt-BR");
const pct = (a: number, b: number) => `${(100 * a / b).toFixed(1).replace(".", ",")}%`;
const quando = new Date(d.gerado_em_utc);
const fmt = new Intl.DateTimeFormat("pt-BR", { timeZone: "America/Sao_Paulo", day: "2-digit", month: "2-digit", year: "numeric" });
const p = d.pnad.mil as Record<string, number>;
const e = d.empresas, inss = d.inss;

// População de 14+: fora da força, desocupados e ocupados por posição
const posicoes = [
  { k: "privado_com_carteira", nome: "Empregados com carteira (setor privado)", cor: "var(--s1)" },
  { k: "privado_sem_carteira", nome: "Empregados sem carteira (setor privado)", cor: "#9ec5e8" },
  { k: "domestico_com_carteira", nome: "Domésticos com carteira", cor: "var(--s5)" },
  { k: "domestico_sem_carteira", nome: "Domésticos sem carteira", cor: "#9ad9e6" },
  { k: "setor_publico", nome: "Setor público (servidores, militares, celetistas)", cor: "var(--s3)" },
  { k: "conta_propria", nome: "Conta própria (autônomos, MEI, informais)", cor: "var(--s4)" },
  { k: "empregador", nome: "Empregadores", cor: "var(--s2)" },
  { k: "familiar_auxiliar", nome: "Trabalhador familiar auxiliar", cor: "var(--neutro)" },
];
const ocupados = p.ocupados;
const R = 86, C = 100; let ang = -Math.PI / 2;
const arcos = posicoes.map((x) => { const v = p[x.k]; const fr = v / ocupados; const a0 = ang; ang += fr * 2 * Math.PI;
  const x0 = C + R * Math.cos(a0), y0 = C + R * Math.sin(a0), x1 = C + R * Math.cos(ang), y1 = C + R * Math.sin(ang);
  return { ...x, v, fr, d: `M${C},${C} L${x0.toFixed(2)},${y0.toFixed(2)} A${R},${R} 0 ${fr > 0.5 ? 1 : 0} 1 ${x1.toFixed(2)},${y1.toFixed(2)} Z` }; });
// Pizza 1: todos os brasileiros, numa divisão que não se sobrepõe (o IBGE estima o total; a PNAD conta só quem tem 14+)
const popTotal = d.populacao.pessoas;
const criancas = popTotal - p.pop_14_mais * 1e3;
const FATIAS_POP = [
  { nome: "Crianças e adolescentes até 13 anos", v: criancas, cor: "var(--s5)" },
  { nome: "Trabalhando (ocupados de 14 anos ou mais)", v: p.ocupada * 1e3, cor: "var(--s2)" },
  { nome: "Procurando trabalho (desocupados)", v: p.desocupada * 1e3, cor: "var(--s4)" },
  { nome: "Fora da força de trabalho: aposentados, estudantes, quem cuida da casa, quem desistiu de procurar", v: p.fora_forca * 1e3, cor: "var(--neutro)" },
];
// Pizza 2: a população inteira pelo vínculo com a previdência (partição real, sem sobreposição)
const contrib = p.contribuintes * 1e3, naoContrib = p.nao_contribuintes * 1e3;
const ocupadosPnad = contrib + naoContrib;                       // total de ocupados da mesma tabela
const foraForca = p.fora_forca * 1e3, desocupados = p.desocupada * 1e3;
const criancasPrev = popTotal - (ocupadosPnad + desocupados + foraForca);
const FATIAS_PREV = [
  { nome: "Trabalham e contribuem para a previdência", v: contrib, cor: "var(--s2)" },
  { nome: "Trabalham e não contribuem (informais)", v: naoContrib, cor: "var(--s4)" },
  { nome: "Procuram trabalho (desocupados)", v: desocupados, cor: "#d9a23b" },
  { nome: "Fora da força de trabalho: aposentados, estudantes, quem cuida da casa", v: foraForca, cor: "var(--neutro)" },
  { nome: "Crianças e adolescentes até 13 anos", v: criancasPrev, cor: "var(--s5)" },
];
const pctPop = (v: number) => `${((100 * v) / popTotal).toFixed(1).replace(".", ",")}%`;

// Pizza 3: os benefícios que o INSS paga, por grupo
const FATIAS_INSS = [
  { nome: "Aposentadorias, pensões e auxílios de quem contribuiu (RGPS)", v: inss.rgps, cor: "var(--s1)" },
  { nome: "BPC/LOAS: um salário mínimo a idosos e pessoas com deficiência de baixa renda, sem contribuição", v: inss.assistencial, cor: "var(--s3)" },
  ...(inss.ble ? [{ nome: "Pensões de legislação especial", v: inss.ble, cor: "var(--s4)" }] : []),
];
const pizza = (fatias: { nome: string; v: number; cor: string }[], total: number) => {
  let a = -Math.PI / 2;
  return fatias.map((f) => {
    const fr = f.v / total, a0 = a; a += fr * 2 * Math.PI;
    const x0 = 100 + 86 * Math.cos(a0), y0 = 100 + 86 * Math.sin(a0), x1 = 100 + 86 * Math.cos(a), y1 = 100 + 86 * Math.sin(a);
    return { ...f, fr, d: `M100,100 L${x0.toFixed(2)},${y0.toFixed(2)} A86,86 0 ${fr > 0.5 ? 1 : 0} 1 ${x1.toFixed(2)},${y1.toFixed(2)} Z` };
  });
};
const arcosPop = pizza(FATIAS_POP, popTotal);
const arcosInss = pizza(FATIAS_INSS, inss.total);
const arcosPrev = pizza(FATIAS_PREV, popTotal);

const barraPop = [
  { nome: "Ocupados", v: p.ocupada, cor: "var(--s2)" }, { nome: "Desocupados (procurando)", v: p.desocupada, cor: "var(--s4)" },
  { nome: "Fora da força de trabalho (estudantes, aposentados, donas de casa, desalentados…)", v: p.fora_forca, cor: "var(--neutro)" },
];
const W = 920;
// CEMPRE: quantas empresas há em cada faixa de tamanho e quanta gente trabalha em cada uma
const cempre = (d as any).cempre;
const faixas = (cempre?.faixas ?? []) as { faixa: string; empresas: number; pessoas: number; assalariados: number; salario_medio: number | null }[];
const cempreTotal = cempre?.total ?? { empresas: 0, pessoas: 0 };
const maxEmpresas = Math.max(...faixas.map((f) => f.empresas), 1);
const maxPessoas = Math.max(...faixas.map((f) => f.pessoas), 1);
const portes = (cempre?.portes ?? []) as { porte: string; empresas: number; pessoas: number }[];
const CORES_PORTE: Record<string, string> = { Micro: "var(--s2)", Pequena: "var(--s5)", "Média": "var(--s4)", Grande: "var(--s1)" };
const somaPortesEmp = portes.reduce((a, p) => a + p.empresas, 0) || 1;
const somaPortesPes = portes.reduce((a, p) => a + p.pessoas, 0) || 1;
const grande = portes.find((p) => p.porte === "Grande");
const micro = faixas.find((f) => f.faixa === "0 a 4");
const gigantes = faixas.find((f) => f.faixa === "500 ou mais");

const empresasBarras = [
  { nome: "MEI (microempreendedor individual)", v: e.mei, cor: "var(--s4)" },
  { nome: "Micro e pequenas empresas (não MEI)", v: e.micro_e_pequenas_nao_mei, cor: "var(--s2)" },
  { nome: "Demais (médias, grandes, estatais, cooperativas…)", v: e.demais, cor: "var(--s1)" },
];
---
<Base title="Quem trabalha, quem empreende, quem recebe — Nosso Dinheiro" accent="var(--s2)">
  <h1>Quem trabalha, quem empreende, quem recebe</h1>
  <p class="lede">
    Quantos brasileiros trabalham e como (carteira assinada, sem carteira, por conta própria, servidores, empregadores), quantos
    estão desempregados ou fora do mercado, quantas empresas e MEIs existem e quantos benefícios o INSS paga por mês. Cada bloco com
    a fonte oficial e a data de referência.
  </p>
  <p class="meta">atualizado em {fmt.format(quando)} · IBGE PNAD Contínua ({d.pnad.periodo}) · Mapa de Empresas ({e.referencia}) · INSS ({inss.mes}/{inss.ano}) · <a href="/metodologia/">metodologia</a></p>

  <div class="hero">
    <div class="stat big"><b>{miMil(p.ocupados)}</b><span>pessoas ocupadas no Brasil ({d.pnad.periodo}), de {miMil(p.pop_14_mais)} com 14 anos ou mais</span></div>
    <div class="stat"><b>{miMil(p.privado_com_carteira + p.domestico_com_carteira + p.setor_publico)}</b><span>com vínculo formal: carteira assinada no setor privado, domésticos com carteira e setor público</span></div>
    <div class="stat"><b>{miMil(p.desocupada)}</b><span>desocupados (procuram e não acham): taxa de {String(d.pnad.taxa_desocupacao).replace(".", ",")}% ({d.pnad.periodo_movel})</span></div>
  </div>
  <div class="hero" style="margin-top:0">
    <div class="stat"><b>{mi(e.ativas)}</b><span>empresas ativas (CNPJ), das quais {mi(e.mei)} são MEI ({pct(e.mei, e.ativas)})</span></div>
    <div class="stat"><b>{miMil(p.conta_propria)}</b><span>trabalham por conta própria (inclui MEI e informais)</span></div>
    <div class="stat"><b>{mi(inss.total)}</b><span>benefícios pagos pelo INSS em {inss.mes.toLowerCase()}/{inss.ano}: {mi(inss.rgps)} previdenciários (aposentadorias, pensões, auxílios) e {mi(inss.assistencial)} assistenciais (BPC)</span></div>
  </div>

  <div class="disclaimer"><span aria-hidden="true">ⓘ</span>
    <div><b>Os grupos se sobrepõem; não dá para somar "quem sustenta" e "quem recebe".</b> Um MEI pode ser também empregado; um
    aposentado pode trabalhar; uma pessoa pode receber dois benefícios do INSS; a PNAD conta pessoas (amostra trimestral do IBGE) e o
    Mapa de Empresas conta CNPJs. Bolsa Família e optantes do Simples ainda não estão aqui (ver pendências na metodologia).</div>
  </div>

  <h2>Os {mi(popTotal)} de brasileiros: quem trabalha, quem procura, quem está fora</h2>
  <div class="card pizza">
    <svg viewBox="0 0 200 200" width="240" role="img" aria-label="População total por situação">
      {arcosPop.map((a) => <path d={a.d} fill={a.cor} stroke="var(--card)" stroke-width="1"><title>{a.nome}: {mi(a.v)} ({(a.fr * 100).toFixed(1).replace(".", ",")}%)</title></path>)}
      <circle cx="100" cy="100" r="46" fill="var(--card)" />
      <text x="100" y="96" text-anchor="middle" font-size="10" fill="var(--ink-2)">brasileiros</text>
      <text x="100" y="112" text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">{mi(popTotal)}</text>
    </svg>
    <table>
      <thead><tr><th>Situação</th><th class="num">Pessoas</th><th class="num">%</th></tr></thead>
      <tbody>{arcosPop.map((a) => (<tr><td><i class="sw" style={`background:${a.cor}`}></i>{a.nome}</td><td class="num">{mi(a.v)}</td><td class="num">{(a.fr * 100).toFixed(1).replace(".", ",")}%</td></tr>))}</tbody>
    </table>
    <p class="src" style="grid-column:1/-1">
      Esta divisão <b>não se sobrepõe</b>: cada pessoa aparece uma vez só. Fontes: IBGE, estimativa da população total de {d.populacao.ano}
      ({num(popTotal)}) e PNAD Contínua ({d.pnad.periodo_movel}) para quem tem 14 anos ou mais. As crianças até 13 anos saem da diferença
      entre os dois — as duas pesquisas têm bases um pouco diferentes, então esse número é aproximado. Aqui aparecem
      {miMil(p.ocupada)} ocupados (trimestre móvel, tabela 6318) e mais abaixo {miMil(p.ocupados)} (trimestre fechado, tabela 4097):
      são recortes de tempo diferentes da mesma pesquisa. "Fora da força de trabalho" junta
      quem não trabalha nem procura: aposentados, estudantes, quem cuida da casa e quem desistiu de procurar.
    </p>
  </div>

  <h2>Quem sustenta a previdência: {mi(contrib)} de contribuintes</h2>
  <div class="card pizza">
    <svg viewBox="0 0 200 200" width="240" role="img" aria-label="População por vínculo com a previdência">
      {arcosPrev.map((a) => <path d={a.d} fill={a.cor} stroke="var(--card)" stroke-width="1"><title>{a.nome}: {mi(a.v)} ({pctPop(a.v)})</title></path>)}
      <circle cx="100" cy="100" r="46" fill="var(--card)" />
      <text x="100" y="92" text-anchor="middle" font-size="10" fill="var(--ink-2)">contribuem</text>
      <text x="100" y="108" text-anchor="middle" font-size="13" font-weight="700" fill="var(--s2)">{pctPop(contrib)}</text>
      <text x="100" y="122" text-anchor="middle" font-size="9" fill="var(--ink-2)">da população</text>
    </svg>
    <table>
      <thead><tr><th>Situação diante da previdência</th><th class="num">Pessoas</th><th class="num">% do país</th></tr></thead>
      <tbody>{arcosPrev.map((a) => (<tr><td><i class="sw" style={`background:${a.cor}`}></i>{a.nome}</td><td class="num">{mi(a.v)}</td><td class="num">{pctPop(a.v)}</td></tr>))}
        <tr class="grupo"><td><b>População total ({d.populacao.ano})</b></td><td class="num"><b>{mi(popTotal)}</b></td><td class="num">100%</td></tr></tbody>
    </table>
    <p class="src" style="grid-column:1/-1">
      <b>Cada pessoa aparece uma vez só.</b> "Contribuem" é quem a PNAD registra como contribuinte de instituto de previdência em
      algum trabalho — carteira assinada, servidor, autônomo que recolhe, MEI. De cada 10 pessoas ocupadas,
      {" "}{(10 * contrib / ocupadosPnad).toFixed(1).replace(".", ",")} contribuem. Os {mi(naoContrib)} que trabalham sem contribuir
      não geram direito a aposentadoria nem a auxílio enquanto estiverem assim. Entre os {mi(foraForca)} fora da força de trabalho
      estão os aposentados — <b>que já contribuíram</b> —, estudantes, pessoas que cuidam da casa e quem desistiu de procurar emprego;
      a PNAD não separa esse grupo por fonte de renda nesta tabela. Fontes: IBGE, PNAD Contínua ({d.pnad.periodo}, tabelas 5947 e 6318)
      e estimativa de população de {d.populacao.ano}; as crianças saem da diferença entre as duas pesquisas, então são aproximadas.
    </p>
  </div>

  <h2>Os {mi(inss.total)} de benefícios que o INSS paga por mês</h2>
  <div class="card pizza">
    <svg viewBox="0 0 200 200" width="240" role="img" aria-label="Benefícios do INSS por grupo">
      {arcosInss.map((a) => <path d={a.d} fill={a.cor} stroke="var(--card)" stroke-width="1"><title>{a.nome}: {mi(a.v)}</title></path>)}
      <circle cx="100" cy="100" r="46" fill="var(--card)" />
      <text x="100" y="96" text-anchor="middle" font-size="10" fill="var(--ink-2)">benefícios</text>
      <text x="100" y="112" text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">{mi(inss.total)}</text>
    </svg>
    <table>
      <thead><tr><th>Grupo</th><th class="num">Benefícios</th><th class="num">%</th></tr></thead>
      <tbody>{arcosInss.map((a) => (<tr><td><i class="sw" style={`background:${a.cor}`}></i>{a.nome}</td><td class="num">{num(a.v)}</td><td class="num">{(a.fr * 100).toFixed(1).replace(".", ",")}%</td></tr>))}</tbody>
    </table>
    <p class="src" style="grid-column:1/-1">
      <b>INSS não é só aposentadoria</b>: o instituto paga aposentadorias, pensões por morte, auxílios por incapacidade,
      salário-maternidade e ainda opera o BPC, que é assistência social e não exige contribuição. <b>São benefícios, não pessoas</b>:
      alguém pode receber dois (uma aposentadoria e uma pensão), e quem recebe pode estar trabalhando — por isso esta pizza não pode ser
      somada à de cima. Não inclui aposentados de regimes próprios (servidores da União, dos estados e dos municípios).
      Fonte: Boletim Estatístico da Previdência Social, tabela 14 ({inss.mes.toLowerCase()}/{inss.ano}).
    </p>
  </div>

  <h2>Brasileiros com 14 anos ou mais: {miMil(p.pop_14_mais)}</h2>
  <div class="card">
    <svg viewBox={`0 0 ${W} 60`} width="100%" role="img" aria-label="População de 14 anos ou mais por condição">
      {(() => { let x = 0; return barraPop.map((b) => { const w = (b.v / p.pop_14_mais) * W; const x0 = x; x += w;
        return <g><rect x={x0} y="8" width={Math.max(0, w - 1)} height="34" fill={b.cor} rx="3"><title>{b.nome}: {miMil(b.v)}</title></rect>
          {w > 110 && <text x={x0 + 8} y="30" font-size="12" font-weight="700" fill="#fff">{miMil(b.v)} · {pct(b.v, p.pop_14_mais)}</text>}</g>; }); })()}
    </svg>
    <div class="legend">{barraPop.map((b) => <span><i style={`background:${b.cor}`}></i>{b.nome}</span>)}</div>
    <p class="src">Fonte: IBGE, PNAD Contínua, tabela 6318 ({d.pnad.periodo_movel}). "Fora da força de trabalho" = não trabalha nem procura trabalho.</p>
  </div>

  <h2>Como trabalham os {miMil(ocupados)} ocupados ({d.pnad.periodo})</h2>
  <div class="card pizza">
    <svg viewBox="0 0 200 200" width="240" role="img" aria-label="Ocupados por posição na ocupação">
      {arcos.map((a) => <path d={a.d} fill={a.cor} stroke="var(--card)" stroke-width="1"><title>{a.nome}: {miMil(a.v)} ({pct(a.v, ocupados)})</title></path>)}
      <circle cx={C} cy={C} r="46" fill="var(--card)" />
      <text x={C} y={C - 4} text-anchor="middle" font-size="10" fill="var(--ink-2)">ocupados</text>
      <text x={C} y={C + 12} text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">{miMil(ocupados)}</text>
    </svg>
    <table>
      <thead><tr><th>Posição na ocupação</th><th class="num">Pessoas</th><th class="num">%</th></tr></thead>
      <tbody>{arcos.map((a) => (<tr><td><i class="sw" style={`background:${a.cor}`}></i>{a.nome}</td><td class="num">{miMil(a.v)}</td><td class="num">{pct(a.v, ocupados)}</td></tr>))}
        <tr><td style="padding-left:28px;color:var(--ink-2)">dos quais militares e estatutários</td><td class="num">{miMil(p.publico_estatutario_militar)}</td><td class="num">{pct(p.publico_estatutario_militar, ocupados)}</td></tr></tbody>
    </table>
    <p class="src" style="grid-column:1/-1">Fonte: IBGE, PNAD Contínua, tabela 4097. "Conta própria" inclui autônomos formais (MEI) e informais; "setor público" inclui servidores estatutários, militares e celetistas de órgãos públicos.</p>
  </div>

  <h2>Empresas ativas no Brasil: {mi(e.ativas)} ({e.referencia})</h2>
  <div class="card">
    <svg viewBox={`0 0 ${W} ${empresasBarras.length * 30 + 10}`} width="100%" role="img" aria-label="Empresas ativas por tipo">
      {empresasBarras.map((b, i) => (<g transform={`translate(0 ${i * 30 + 5})`}>
        <text x="330" y="18" text-anchor="end" font-size="12" fill="var(--ink)">{b.nome}</text>
        <rect x="340" y="4" width={Math.max(1, (b.v / e.ativas) * 440)} height="20" fill={b.cor} rx="2" />
        <text x={346 + (b.v / e.ativas) * 440} y="18" font-size="12" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{mi(b.v)} · {pct(b.v, e.ativas)}</text>
      </g>))}
    </svg>
    <table style="margin-top:12px">
      <thead><tr><th>Natureza jurídica</th><th class="num">Empresas ativas</th><th class="num">%</th></tr></thead>
      <tbody>{(e.por_natureza as any[]).map((n) => (<tr><td>{n.natureza}</td><td class="num">{num(n.ativas)}</td><td class="num">{pct(n.ativas, e.ativas)}</td></tr>))}</tbody>
    </table>
    <p class="src">Fonte: <a href={e.url} rel="noopener">Mapa de Empresas (governo federal, dados abertos)</a>, empresas ativas por natureza jurídica e porte. Conta CNPJs, não pessoas: uma pessoa pode ter mais de uma empresa.</p>
  </div>

  {faixas.length > 0 && <>
    <h2>Quantas empresas têm quantos funcionários ({cempre.ano})</h2>
    <div class="card">
      <div class="hero" style="margin-top:0">
        <div class="stat big"><b>{pct(micro!.empresas, cempreTotal.empresas)}</b><span>das {mi(cempreTotal.empresas)} de empresas e organizações do país têm <b class="inline">até 4 pessoas</b> trabalhando, contando os donos</span></div>
        <div class="stat"><b>{num(gigantes!.empresas)}</b><span>empresas têm 500 pessoas ou mais — {pct(gigantes!.empresas, cempreTotal.empresas)} do total</span></div>
        <div class="stat"><b>{grande ? pct(grande.pessoas, somaPortesPes) : pct(gigantes!.pessoas, cempreTotal.pessoas)}</b><span>de todo o pessoal ocupado está nas <b class="inline">grandes</b> empresas, que são {grande ? pct(grande.empresas, somaPortesEmp) : "0,1%"} do total</span></div>
      </div>
      {portes.length > 0 && <>
        <h3 style="margin:18px 0 6px">Micro, pequenas, médias e grandes</h3>
        <p class="explica">
          Não existe uma única definição de porte no Brasil. A <b>lei</b> (Lei Complementar 123/2006) classifica por
          <b>faturamento</b> — é o critério do MEI, da microempresa e da empresa de pequeno porte, que aparece no quadro do Mapa de
          Empresas acima. Já as <b>estatísticas</b> costumam classificar por <b>número de pessoas ocupadas</b>, com cortes diferentes
          para indústria e para comércio e serviços. É esse segundo critério que dá para aplicar aos dados do IBGE, e é o que está aqui.
        </p>
        <svg viewBox={`0 0 ${W} ${portes.length * 46 + 26}`} width="100%" role="img" aria-label="Empresas e pessoal ocupado por porte">
          <text x="330" y="14" text-anchor="end" font-size="11.5" fill="var(--ink-2)">das empresas</text>
          <text x="560" y="14" font-size="11.5" fill="var(--ink-2)">do pessoal ocupado</text>
          {portes.map((p, i) => (<g transform={`translate(0 ${i * 46 + 24})`}>
            <text x="150" y="14" text-anchor="end" font-size="13" font-weight="700" fill="var(--ink)">{p.porte}</text>
            <text x="330" y="16" text-anchor="end" font-size="11.5" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{pct(p.empresas, somaPortesEmp)} · {num(p.empresas)}</text>
            <rect x="340" y="2" width={Math.max(2, (p.empresas / somaPortesEmp) * 160)} height="18" fill={CORES_PORTE[p.porte]} rx="2" />
            <rect x="560" y="2" width={Math.max(2, (p.pessoas / somaPortesPes) * 210)} height="18" fill={CORES_PORTE[p.porte]} rx="2" opacity=".75" />
            <text x={566 + (p.pessoas / somaPortesPes) * 210} y="16" font-size="11.5" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{pct(p.pessoas, somaPortesPes)} · {miMil(p.pessoas / 1e3)}</text>
            <text x="150" y="32" text-anchor="end" font-size="10.5" fill="var(--ink-2)">{p.porte === "Micro" ? "ind. até 19 · com./serv. até 9"
              : p.porte === "Pequena" ? "ind. 20–99 · com./serv. 10–49"
              : p.porte === "Média" ? "ind. 100–499 · com./serv. 50–99" : "ind. 500+ · com./serv. 100+"}</text>
          </g>))}
        </svg>
        <p class="src">
          Critério por pessoal ocupado do <b>Sebrae</b>, aplicado por nós a cada seção da CNAE: indústria, construção, eletricidade e
          saneamento usam o corte alto; agricultura, comércio e serviços usam o baixo. <b>Não é classificação legal</b> — a lei usa
          faturamento, e uma empresa pode ser "de pequeno porte" na lei e "média" aqui, ou o contrário. A soma por porte fica
          {" "}{num(Math.abs(cempreTotal.pessoas - somaPortesPes))} pessoas abaixo do total porque algumas linhas do cadastro não
          entram na divisão por seção de atividade.
        </p>
        <h3 style="margin:22px 0 6px">E pelas faixas do IBGE, sem rótulo de porte</h3>
      </>}
      <table>
        <thead><tr><th><Termo t="faixa_pessoal">Pessoas na empresa</Termo></th><th class="num">Empresas</th><th class="num">% das empresas</th><th class="num">Pessoal ocupado</th><th class="num">% do pessoal</th><th class="num">Salário médio</th></tr></thead>
        <tbody>{faixas.map((f) => (<tr>
          <td>{f.faixa === "500 ou mais" ? "500 ou mais" : `${f.faixa} pessoas`}</td>
          <td class="num">{num(f.empresas)}</td><td class="num">{pct(f.empresas, cempreTotal.empresas)}</td>
          <td class="num">{num(f.pessoas)}</td><td class="num">{pct(f.pessoas, cempreTotal.pessoas)}</td>
          <td class="num">{f.salario_medio ? f.salario_medio.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 }) : "—"}</td></tr>))}
          <tr class="grupo"><td><b>Total</b></td><td class="num"><b>{num(cempreTotal.empresas)}</b></td><td class="num">100%</td><td class="num"><b>{num(cempreTotal.pessoas)}</b></td><td class="num">100%</td>
            <td class="num"><b>{cempreTotal.salario_medio ? cempreTotal.salario_medio.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 }) : "—"}</b></td></tr>
        </tbody>
      </table>
      <svg viewBox={`0 0 ${W} ${faixas.length * 26 + 34}`} width="100%" role="img" aria-label="Empresas e pessoal ocupado por faixa de tamanho" style="margin-top:14px">
        <text x="300" y="14" text-anchor="end" font-size="11.5" fill="var(--ink-2)">quantas empresas</text>
        <text x="420" y="14" text-anchor="middle" font-size="11.5" fill="var(--ink-2)">pessoas na empresa</text>
        <text x="540" y="14" font-size="11.5" fill="var(--ink-2)">quanta gente trabalha nelas</text>
        {faixas.map((f, i) => (<g transform={`translate(0 ${i * 26 + 24})`}>
          <rect x={300 - (f.empresas / maxEmpresas) * 190} y="2" width={Math.max(2, (f.empresas / maxEmpresas) * 190)} height="16" fill="var(--s2)" rx="2" />
          <text x={294 - (f.empresas / maxEmpresas) * 190} y="14" text-anchor="end" font-size="11" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{num(f.empresas)}</text>
          <text x="420" y="14" text-anchor="middle" font-size="11.5" fill="var(--ink)">{f.faixa}</text>
          <rect x="540" y="2" width={Math.max(2, (f.pessoas / maxPessoas) * 260)} height="16" fill="var(--s1)" rx="2" />
          <text x={546 + (f.pessoas / maxPessoas) * 260} y="14" font-size="11" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{miMil(f.pessoas / 1e3)} · {pct(f.pessoas, cempreTotal.pessoas)}</text>
        </g>))}
      </svg>
      <p class="src">
        Fonte: {cempre.fonte}, {cempre.ano}. "Pessoal ocupado" inclui sócios e proprietários que trabalham na empresa, por isso a faixa
        de 0 a 4 ocupa {mi(micro!.pessoas)} de pessoas mesmo tendo empresas sem nenhum assalariado. O cadastro cobre empresas formais e
        outras organizações (inclusive administração pública e entidades sem fins lucrativos), e vem com cerca de dois anos de defasagem —
        por isso o total aqui ({mi(cempreTotal.empresas)}) é menor que o do Mapa de Empresas acima, que conta CNPJs ativos hoje, incluindo
        MEIs sem atividade declarada.
      </p>
    </div>
  </>}

  <h2>Benefícios pagos pelo INSS: {mi(inss.total)} por mês ({inss.mes.toLowerCase()}/{inss.ano})</h2>
  <div class="card">
    <table>
      <thead><tr><th>Grupo</th><th class="num">Benefícios</th><th class="num">%</th><th>O que é</th></tr></thead>
      <tbody>
        <tr><td>Previdenciários (RGPS)</td><td class="num">{num(inss.rgps)}</td><td class="num">{pct(inss.rgps, inss.total)}</td><td class="desc">Aposentadorias, pensões por morte, auxílios por incapacidade, salário-maternidade: quem contribuiu.</td></tr>
        <tr><td>Assistenciais (BPC/LOAS)</td><td class="num">{num(inss.assistencial)}</td><td class="num">{pct(inss.assistencial, inss.total)}</td><td class="desc">Um salário mínimo a idosos de 65+ e pessoas com deficiência de baixa renda, sem contribuição.</td></tr>
        {inss.ble != null && <tr><td>Legislação especial</td><td class="num">{num(inss.ble)}</td><td class="num">{pct(inss.ble, inss.total)}</td><td class="desc">Pensões especiais (ex.: hanseníase, talidomida, anistiados).</td></tr>}
      </tbody>
    </table>
    <p class="src">Fonte: <a href={inss.url} rel="noopener">Boletim Estatístico da Previdência Social</a> (edição {inss.edicao}), tabela 14, benefícios emitidos no mês. Não inclui aposentados de regimes próprios (servidores da União, estados e municípios).</p>
  </div>

  <Glossario termos={["per_capita"]} />
</Base>
