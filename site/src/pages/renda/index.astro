---
import Base from "../../layouts/Base.astro";
import Termo from "../../components/Termo.astro";
import Glossario from "../../components/Glossario.astro";
import MapaBrasil from "../../components/MapaBrasil.astro";
import d from "../../../public/data/renda.json";

const brl0 = (v: number | null | undefined) => v == null ? "—" : v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
const pct1 = (v: number | null | undefined) => v == null ? "—" : `${v.toFixed(1).replace(".", ",")}%`;
const x = (a: number, b: number) => `${(a / b).toFixed(2).replace(".", ",")}×`;
const quando = new Date(d.gerado_em_utc);
const fmt = new Intl.DateTimeFormat("pt-BR", { timeZone: "America/Sao_Paulo", day: "2-digit", month: "2-digit", year: "numeric" });
const P = Object.fromEntries(d.posicoes.map((p) => [p.chave, p])) as Record<string, (typeof d.posicoes)[number]>;
const v = (k: string) => P[k]?.valor ?? 0;
const dist = d.distribuicao;
const anos = Object.keys(P.total.serie);

const barras = [
  { k: "publico_estatutario_militar", nome: "Setor público: estatutários e militares", cor: "var(--s3)" },
  { k: "publico_celetista_com_carteira", nome: "Setor público: celetistas com carteira", cor: "#c56aa3" },
  { k: "publico", nome: "Setor público (todos)", cor: "var(--s3)", destaque: true },
  { k: "empregador_cnpj", nome: "Empregador com CNPJ", cor: "var(--s4)" },
  { k: "conta_propria_cnpj", nome: "Conta própria com CNPJ", cor: "#d9a23b" },
  { k: "privado_com_carteira", nome: "Setor privado com carteira", cor: "var(--s1)", destaque: true },
  { k: "total", nome: "Todos os ocupados (média)", cor: "var(--neutro)", destaque: true },
  { k: "privado_sem_carteira", nome: "Setor privado sem carteira", cor: "#9ec5e8" },
  { k: "conta_propria_sem_cnpj", nome: "Conta própria sem CNPJ", cor: "#e8c98a" },
  { k: "domestico", nome: "Trabalhador doméstico", cor: "var(--s5)" },
].sort((a, b) => v(b.k) - v(a.k));
const maxBar = Math.max(...barras.map((b) => v(b.k)));
const W = 920;

// série: público × privado com carteira × conta própria
const series = [
  { k: "publico", nome: "Setor público", cor: "var(--s3)" }, { k: "privado_com_carteira", nome: "Privado com carteira", cor: "var(--s1)" },
  { k: "conta_propria", nome: "Conta própria", cor: "var(--s4)" }, { k: "total", nome: "Média geral", cor: "var(--neutro)" },
];
const maxS = Math.max(...series.flatMap((s) => Object.values(P[s.k].serie as Record<string, number>)));
const censo = (d as any).censo_sm;
const ROT_SM: Record<string, string> = {
  ate_1_4: "até 1/4 do mínimo", de_1_4_a_1_2: "de 1/4 a 1/2", de_1_2_a_1: "de 1/2 a 1 mínimo",
  de_1_a_2: "de 1 a 2", de_2_a_3: "de 2 a 3", de_3_a_5: "de 3 a 5", de_5_a_10: "de 5 a 10",
  de_10_a_15: "de 10 a 15", de_15_a_20: "de 15 a 20", mais_de_20: "mais de 20 mínimos", sem_rendimento: "sem rendimento",
};
const classesSM = censo ? censo.ocupados.classes.map((c: any) => c.chave) : [];
const maxSM = censo ? Math.max(...censo.ocupados.classes.map((c: any) => c.pct ?? 0),
                               ...censo.moradores.classes.map((c: any) => c.pct ?? 0)) : 1;
const ufSM = censo ? [...censo.por_uf].sort((a: any, b: any) => b.moradores_pct_ate_1_sm - a.moradores_pct_ate_1_sm) : [];
const SW = 920, SH = 220, padL = 60, padB = 24;
const sx = (i: number) => padL + (i * (SW - padL - 10)) / (anos.length - 1);
const sy = (val: number) => 8 + (SH - padB - 8) * (1 - val / maxS);
const linha = (k: string) => anos.map((a, i) => `${sx(i).toFixed(1)},${sy((P[k].serie as any)[a]).toFixed(1)}`).join(" ");

// distribuição: a renda do domicílio dividida pelos moradores, do grupo mais pobre ao mais rico
const porClasse = Object.fromEntries((dist.classes as any[]).map((c) => [c.classe, c])) as Record<string, any>;
const lim = dist.limites as Record<string, number>;
const oc = dist.ocupados_por_classe as Record<string, number>;
const faixa = (de: number | null, ate: number | null) =>
  de == null ? `até ${brl0(ate)}` : ate == null ? `acima de ${brl0(de)}` : `${brl0(de)} a ${brl0(ate)}`;
const GRUPOS = [
  { k: "ate_p10", nome: "Os 10% mais pobres", de: null, ate: lim.P10, tam: "10%" },
  { k: "p10_p20", nome: "2º grupo", de: lim.P10, ate: lim.P20, tam: "10%" },
  { k: "p20_p30", nome: "3º grupo", de: lim.P20, ate: lim.P30, tam: "10%" },
  { k: "p30_p40", nome: "4º grupo", de: lim.P30, ate: lim.P40, tam: "10%" },
  { k: "p40_p50", nome: "5º grupo", de: lim.P40, ate: lim.P50, tam: "10%" },
  { k: "p50_p60", nome: "6º grupo", de: lim.P50, ate: lim.P60, tam: "10%" },
  { k: "p60_p70", nome: "7º grupo", de: lim.P60, ate: lim.P70, tam: "10%" },
  { k: "p70_p80", nome: "8º grupo", de: lim.P70, ate: lim.P80, tam: "10%" },
  { k: "p80_p90", nome: "9º grupo", de: lim.P80, ate: lim.P90, tam: "10%" },
  { k: "p90_mais", nome: "Os 10% mais ricos", de: lim.P90, ate: null, tam: "10%", destaque: true },
].map((g) => ({ ...porClasse[g.k], ...g }));
const TOPO = [
  { k: "p90_p95", nome: "Entre os 10% e os 5% mais ricos", de: lim.P90, ate: lim.P95, tam: "5%" },
  { k: "p95_p99", nome: "Entre os 5% e o 1% mais ricos", de: lim.P95, ate: lim.P99, tam: "4%" },
  { k: "p99_mais", nome: "O 1% mais rico", de: lim.P99, ate: null, tam: "1%", destaque: true },
].map((g) => ({ ...porClasse[g.k], ...g }));
const top = { p90: porClasse.p90_mais, p99: porClasse.p99_mais, p10: porClasse.ate_p10 };
const massaMax = Math.max(...GRUPOS.map((c) => c.massa_pct ?? 0));
const anosD = Object.keys(dist.massa_serie.p99_mais);
const serieD = [
  { nome: "10% mais ricos", vals: dist.massa_serie.p90_mais as Record<string, number>, cor: "var(--s3)" },
  { nome: "Metade mais pobre (50%)", vals: dist.metade_mais_pobre_serie as Record<string, number>, cor: "var(--s2)" },
  { nome: "1% mais rico", vals: dist.massa_serie.p99_mais as Record<string, number>, cor: "var(--s4)" },
  { nome: "10% mais pobres", vals: dist.massa_serie.ate_p10 as Record<string, number>, cor: "var(--s1)" },
];
const dy = (val: number) => 8 + (SH - padB - 8) * (1 - val / 50);
const dx = (i: number) => padL + (i * (SW - padL - 10)) / (anosD.length - 1);

const ufs = [...d.por_uf].sort((a, b) => (b.publico / b.privado_com_carteira) - (a.publico / a.privado_com_carteira));
const ufMaisDesigual = [...d.por_uf].sort((a, b) => (b.gini ?? 0) - (a.gini ?? 0))[0];
const ufMenosDesigual = [...d.por_uf].sort((a, b) => (a.gini ?? 9) - (b.gini ?? 9))[0];
---
<Base title="Renda: público, privado e o 1% mais rico — Nosso Dinheiro" accent="var(--s3)" description="Quanto ganha quem trabalha no setor público e no privado, e quanto da renda fica com os 10% e o 1% mais ricos. IBGE, PNAD Contínua.">
  <h1>Quem ganha quanto no Brasil</h1>
  <p class="lede">
    Rendimento médio de quem trabalha, por tipo de vínculo (servidor, carteira assinada, conta própria, empregador), em cada estado;
    e como a renda se divide: quanto fica com a metade mais pobre, com os 10% mais ricos e com o 1% do topo. Tudo da PNAD Contínua
    do IBGE, a pesquisa domiciliar que mede isso oficialmente.
  </p>
  <p class="meta">atualizado em {fmt.format(quando)} · IBGE, PNAD Contínua anual {d.ano}, valores a preços médios de {d.ano} · <a href="/metodologia/">metodologia</a></p>

  <div class="hero">
    <div class="stat big"><b>{brl0(v("publico"))}</b><span><Termo t="rendimento_habitual">rendimento médio</Termo> de quem trabalha no <Termo t="setor_publico_pnad">setor público</Termo> ({d.ano}) · {x(v("publico"), v("privado_com_carteira"))} o do setor privado com carteira ({brl0(v("privado_com_carteira"))})</span></div>
    <div class="stat"><b>{pct1(top.p99?.massa_pct)}</b><span>da renda de todos os brasileiros fica com o <Termo t="percentil">1% mais rico</Termo> ({d.ano_distribuicao}); os 10% mais ricos ficam com {pct1(top.p90?.massa_pct)}</span></div>
    <div class="stat"><b>{brl0(lim.P99)}</b><span>é quanto precisa sobrar por morador, somando toda a <Termo t="renda_domiciliar_pc">renda do domicílio</Termo>, para estar no 1% mais rico. Para os 10% mais ricos bastam {brl0(lim.P90)}; metade do país vive com até {brl0(lim.P50)}</span></div>
  </div>

  <div class="disclaimer"><span aria-hidden="true">ⓘ</span>
    <div><b>Média não é salário típico, e comparar setores mistura profissões.</b> O setor público tem mais gente com ensino superior
    (professores, médicos, juízes, policiais) e quase nenhum emprego de salário mínimo; o privado tem de tudo. A PNAD é uma pesquisa por
    amostra, com rendimento declarado pelo próprio entrevistado. Os números dizem quanto cada grupo recebe em média, não se é "justo".</div>
  </div>

  <h2>Rendimento médio mensal por tipo de vínculo ({d.ano})</h2>
  <div class="card">
    <svg viewBox={`0 0 ${W} ${barras.length * 30 + 10}`} width="100%" role="img" aria-label="Rendimento médio por posição na ocupação">
      {barras.map((b, i) => (<g transform={`translate(0 ${i * 30 + 5})`}>
        <text x="330" y="18" text-anchor="end" font-size="12" font-weight={b.destaque ? "700" : "400"} fill="var(--ink)">{b.nome}</text>
        <rect x="340" y="4" width={Math.max(1, (v(b.k) / maxBar) * 470)} height="20" fill={b.cor} rx="2" />
        <text x={346 + (v(b.k) / maxBar) * 470} y="18" font-size="12" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{brl0(v(b.k))}</text>
      </g>))}
    </svg>
    <p class="src">Fonte: IBGE, PNAD Contínua, tabela 4659 (rendimento médio mensal real habitualmente recebido no trabalho principal, pessoas de 14 anos ou mais). "Com CNPJ" inclui MEI.</p>
  </div>

  <h2>Como evoluiu desde 2012 (em reais de {d.ano})</h2>
  <div class="card">
    <svg viewBox={`0 0 ${SW} ${SH}`} width="100%" role="img" aria-label="Série do rendimento médio por posição">
      {[0.25, 0.5, 0.75, 1].map((f) => (<g><line x1={padL} x2={SW - 10} y1={sy(maxS * f)} y2={sy(maxS * f)} stroke="var(--line)" /><text x={padL - 6} y={sy(maxS * f) + 4} text-anchor="end" font-size="11" fill="var(--ink-2)">{brl0(maxS * f)}</text></g>))}
      {series.map((s) => <polyline points={linha(s.k)} fill="none" stroke={s.cor} stroke-width="2.5" />)}
      {anos.map((a, i) => (i % 2 === 0 || i === anos.length - 1) && <text x={sx(i)} y={SH - 6} text-anchor="middle" font-size="11" fill="var(--ink-2)">{a}</text>)}
    </svg>
    <div class="legend">{series.map((s) => <span><i style={`background:${s.cor}`}></i>{s.nome}: {brl0(P[s.k].serie[anos[0]])} → {brl0(P[s.k].valor)}</span>)}</div>
    <p class="src">Valores já corrigidos pela inflação pelo IBGE (preços médios de {d.ano}). 2020 e 2021 têm quebra na coleta (pandemia).</p>
  </div>

  <h2>Por estado: público × privado, renda por pessoa e desigualdade ({d.ano})</h2>
  <div class="card">
    <MapaBrasil valores={Object.fromEntries(d.por_uf.map((u) => [u.uf, u.renda_domiciliar_pc]))} formato={(v) => brl0(v)}
      titulo={`Renda do domicílio por morador em cada estado, ${d.ano}`} legenda="de renda do domicílio por morador, em média" />
  </div>
  <div class="card" style="margin-top:14px">
    <table>
      <thead><tr><th>Estado</th><th class="num">Setor público</th><th class="num">Privado c/ carteira</th><th class="num">Público ÷ privado</th><th class="num">Conta própria</th><th class="num">Renda por pessoa</th><th class="num"><Termo t="gini">Gini</Termo></th><th class="num">10% mais ricos têm</th><th class="num">1% mais rico tem</th></tr></thead>
      <tbody>{ufs.map((u) => (<tr><td>{u.nome}</td><td class="num">{brl0(u.publico)}</td><td class="num">{brl0(u.privado_com_carteira)}</td><td class="num">{x(u.publico, u.privado_com_carteira)}</td>
        <td class="num">{brl0(u.conta_propria)}</td><td class="num">{brl0(u.renda_domiciliar_pc)}</td><td class="num">{u.gini?.toFixed(3).replace(".", ",")}</td><td class="num">{pct1(u.massa_p90_mais)}</td><td class="num">{pct1(u.massa_p99_mais)}</td></tr>))}</tbody>
    </table>
    <p class="src">Fonte: IBGE, PNAD Contínua, tabelas 4659 (rendimento por posição), 7533 (renda domiciliar por pessoa), 7435 (Gini) e 7527 (parcela da renda por classe). Clique no cabeçalho para ordenar.</p>
  </div>

  <h2>Como a renda se divide: dos 10% mais pobres ao 1% mais rico ({d.ano_distribuicao})</h2>
  <p class="ponte">
    <b>Atenção: daqui para baixo a medida muda.</b> Até aqui, o rendimento de quem trabalha. Daqui em diante, a renda de
    <b>todas as fontes</b> do domicílio (salários, aposentadorias, aluguéis, programas sociais) dividida pelo número de moradores —
    é assim que o IBGE mede desigualdade, porque é o que sobra para cada pessoa da casa, trabalhe ela ou não.
  </p>
  <div class="card">
    <p class="explica">
      Imagine os brasileiros em fila, do que tem menos renda para o que tem mais, divididos em dez grupos do mesmo tamanho.
      A tabela mostra, para cada grupo, de quanto a quanto vai a renda por morador, quanto cada um recebe em média e que pedaço
      de toda a renda do país fica com ele.
    </p>
    <table>
      <thead><tr><th>Grupo, do mais pobre ao mais rico</th><th>Fatia do país</th><th class="num">Renda por morador</th><th class="num">Média do grupo</th><th class="num">Fica com</th><th class="barra-cab"></th></tr></thead>
      <tbody>
        {GRUPOS.map((g) => (<tr class={g.destaque ? "destaque" : ""}>
          <td>{g.nome}</td><td class="tam">{g.tam}</td><td class="num">{faixa(g.de, g.ate)}</td><td class="num">{brl0(g.renda_media)}</td>
          <td class="num"><b>{pct1(g.massa_pct)}</b></td>
          <td class="barra-cel"><span class="barra" style={`width:${((g.massa_pct ?? 0) / massaMax) * 100}%;background:${g.destaque ? "var(--s3)" : "var(--s1)"}`}></span></td></tr>))}
        <tr class="sub-cab"><td colspan="6">Dentro dos 10% mais ricos</td></tr>
        {TOPO.map((g) => (<tr class={g.destaque ? "destaque" : ""}>
          <td class="sub">{g.nome}</td><td class="tam">{g.tam}</td><td class="num">{faixa(g.de, g.ate)}</td><td class="num">{brl0(g.renda_media)}</td>
          <td class="num"><b>{pct1(g.massa_pct)}</b></td>
          <td class="barra-cel"><span class="barra" style={`width:${((g.massa_pct ?? 0) / massaMax) * 100}%;background:${g.destaque ? "var(--s4)" : "#9ec5e8"}`}></span></td></tr>))}
      </tbody>
    </table>
    <p class="src">
      Os dez grupos somam 100% da renda. Os três últimos estão <b>dentro</b> dos 10% mais ricos e por isso não entram na soma;
      repare que têm tamanhos diferentes (5%, 4% e 1% da população). "Renda por morador" é o intervalo que define o grupo:
      quem tem mais de {brl0(lim.P90)} por morador está entre os 10% mais ricos. Fonte: IBGE, PNAD Contínua, tabelas 7527
      (quanto da renda total fica com cada grupo), 7533 (renda média de cada grupo) e 7438 (os limites de cada grupo), tudo a
      preços médios de {d.ano_distribuicao}. Em termos técnicos, o limite dos 10% mais ricos é o <Termo t="percentil">percentil 90</Termo> (P90) e o do 1%, o P99.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 6px">E entre quem trabalha? O 1% que mais ganha</h3>
    <p class="explica">Aqui a fila é outra: só as pessoas ocupadas, ordenadas pelo que recebem <b>no próprio trabalho</b> (não pela renda da casa).</p>
    <table>
      <thead><tr><th>Grupo de trabalhadores</th><th class="num">Rendimento médio mensal</th></tr></thead>
      <tbody>
        <tr><td>Os 10% que menos ganham</td><td class="num">{brl0(oc.ate_p10)}</td></tr>
        <tr><td>Média de todos os ocupados</td><td class="num">{brl0(oc.total)}</td></tr>
        <tr><td>Os 10% que mais ganham</td><td class="num">{brl0(oc.p90_mais)}</td></tr>
        <tr class="destaque"><td class="sub">dos quais o 1% que mais ganha</td><td class="num"><b>{brl0(oc.p99_mais)}</b></td></tr>
      </tbody>
    </table>
    <p class="src">Fonte: IBGE, PNAD Contínua, tabela 7535 (rendimento de todos os trabalhos das pessoas ocupadas, por classe de percentual dos próprios ocupados), a preços médios de {d.ano_distribuicao}. Como a fila é de trabalhadores e não de domicílios, estes valores não são comparáveis linha a linha com os da tabela acima.</p>
  </div>

  <h2>Desigualdade desde 2012: parcela da renda de cada grupo</h2>
  <div class="card">
    <svg viewBox={`0 0 ${SW} ${SH}`} width="100%" role="img" aria-label="Parcela da renda por grupo ao longo do tempo">
      {[10, 20, 30, 40, 50].map((p) => (<g><line x1={padL} x2={SW - 10} y1={dy(p)} y2={dy(p)} stroke="var(--line)" /><text x={padL - 6} y={dy(p) + 4} text-anchor="end" font-size="11" fill="var(--ink-2)">{p}%</text></g>))}
      {serieD.map((s) => <polyline points={anosD.map((a, i) => `${dx(i).toFixed(1)},${dy(s.vals[a] ?? 0).toFixed(1)}`).join(" ")} fill="none" stroke={s.cor} stroke-width="2.5" />)}
      {anosD.map((a, i) => (i % 2 === 0 || i === anosD.length - 1) && <text x={dx(i)} y={SH - 6} text-anchor="middle" font-size="11" fill="var(--ink-2)">{a}</text>)}
    </svg>
    <div class="legend">{serieD.map((s) => <span><i style={`background:${s.cor}`}></i>{s.nome}: {pct1(s.vals[anosD[0]])} → {pct1(s.vals[anosD[anosD.length - 1]])}</span>)}</div>
    <p class="src">Fonte: IBGE, PNAD Contínua, tabelas 7527 e 7530. Gini do Brasil: {dist.gini.serie[anosD[0]]?.toFixed(3).replace(".", ",")} em {anosD[0]} → {dist.gini.brasil?.toFixed(3).replace(".", ",")} em {d.ano_distribuicao}.</p>
  </div>

  {censo && (<>
  <h2>Quantos vivem com até um, dois ou três salários mínimos</h2>
  <div class="card">
    <div class="hero" style="margin:0 0 14px">
      <div class="stat"><b>{pct1(censo.moradores.pct_ate_1_sm * 100)}</b><span>dos brasileiros moravam em casas com renda de <b class="inline">até um salário mínimo por pessoa</b> em {censo.ano} — {(censo.moradores.ate_1_sm / 1e6).toFixed(1).replace(".", ",")} milhões de pessoas</span></div>
      <div class="stat"><b>{pct1(censo.ocupados.pct_ate_1_sm * 100)}</b><span>de quem trabalhava ganhava até um salário mínimo no total dos trabalhos — {(censo.ocupados.ate_1_sm / 1e6).toFixed(1).replace(".", ",")} milhões de trabalhadores</span></div>
      <div class="stat"><b>{pct1(censo.ocupados.pct_ate_3_sm * 100)}</b><span>ganhavam até <b class="inline">três</b> salários mínimos; entre todos os moradores, {pct1(censo.moradores.pct_ate_3_sm * 100)} viviam com até três mínimos por pessoa</span></div>
    </div>
    <table style="margin-bottom:16px">
      <thead><tr><th>Ganhando até…</th><th class="num">Trabalhadores</th><th class="num">% dos ocupados</th><th class="num">Moradores</th><th class="num">% das pessoas</th></tr></thead>
      <tbody>
        {censo.ocupados.acumulado.map((a: any, i: number) => (<tr class={a.teto_sm === 1 || a.teto_sm === 3 ? "destaque" : ""}>
          <td>{a.teto_sm === 1 ? "1 salário mínimo" : `${a.teto_sm} salários mínimos`}</td>
          <td class="num">{(a.pessoas / 1e6).toFixed(1).replace(".", ",")} mi</td>
          <td class="num"><b>{pct1(a.pct * 100)}</b></td>
          <td class="num">{(censo.moradores.acumulado[i].pessoas / 1e6).toFixed(1).replace(".", ",")} mi</td>
          <td class="num"><b>{pct1(censo.moradores.acumulado[i].pct * 100)}</b></td></tr>))}
      </tbody>
    </table>
    <svg viewBox={`0 0 920 ${classesSM.length * 30 + 34}`} width="100%" role="img" aria-label="Distribuição por classes de salário mínimo, ocupados e moradores">
      <text x="196" y="12" text-anchor="end" font-size="11" fill="var(--ink-2)">classe</text>
      <text x="206" y="12" font-size="11" fill="var(--ink-2)">barra de cima: trabalhadores, pelo rendimento do trabalho · de baixo: moradores, pela renda da casa por pessoa</text>
      {classesSM.map((ch: string, i: number) => {
        const o = censo.ocupados.classes.find((c: any) => c.chave === ch);
        const m = censo.moradores.classes.find((c: any) => c.chave === ch);
        return (<g transform={`translate(0 ${i * 30 + 24})`}>
          <text x="196" y="16" text-anchor="end" font-size="12" fill="var(--ink)">{ROT_SM[ch] ?? ch}</text>
          <rect x="206" y="2" width={Math.max(1, ((o?.pct ?? 0) / maxSM) * 560)} height="10" fill="var(--s1)" rx="1">
            <title>{(o?.pessoas ?? 0).toLocaleString("pt-BR")} trabalhadores ({pct1((o?.pct ?? 0) * 100)})</title></rect>
          <rect x="206" y="14" width={Math.max(1, ((m?.pct ?? 0) / maxSM) * 560)} height="10" fill="var(--s3)" rx="1">
            <title>{(m?.pessoas ?? 0).toLocaleString("pt-BR")} moradores ({pct1((m?.pct ?? 0) * 100)})</title></rect>
          <text x="776" y="16" font-size="11" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">
            {pct1((o?.pct ?? 0) * 100)} / {pct1((m?.pct ?? 0) * 100)}</text>
        </g>);
      })}
    </svg>
    <p class="src">
      A tabela acumula as classes: "até 3 salários mínimos" inclui quem ganha menos que isso, inclusive quem não ganha nada
      de trabalho. São duas perguntas diferentes, e as duas aparecem aqui. A primeira barra conta <b>trabalhadores</b> pelo que recebem de
      todos os trabalhos; a segunda conta <b>todas as pessoas</b>, inclusive crianças e aposentados, pela renda da casa dividida
      pelo número de moradores — por isso a segunda dá um número bem maior: um salário mínimo que sustenta quatro pessoas vira
      um quarto de mínimo por pessoa. Fonte: IBGE, Censo Demográfico de {censo.ano}, tabelas 10292 e 10296. O salário mínimo de
      {" "}{censo.ano} era de {brl0(censo.salario_minimo)}. <b>O Censo é de {censo.ano}</b>: é a fonte mais recente que publica a
      distribuição em classes de salário mínimo, porque a PNAD Contínua publica rendimento em reais, não em mínimos.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 6px">Por estado</h3>
    <table>
      <thead><tr><th>Estado</th><th class="num">Moradores até 1 mínimo</th><th class="num">Moradores até 3 mínimos</th><th class="num">Trabalhadores até 1 mínimo</th><th class="num">Trabalhadores até 3 mínimos</th><th class="barra-cab"></th></tr></thead>
      <tbody>
        {ufSM.map((u: any) => (<tr>
          <td>{u.nome}</td>
          <td class="num"><b>{pct1(u.moradores_pct_ate_1_sm * 100)}</b></td>
          <td class="num">{pct1(u.moradores_pct_ate_3_sm * 100)}</td>
          <td class="num">{pct1(u.ocupados_pct_ate_1_sm * 100)}</td>
          <td class="num">{pct1(u.ocupados_pct_ate_3_sm * 100)}</td>
          <td class="barra-cel"><span class="barra" style={`width:${(u.moradores_pct_ate_1_sm / ufSM[0].moradores_pct_ate_1_sm) * 100}%;background:var(--s3)`}></span></td></tr>))}
      </tbody>
    </table>
    <p class="src">Ordenado pela parcela de moradores com até um salário mínimo por pessoa. Clique no cabeçalho para ordenar por outra coluna.</p>
  </div>
  </>)}

  <h2>O que os números dizem</h2>
  <div class="card">
    <ul class="conclusoes">
      <li>Em {d.ano}, o rendimento médio no setor público ({brl0(v("publico"))}) foi {x(v("publico"), v("privado_com_carteira"))} o do setor privado com carteira ({brl0(v("privado_com_carteira"))}) e {x(v("publico"), v("total"))} a média de todos os ocupados ({brl0(v("total"))}). Estatutários e militares: {brl0(v("publico_estatutario_militar"))}.</li>
      <li>Quem mais ganha, em média, são empregadores com CNPJ ({brl0(v("empregador_cnpj"))}); quem menos ganha, trabalhadores domésticos ({brl0(v("domestico"))}) e conta própria sem CNPJ ({brl0(v("conta_propria_sem_cnpj"))}).</li>
      <li>O 1% mais rico fica com {pct1(top.p99?.massa_pct)} de toda a renda do país e tem, em média, {top.p99 ? brl0(top.p99.renda_media) : "—"} por morador do domicílio — {top.p99 && top.p10 ? x(top.p99.renda_media, top.p10.renda_media) : "—"} o que têm os 10% mais pobres ({top.p10 ? brl0(top.p10.renda_media) : "—"}), que ficam com {pct1(top.p10?.massa_pct)}. Os 10% mais ricos juntos têm {pct1(top.p90?.massa_pct)} da renda; a metade mais pobre do país, {pct1(dist.metade_mais_pobre_serie[d.ano_distribuicao])}.</li>
      <li>A razão público ÷ privado é maior em {ufs[0].nome} ({x(ufs[0].publico, ufs[0].privado_com_carteira)}) e menor em {ufs[ufs.length - 1].nome} ({x(ufs[ufs.length - 1].publico, ufs[ufs.length - 1].privado_com_carteira)}). O estado mais desigual pelo Gini é {ufMaisDesigual.nome} ({ufMaisDesigual.gini?.toFixed(3).replace(".", ",")}); o menos, {ufMenosDesigual.nome} ({ufMenosDesigual.gini?.toFixed(3).replace(".", ",")}).</li>
    </ul>
    <p class="src">Frases calculadas automaticamente a partir dos dados acima; nenhum número é digitado à mão.</p>
  </div>

  <Glossario termos={["rendimento_habitual", "setor_publico_pnad", "percentil", "renda_domiciliar_pc", "gini"]} />
