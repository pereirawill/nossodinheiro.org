---
import PaginaFiltro from "../../../components/PaginaFiltro.astro";
import todos from "../../../../public/data/custo_senador_2026.json";
import meta from "../../../../public/data/meta_senado_2026.json";
import { slug } from "../../../lib/slug";

export async function getStaticPaths() {
  const rows = (await import("../../../../public/data/custo_senador_2026.json")).default as any[];
  const { slug } = await import("../../../lib/slug");
  return [...new Set(rows.map((r) => r.partido as string))].map((p) => ({ params: { partido: slug(p) }, props: { partido: p } }));
}
const { partido } = Astro.props;
const rows = (todos as any[]).filter((r) => r.partido === partido);
---
<PaginaFiltro casa="senadores" titulo={`Quanto custam os senadores do ${partido}?`}
  descricao={`Os ${rows.length} senadores em exercício filiados ao ${partido}.`}
  rows={rows} todos={todos} meta={meta} partidoAtivo={partido} />
