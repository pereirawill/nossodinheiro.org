---
// Comparação internacional: quanto cada país gasta nas mesmas coisas, em % do PIB.
// Tudo vem de rankings.json (Banco Mundial) e impostos.json (Receita Federal); nada é digitado à mão.
import Base from "../../layouts/Base.astro";
import Termo from "../../components/Termo.astro";
import Glossario from "../../components/Glossario.astro";
import rankings from "../../../public/data/rankings.json";
import seg from "../../../public/data/seguranca.json";
import imp from "../../../public/data/impostos.json";
import funcoes from "../../../public/data/poderes_funcao_2025.json";
import orgaos from "../../../public/data/poderes_orgaos_2025.json";
import cambio from "../../../public/data/cambio.json";
import { JUDICIARIO_BR, JUDICIARIO_EUROPA, JUDICIARIO_EUROPA_META, MONARQUIAS, PARLAMENTOS, CONGRESSO_BR , CONFLITOS, SEM_TOTAL_OFICIAL } from "../../lib/comparacao";

const n0 = (v: number) => Math.round(v).toLocaleString("pt-BR");
const n1 = (v: number | null | undefined) => v == null ? "—" : v.toFixed(1).replace(".", ",");
const n2 = (v: number | null | undefined) => v == null ? "—" : v.toFixed(2).replace(".", ",");
const compact = (v: number) =>
  v >= 1e12 ? `R$ ${(v / 1e12).toFixed(2).replace(".", ",")} tri` : v >= 1e9 ? `R$ ${(v / 1e9).toFixed(1).replace(".", ",")} bi` : `R$ ${Math.round(v / 1e6)} mi`;

const indices = rankings.indices as any[];
const idx = (id: string) => indices.find((i) => i.id === id);

// Países de referência: as maiores economias, os vizinhos e os países com que o Brasil é sempre comparado.
// A escolha é nossa e está declarada na página; a tabela do Banco Mundial tem quase 200 países.
const REF = ["BRA", "ARG", "CHL", "COL", "MEX", "URY", "USA", "CAN", "GBR", "FRA", "DEU", "ITA", "ESP", "PRT",
             "SWE", "JPN", "KOR", "CHN", "IND", "ZAF", "AUS"];
const AREAS = [
  { id: "educacao_pct_pib", rotulo: "Educação", cor: "var(--s1)" },
  { id: "saude_pct_pib", rotulo: "Saúde (gasto público)", cor: "var(--s3)" },
  { id: "saude_total_pct_pib", rotulo: "Saúde (público + privado)", cor: "#9ec5e8" },
  { id: "defesa_pct_pib", rotulo: "Defesa", cor: "var(--s2)" },
  { id: "despesa_governo_pct_pib", rotulo: "Despesa do governo central", cor: "var(--s4)" },
  { id: "beneficios_pct_despesa", rotulo: "Transferências e benefícios", cor: "var(--s5)" },
].map((a) => ({ ...a, ind: idx(a.id) })).filter((a) => a.ind);

const valorDe = (ind: any, iso: string) => (ind.paises as any[]).find((p) => p.iso3 === iso) ?? null;
const linhasRef = REF.map((iso) => {
  const base = AREAS.map((a) => valorDe(a.ind, iso)).find(Boolean);
  return { iso, pais: base?.pais ?? iso, valores: Object.fromEntries(AREAS.map((a) => [a.id, valorDe(a.ind, iso)])) };
}).filter((l) => Object.values(l.valores).some(Boolean));

// A página mostra a MÉDIA, que é a palavra que todo mundo entende, e cada área traz a mediana ao lado como
// conferência: nas seis áreas as duas ficam a menos de 1 ponto uma da outra, então nenhuma conclusão depende da escolha.
const mediana = (xs: number[]) => {
  const v = [...xs].sort((a, b) => a - b);
  return v.length ? (v.length % 2 ? v[(v.length - 1) / 2] : (v[v.length / 2 - 1] + v[v.length / 2]) / 2) : 0;
};
// Um gráfico por área, com TODOS os países aparecendo (pedido do dono em 29/10/2026: a média não pode esconder
// os 20 países dentro de uma barra só).
// Média de longo prazo por país (25 anos), para a pergunta do dono: "um ano é foto; o que vale é o esforço
// sustentado". A cobertura é desigual — há país com 20 anos de dado e país com 7 —, então o número de anos de
// cada um vai junto e a página avisa.
const medias = (rankings as any).medias_longas ?? { indicadores: {}, janela_anos: 0, de: 0, ate: 0 };
const mediaDe = (id: string, iso: string) => (medias.indicadores?.[id] ?? {})[iso] ?? null;

const porArea = AREAS.map((a) => {
  const linhas = [...REF].map((iso) => {
    const v = valorDe(a.ind, iso);
    const m = mediaDe(a.id, iso);
    return v ? { iso, pais: v.pais, valor: v.valor, ano: v.ano, media: m?.media ?? null,
                 anosMedia: m?.anos ?? null, mediaDe: m?.de ?? null, mediaAte: m?.ate ?? null } : null;
  }).filter(Boolean) as any[];
  linhas.sort((x, y) => y.valor - x.valor);
  const outros = linhas.filter((l) => l.iso !== "BRA").map((l) => l.valor);
  const media = outros.length ? outros.reduce((t, v) => t + v, 0) / outros.length : 0;
  const br = linhas.find((l) => l.iso === "BRA");
  const comMedia = linhas.filter((l: any) => l.media != null);
  const mediaLonga = comMedia.length ? comMedia.filter((l: any) => l.iso !== "BRA")
    .reduce((t: number, l: any) => t + l.media, 0) / Math.max(1, comMedia.filter((l: any) => l.iso !== "BRA").length) : null;
  return { ...a, linhas, media, mediana: mediana(outros), br, mediaLonga,
           acimaDaMedia: (br?.valor ?? 0) > media, max: Math.max(...linhas.map((l) => l.valor), media) };
});
const W = 920, rotuloW = 240, barraW = 500;

// carga tributária: o Banco Mundial mede só o governo central; a Receita mede os três níveis
const cargaWB = idx("carga_governo_central");
const cargaBR = (imp as any).carga;
// A diferença para o indicador do Banco Mundial não é "estados e municípios": a União sozinha já passa dele.
// GC.TAX.TOTL.GD.ZS é receita TRIBUTÁRIA do governo central, e deixa de fora a contribuição previdenciária.
const uniaoPct = 100 * ((cargaBR?.por_ente ?? []).find((e: any) => e.ente === "União")?.pct_pib ?? 0);
// carga.ano vem como texto ("2024") e `anual` traz número — comparar com Number, senão a conta zera em silêncio
const anoCarga = ((imp as any).anual as any[]).find((a: any) => a.ano === Number(cargaBR?.ano) && a.meses === 12);
const previdReais = anoCarga?.tributos?.["RECEITA PREVIDENCIÁRIA"] ?? 0;
const totalArrecad = (cargaBR?.por_ente ?? []).find((e: any) => e.ente === "Total");
const pibEstimado = totalArrecad ? (totalArrecad.arrecadacao_milhoes * 1e6) / (totalArrecad.pct_pib || 1) : 0;
const previdPct = pibEstimado ? (100 * previdReais) / pibEstimado : 0;
const cargaTotal = (cargaBR?.serie?.[cargaBR.ano]?.carga ?? 0) * 100;
const bases = cargaBR?.bases?.linhas ?? [];
// Brasil × média da OCDE por base, da tabela 07 do próprio estudo da Receita (que usa o Revenue Statistics da OCDE)
const ocde = cargaBR?.ocde;
const basesOcde = ocde ? Object.entries(ocde.bases as Record<string, Record<string, any>>)
  .map(([base, anos]) => {
    const ultimo = Object.keys(anos).sort().pop()!;
    const primeiro = Object.keys(anos).sort()[0];
    return { base, ano: ultimo, ano0: primeiro, br: anos[ultimo]?.brasil, oc: anos[ultimo]?.ocde,
             br0: anos[primeiro]?.brasil, oc0: anos[primeiro]?.ocde };
  }).filter((x) => x.br != null && x.oc != null) : [];
const maxOcde = Math.max(...basesOcde.map((x) => Math.max(x.br, x.oc)), 1);

// o que o Brasil gasta de fato, pelo nosso próprio dado (SIOP), para o leitor conferir a ordem de grandeza
const f = (cod: string) => (funcoes as any[]).find((x) => x.funcao === cod)?.pago ?? 0;
const AREAS_BR = [
  { nome: "Previdência Social", v: f("09") }, { nome: "Saúde", v: f("10") }, { nome: "Educação", v: f("12") },
  { nome: "Assistência Social", v: f("08") }, { nome: "Defesa Nacional", v: f("05") },
];
const pibBR = (cargaBR?.serie?.[cargaBR.ano]?.pib ?? 0) * 1e9;

// Judiciário: a coluna comparável com o CNJ é a dos tribunais
const jud = [{ pais: "Brasil", tribunais: JUDICIARIO_BR.pct_pib_calculado, sistema: null, eurostat: null, nota: "", br: true },
             ...JUDICIARIO_EUROPA.map((l) => ({ ...l, br: false }))]
  .sort((a, b) => (b.tribunais ?? b.sistema ?? 0) - (a.tribunais ?? a.sistema ?? 0));
const maxJud = Math.max(...jud.map((l) => l.tribunais ?? 0));
const vezes = JUDICIARIO_BR.pct_pib_calculado / JUDICIARIO_EUROPA_META.mediana_tribunais;

// Monarquias: converte pela PTAX do dia para dar ordem de grandeza, com a data declarada
const ptax = Object.fromEntries((cambio.moedas as any[]).map((m) => [m.simbolo, m.hoje]));
const dataPtax = (cambio.moedas as any[])[0]?.data_hoje ?? cambio.usd_ultimo_mes;
const monarquias = MONARQUIAS.map((m) => {
  const taxa = ptax[m.moeda];
  return { ...m, reais: taxa ? m.valor * taxa : null,
           reais_ajustado: taxa && m.ajustado ? m.ajustado.valor * taxa : null };
}).sort((a, b) => (b.reais ?? 0) - (a.reais ?? 0));
const pop = (idx("populacao")?.paises ?? []) as any[];
// A Coroa é o chefe de Estado: o par brasileiro é a Presidência da República, não o Judiciário nem o Congresso.
const orgao = (cod: string) => (orgaos as any[]).filter((o) => o.cod_superior === cod);
const presidenciaOrgao = orgao("20000");
const presidenciaSo = presidenciaOrgao.find((o) => o.orgao === "Presidência da República")?.pago ?? 0;
const presidenciaTudo = presidenciaOrgao.reduce((t, o) => t + o.pago, 0);
const congresso = orgao("01000").concat(orgao("02000")).reduce((t, o) => t + o.pago, 0);
const habDe = (iso: string) => pop.find((p) => p.iso3 === iso)?.valor ?? null;
const habBR = habDe("BRA");
// O Brasil entra na própria tabela (pedido do dono em 29/10/2026): sem a linha dele não dá para comparar de olho.
// A ressalva de escopo, que já estava no texto, passa a aparecer na linha.
const monarquiasComBR = [
  { pais: "Brasil (Presidência da República)", iso3: "BRA", moeda: "BRL", valor: presidenciaSo,
    reais: presidenciaSo, reais_ajustado: null, ano: "2025, pago",
    inclui: "a unidade orçamentária Presidência da República: pessoal, custeio e a estrutura que assessora o chefe de Estado e de governo",
    fora: `o resto do órgão superior — ABIN e EBC, entre outros —, que levaria o total a ${compact(presidenciaTudo)}`,
    br: true },
  ...monarquias.map((m) => ({ ...m, br: false })),
].sort((a: any, b: any) => (b.reais ?? 0) - (a.reais ?? 0));

// Parlamentos: só as duas casas, cada um convertido pela PTAX do dia, com a base declarada
const parlamentos = [
  { pais: "Brasil", casas: "Câmara dos Deputados + Senado Federal", moeda: "BRL", valor: CONGRESSO_BR.total,
    base: "pago", ano: String(CONGRESSO_BR.ano), cadeiras: CONGRESSO_BR.cadeiras, reais: CONGRESSO_BR.total,
    pensoes: `38% do total são inativos: sem eles o Congresso custa ${compact(CONGRESSO_BR.sem_inativos)}`,
    fora: "o TCU, que é órgão orçamentário próprio (R$ 2,78 bi)", fonte: CONGRESSO_BR.fonte, url: "/poderes/",
    cadeiras_nota: "513 deputados e 81 senadores", br: true },
  ...PARLAMENTOS.map((x) => ({ ...x, reais: ptax[x.moeda] ? x.valor * ptax[x.moeda] : null, br: false })),
].sort((a, b) => (b.reais ?? 0) - (a.reais ?? 0));
const maxParl = Math.max(...parlamentos.map((p2) => p2.reais ?? 0));
// ── Por que "% do PIB" engana em educação (pergunta do dono em 29/10/2026) ─────────────────────────────────────────
const porAluno = idx("gasto_aluno_fundamental");
const criancas = idx("criancas_pct");
const alunoLinhas = porAluno ? REF.map((iso) => {
  const g = (porAluno.paises as any[]).find((x) => x.iso3 === iso);
  const cr = criancas ? (criancas.paises as any[]).find((x) => x.iso3 === iso) : null;
  const ed = valorDe(idx("educacao_pct_pib"), iso);
  return g ? { iso, pais: g.pais, porAluno: g.valor, ano: g.ano, criancas: cr?.valor ?? null, pctPib: ed?.valor ?? null } : null;
}).filter(Boolean).sort((a: any, b: any) => b.porAluno - a.porAluno) as any[] : [];
const brAluno = alunoLinhas.find((l) => l.iso === "BRA");
const maxAluno = Math.max(...alunoLinhas.map((l) => l.porAluno), 1);

// ── Violência: o Brasil, o mundo e as guerras (pedido de 29/10/2026) ───────────────────────────────────────────────
const indHom = idx("homicidios");
const popInd = idx("populacao");
const popDe = (iso: string) => (popInd?.paises as any[])?.find((p) => p.iso3 === iso)?.valor ?? null;
const homRef = indHom ? REF.filter((i) => i !== "BRA").map((iso) => (indHom.paises as any[]).find((p) => p.iso3 === iso))
  .filter(Boolean).sort((a, b) => b.valor - a.valor) : [];
const brHom = indHom?.brasil;
// uma lista só, do maior para o menor: os 5 piores do mundo + os países de referência + o Brasil no lugar dele
const homLista = indHom ? (() => {
  const piores = [...(indHom.paises as any[])].sort((a, b) => b.valor - a.valor).slice(0, 5);
  const juntos = [...piores, ...homRef.filter((p) => !piores.some((q) => q.iso3 === p.iso3))];
  const br = (indHom.paises as any[]).find((p) => p.iso3 === "BRA");
  return [...juntos, ...(br && !juntos.some((p) => p.iso3 === "BRA") ? [br] : [])].sort((a, b) => b.valor - a.valor);
})() : [];
const mviBr = (seg as any).brasil.mvi as number;
const popBr = (seg as any).brasil.populacao as number;
const taxaMviBr = (seg as any).brasil.taxa_mvi as number;
const conflitos = CONFLITOS.map((c) => ({ ...c, taxaAno: (c.mortes / c.anos / c.populacao) * 100_000 }))
  .sort((a, b) => b.taxaAno - a.taxaAno);
---
<Base title="Quanto cada país gasta nas mesmas coisas — Nosso Dinheiro" accent="var(--s5)"
  description="Gasto público em educação, saúde, defesa e benefícios como percentual do PIB, no Brasil e em 20 países de referência, com os dados do Banco Mundial.">
  <h1>Quanto cada país gasta nas mesmas coisas</h1>
  <p class="lede">
    Comparar reais com reais não diz nada entre países de tamanhos diferentes. O que se compara é a <b>fatia do
    PIB</b> que cada governo gasta em cada área. Aqui estão educação, saúde, defesa, o total do governo central e as
    transferências de benefícios, do Brasil e de 20 países de referência, pelos dados do Banco Mundial.
  </p>
  <p class="meta">fonte: Banco Mundial (dados abertos) e Receita Federal · <a href="/rankings/">rankings de resultado</a> · <a href="/metodologia/">metodologia</a></p>

  <div class="disclaimer"><span aria-hidden="true">ⓘ</span>
    <div><b>Percentual do PIB não é nota de eficiência.</b> Gastar mais pode ser escolha de um país com população mais
    velha, ou com mais gente para atender; gastar menos pode ser serviço pago direto pelas famílias, como na saúde. A
    página não diz qual nível é o certo. E <b>cada indicador tem o ano que o país informou</b>: a tabela mostra o ano de
    cada número, porque comparar 2023 com 2019 esconde diferença. "Despesa do governo central" e "transferências" <b>não
    incluem</b> estados e municípios, que no Brasil gastam mais que a União em saúde e educação.</div>
  </div>

  <h2>Brasil e a média dos países de referência</h2>
  <div class="card">
    <p style="margin:0 0 10px">
      <b>Quais são os países de referência.</b> A lista é nossa, e está aqui inteira:
      {" "}{linhasRef.filter((l) => l.iso !== "BRA").map((l) => l.pais).join(", ")}.
      São os <b>vizinhos</b> ({["ARG", "CHL", "COL", "MEX", "URY"].map((i) => linhasRef.find((l) => l.iso === i)?.pais).filter(Boolean).join(", ")}),
      as <b>maiores economias</b> e os países com que o Brasil costuma ser comparado. A tabela do Banco Mundial tem
      quase 200 países: escolher 20 é uma decisão editorial, não um dado — por isso ela está declarada, e a tabela
      "país por país", mais abaixo, mostra o número de cada um para quem quiser refazer a média com outra lista.
    </p>
    <p class="src" style="margin:0">
      Cada área tem o seu gráfico abaixo, com <b>um país por linha</b> — a média aparece como linha tracejada, para dar
      referência sem esconder quem está onde. O Brasil fica acima da média em
      {" "}{porArea.filter((a) => a.acimaDaMedia).length} das {porArea.length} áreas. Conferimos também pela
      <b> mediana</b>, o país do meio, que não se deixa puxar por um valor extremo: ela aparece ao lado de cada média.
      Nas áreas em que o Brasil está perto do centro do grupo, a posição muda conforme se use média ou mediana — por
      isso as duas ficam à vista, em vez de escolhermos uma.
    </p>
  </div>

  {porArea.map((a) => (
    <div class="card" style="margin-top:14px">
      <h3 style="margin:0 0 2px">{a.rotulo}</h3>
      <p class="sub" style="margin:0 0 10px">
        {a.ind.unidade} · Brasil {n1(a.br?.valor ?? 0)} no último ano{a.br?.media != null ? ` e ${n1(a.br.media)} na média de ${a.br.anosMedia} anos` : ""} ·
        média dos outros países {n1(a.media)} (mediana {n1(a.mediana)}{a.mediaLonga != null ? `, média longa ${n1(a.mediaLonga)}` : ""}) ·
        o Brasil está <b>{a.acimaDaMedia ? "acima" : "abaixo"}</b> da média
      </p>
      <svg viewBox={`0 0 ${W} ${a.linhas.length * 19 + 10}`} width="100%" role="img" aria-label={`${a.rotulo}: ${a.ind.unidade}, país por país`}>
        {a.linhas.map((l, i) => (<g transform={`translate(0 ${i * 19 + 5})`}>
          <text x={rotuloW - 8} y="11" text-anchor="end" font-size="11.5" fill={l.iso === "BRA" ? "var(--ink)" : "var(--ink-2)"} font-weight={l.iso === "BRA" ? "700" : "400"}>{l.pais}</text>
          <rect x={rotuloW} y="2" width={Math.max(2, (l.valor / a.max) * barraW)} height="12" rx="2"
            fill={l.iso === "BRA" ? "var(--s4)" : "var(--neutro)"} opacity={l.iso === "BRA" ? 1 : 0.55}>
            <title>{l.pais}: {n2(l.valor)} {a.ind.unidade} em {l.ano}{l.media != null ? ` · média de ${l.anosMedia} anos (${l.mediaDe}–${l.mediaAte}): ${n2(l.media)}` : " · sem média longa"}</title></rect>
          {l.media != null && <line x1={rotuloW + (l.media / a.max) * barraW} x2={rotuloW + (l.media / a.max) * barraW}
            y1="0" y2="16" stroke="var(--ink)" stroke-width="1.5" opacity="0.7">
            <title>{l.pais}: média de {l.anosMedia} anos ({l.mediaDe}–{l.mediaAte}) = {n2(l.media)}</title></line>}
          <text x={rotuloW + (l.valor / a.max) * barraW + 8} y="12" font-size="11" font-family="IBM Plex Mono, monospace"
            fill="var(--ink-2)">{n1(l.valor)}</text>
        </g>))}
        <line x1={rotuloW + (a.media / a.max) * barraW} x2={rotuloW + (a.media / a.max) * barraW} y1="2"
          y2={a.linhas.length * 19 + 2} stroke="var(--ink-2)" stroke-dasharray="3 3" />
      </svg>
      <p class="src">
        Brasil em destaque; a linha tracejada é a média dos outros países com dado nesta área ({a.linhas.length - 1} países).
        O <b>traço vertical escuro em cada barra</b> é a média daquele país nos últimos {medias.janela_anos} anos — um
        ano é foto, e o que forma uma população é o esforço sustentado. <b>A cobertura é desigual</b>: há país com 20
        anos de dado na janela e país com 7, e o número de anos de cada um está na dica da barra.
        O ano do valor mais recente também varia e está na mesma dica. Fonte: Banco Mundial, indicador {a.ind.url.split("/").pop()}.
      </p>
    </div>
  ))}

  <h2>País por país</h2>
  <div class="card">
    <table>
      <thead><tr><th>País</th>{AREAS.map((a) => <th class="num">{a.rotulo}</th>)}</tr></thead>
      <tbody>
        {linhasRef.map((l) => (<tr class={l.iso === "BRA" ? "destaque" : ""}>
          <td>{l.iso === "BRA" ? <b>{l.pais}</b> : l.pais}</td>
          {AREAS.map((a) => (<td class="num">{l.valores[a.id]
            ? <>{n1(l.valores[a.id].valor)} <span class="ano">{l.valores[a.id].ano}</span></> : "—"}</td>))}
        </tr>))}
      </tbody>
    </table>
    <p class="src">
      O número pequeno é o ano do dado de cada país. Os 20 países de comparação foram escolhidos por nós: os vizinhos da
      América do Sul, as maiores economias e os países com que o Brasil costuma ser comparado. A base do Banco Mundial tem
      quase 200 países, e a posição do Brasil entre todos eles está em <a href="/rankings/">Rankings</a>:
      {AREAS.map((a) => <> {a.rotulo.toLowerCase()} {a.ind.brasil?.posicao}º de {a.ind.brasil?.total};</>)}
    </p>
  </div>

  <h2>Quanto custa a Justiça, em % do PIB</h2>
  <div class="card">
    <div class="hero" style="margin:0 0 14px">
      <div class="stat big"><b>{n1(JUDICIARIO_BR.pct_pib)}%</b><span>do PIB é o que o Poder Judiciário brasileiro gastou em {JUDICIARIO_BR.ano}: {compact(JUDICIARIO_BR.despesa)}, ou R$ {n2(JUDICIARIO_BR.por_habitante)} por habitante</span></div>
      <div class="stat"><b>{n2(JUDICIARIO_EUROPA_META.mediana_tribunais)}%</b><span>é a mediana europeia do mesmo conceito (orçamento dos tribunais), entre os {JUDICIARIO_EUROPA_META.paises_cepej} países que responderam à CEPEJ</span></div>
      <div class="stat"><b>{n1(vezes)}×</b><span>é a razão entre os dois — e o Brasil tem <b class="inline">metade</b> dos juízes por habitante: {n2(JUDICIARIO_BR.magistrados_100k)} contra {n2(JUDICIARIO_EUROPA_META.mediana_magistrados_100k)} por 100 mil</span></div>
    </div>
    <svg viewBox={`0 0 ${W} ${jud.filter((l) => l.tribunais).length * 24 + 12}`} width="100%" role="img" aria-label="Orçamento dos tribunais como percentual do PIB, por país">
      {jud.filter((l) => l.tribunais).map((l, i) => (<g transform={`translate(0 ${i * 24 + 8})`}>
        <text x={rotuloW - 8} y="13" text-anchor="end" font-size="12" fill="var(--ink)">{l.pais}</text>
        <rect x={rotuloW} y="2" width={Math.max(2, ((l.tribunais ?? 0) / maxJud) * barraW)} height="14"
          fill={l.br ? "var(--s4)" : "var(--neutro)"} rx="2"><title>{l.pais}: {n2(l.tribunais)}% do PIB</title></rect>
        <text x={rotuloW + barraW + 10} y="13" font-size="11.5" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{n2(l.tribunais)}%</text>
      </g>))}
    </svg>
    <p class="src">
      <b>São conceitos que precisam casar, e este é o detalhe que inverte comparações.</b> O CNJ mede <b>só os
      tribunais</b>; Ministério Público, Defensoria e Advocacia Pública não entram. A CEPEJ mede tribunais mais
      Ministério Público e assistência judiciária, e por isso a coluna usada aqui é a dos <b>tribunais</b> — comparar o
      número do CNJ com o total europeu seria erro de construção. Brasil de {JUDICIARIO_BR.ano}, CEPEJ de
      {" "}{JUDICIARIO_EUROPA_META.ano_cepej} (o ciclo com dados de 2025 ainda não saiu), Eurostat de
      {" "}{JUDICIARIO_EUROPA_META.ano_eurostat}: os anos não batem e está dito.
    </p>
    <p class="src">
      <b>Por habitante, a leitura se inverte — e as duas são verdade.</b> Os R$ {n2(JUDICIARIO_BR.por_habitante)} por
      habitante equivalem a € {n2(JUDICIARIO_BR.por_habitante_eur)} (câmbio médio de 2025, R$ 6,3085 por euro), perto dos
      € {n2(JUDICIARIO_EUROPA_META.ue27_por_habitante_eur)} da União Europeia. Como percentual do PIB o Brasil está muito
      acima; por habitante, na média. As duas coisas convivem porque o PIB por habitante brasileiro é bem menor. O CNJ
      publica também a despesa <b>sem aposentados e pensionistas</b>, que são 15,3% do total: {n1(JUDICIARIO_BR.pct_pib_sem_inativos)}%
      do PIB. Não conseguimos confirmar se os orçamentos europeus incluem pensões, então a comparação vale nos dois
      cenários e não afirmamos nada além disso. Duas diferenças estruturais: o Brasil tem Justiça Eleitoral e Justiça do
      Trabalho como ramos do Judiciário, sem par orçamentário na Europa, e não tem ramo de tribunais administrativos, que
      existe quase em toda a Europa. O Judiciário brasileiro também arrecada {compact(JUDICIARIO_BR.arrecadacao)} em custas
      e taxas, 41% da própria despesa. Fontes: {JUDICIARIO_BR.fonte}; {JUDICIARIO_EUROPA_META.fonte}.
    </p>
  </div>

  <h2>Quanto custa a Coroa, e com o que isso se compara no Brasil</h2>
  <div class="card">
    <p class="explica">
      A Coroa é o <b>chefe de Estado</b>. O que corresponde a ela no Brasil é a <b>Presidência da República</b>, não o
      Judiciário nem o Congresso — o rei não julga nem legisla. A Presidência brasileira pagou
      {" "}<b>{compact(presidenciaSo)}</b> em 2025 como unidade orçamentária, ou {compact(presidenciaTudo)} contando todo o
      órgão superior, que inclui a ABIN e a EBC. Por habitante dá
      {" "}{habBR ? `R$ ${(presidenciaSo / habBR).toFixed(2).replace(".", ",")}` : "—"} só a Presidência. Para efeito de
      escala, o Congresso Nacional (Câmara mais Senado) custou {compact(congresso)} — comparar <b>parlamento com
      parlamento</b> é outra conta, e está na seção seguinte.
    </p>
    <table>
      <thead><tr><th>País</th><th class="num">Valor no orçamento</th><th class="num">Em reais</th><th class="num">Por habitante</th><th>Ano</th></tr></thead>
      <tbody>{monarquiasComBR.map((m: any) => (<tr class={m.br ? "destaque" : undefined}>
        <td>{m.br ? <b>{m.pais}</b> : m.pais}</td>
        <td class="num">{m.moeda} {Math.round(m.valor).toLocaleString("pt-BR")}</td>
        <td class="num">{m.reais ? compact(m.reais) : "—"}</td>
        <td class="num">{m.reais && habDe(m.iso3) ? `R$ ${(m.reais / habDe(m.iso3)!).toFixed(2).replace(".", ",")}` : "—"}</td>
        <td>{m.ano}</td></tr>))}
      </tbody>
    </table>
    <p class="src">
      Convertido pela PTAX de fechamento do Banco Central na data do painel de <a href="/inflacao/">Câmbio</a>; a cotação
      muda todo dia e o valor em reais serve só para dar ordem de grandeza. "Por habitante" usa a população do Banco
      Mundial. <b>A linha do Brasil não é uma monarquia equivalente</b>: a Presidência é um órgão de governo, com
      milhares de servidores e a estrutura que assessora o chefe de Estado <i>e</i> de governo, enquanto a dotação das
      coroas cobre sobretudo a casa real. Ela está na tabela porque é o cargo correspondente — chefe de Estado —, e
      a coluna "o que inclui", logo abaixo, mostra o que entra de cada lado. A Presidência da República tem painel próprio em <a href="/presidencia/">Presidência</a> e os
      ex-presidentes aparecem em <a href="/beneficios/">Benefícios</a>. <b>A ressalva vale nos dois lados:</b> a
      Presidência brasileira inclui a estrutura de governo (Casa Civil, Gabinete de Segurança Institucional, Secretaria de
      Comunicação), que numa monarquia parlamentarista fica com o primeiro-ministro, não com o rei. Então a linha da
      Presidência serve de escala, não de empate.
    </p>
    <p class="src">
      <b>As oito linhas não medem a mesma coisa, e isso não é detalhe.</b> Cada país decide o que entra na rubrica da
      Coroa:
    </p>
    <table>
      <thead><tr><th>País</th><th>O que está dentro</th><th>O que está fora</th></tr></thead>
      <tbody>{monarquiasComBR.map((m: any) => (<tr class={m.br ? "destaque" : undefined}>
        <td>{m.br ? <b>{m.pais}</b> : m.pais}</td><td>{m.inclui}</td><td>{m.fora}</td></tr>))}
      </tbody>
    </table>
    <p class="src">
      Os casos extremos: a <b>Dinamarca</b> conta apenas pagamentos em dinheiro a pessoas — nem palácio, nem pessoal, nem
      segurança; a <b>Espanha</b> tem uma linha única, e palácios e Guarda Real ficam em outros órgãos; a <b>Bélgica</b> é
      a única que coloca a polícia de proteção dentro da conta, cerca de 47% do total, e sem ela cairia para
      {" "}{monarquias.find((m) => m.iso3 === "BEL")?.ajustado?.valor.toLocaleString("pt-BR")} euros; os <b>Países
      Baixos</b> deixam os palácios fora, e com eles subiria para
      {" "}{monarquias.find((m) => m.iso3 === "NLD")?.ajustado?.valor.toLocaleString("pt-BR")} euros. O britânico não é
      dotação comum: é uma fórmula sobre o lucro do Crown Estate, que cai de 25% para 20,5% em 2027-28, e não inclui a
      renda dos ducados de Lancaster e Cornualha. Fonte de cada linha na coluna abaixo; todas são documento oficial do
      próprio país, verificado em 28/10/2026.
    </p>
    <table>
      <thead><tr><th>País</th><th>Situação</th><th>Fonte</th></tr></thead>
      <tbody>{monarquias.map((m) => (<tr>
        <td>{m.pais}</td><td>{m.status}</td><td><a href={m.url} rel="nofollow noopener">{m.fonte}</a></td></tr>))}
      </tbody>
    </table>
  </div>

  <h2>Quanto custa o parlamento, aqui e em dez países</h2>
  <div class="card">
    <p class="explica">
      Esta é a comparação que pareia de verdade com o Congresso Nacional. Em todas as linhas estão <b>só as duas
      casas</b>, sem tribunal de contas, sem ombudsman e sem biblioteca do parlamento, porque cada país põe coisas
      diferentes na mesma rubrica. O Congresso brasileiro pagou {compact(CONGRESSO_BR.total)} em 2025, sendo
      {" "}{compact(CONGRESSO_BR.camara)} a Câmara e {compact(CONGRESSO_BR.senado)} o Senado.
    </p>
    <svg viewBox={`0 0 ${W} ${parlamentos.length * 24 + 12}`} width="100%" role="img" aria-label="Custo anual do parlamento por país, convertido em reais">
      {parlamentos.map((p2, i) => (<g transform={`translate(0 ${i * 24 + 8})`}>
        <text x={rotuloW - 8} y="13" text-anchor="end" font-size="12" fill="var(--ink)">{p2.pais}</text>
        <rect x={rotuloW} y="2" width={Math.max(2, ((p2.reais ?? 0) / maxParl) * barraW)} height="14"
          fill={p2.br ? "var(--s4)" : "var(--neutro)"} rx="2"><title>{p2.pais}: {p2.reais ? compact(p2.reais) : "—"}</title></rect>
        <text x={rotuloW + barraW + 10} y="13" font-size="11.5" font-family="IBM Plex Mono, monospace" fill="var(--ink)">
          {p2.reais ? compact(p2.reais) : "—"}</text>
      </g>))}
    </svg>
    <table style="margin-top:14px">
      <thead><tr><th>País</th><th class="num">Valor</th><th class="num">Em reais</th><th class="num">Cadeiras</th><th class="num">Por cadeira</th><th>Base</th></tr></thead>
      <tbody>{parlamentos.map((p2) => (<tr class={p2.br ? "destaque" : ""}>
        <td>{p2.br ? <b>{p2.pais}</b> : p2.pais}<br /><span class="ano">{p2.casas}</span></td>
        <td class="num">{p2.moeda === "BRL" ? compact(p2.valor) : `${p2.moeda} ${Math.round(p2.valor).toLocaleString("pt-BR")}`}</td>
        <td class="num">{p2.reais ? compact(p2.reais) : "—"}</td>
        <td class="num">{p2.cadeiras.toLocaleString("pt-BR")}</td>
        <td class="num">{p2.reais ? compact(p2.reais / p2.cadeiras) : "—"}</td>
        <td><span class="ano">{p2.base}, {p2.ano}</span></td></tr>))}
      </tbody>
    </table>
    <p class="src">
      Convertido pela PTAX do dia; serve de ordem de grandeza, não de precisão. A coluna "base" importa: há realizado e
      auditado (Reino Unido), aprovado em lei (Alemanha, Itália, Suécia, Japão, Países Baixos, Estados Unidos, Portugal),
      gasto próprio realizado (França) e um caso único — a <b>Espanha</b> está com o orçamento de 2023 prorrogado três
      vezes, porque não houve lei nova.
    </p>
    <p class="src">
      <b>O que mais distorce não é o país, é a aposentadoria dentro da rubrica.</b> Na Câmara italiana os inativos são 47%
      da despesa; no Congresso brasileiro, 38% ({compact(CONGRESSO_BR.inativos)} de {compact(CONGRESSO_BR.total)}, sendo
      45% no Senado e 32% na Câmara). Nos Estados Unidos é <b>zero</b>: a aposentadoria e até o salário dos congressistas
      correm em outra lei. Sem os inativos, o Congresso brasileiro cai para {compact(CONGRESSO_BR.sem_inativos)} — e é
      essa a linha a usar contra Estados Unidos e Reino Unido. Dois denominadores também não servem para dividir: o
      Bundesrat alemão é formado por ministros de governos estaduais, não é câmara alta eleita, e os 797 lordes britânicos
      recebem ajuda de custo por dia de presença, não salário.
    </p>
    <table>
      <thead><tr><th>País</th><th>Aposentadoria dentro da rubrica</th><th>O que ficou fora</th></tr></thead>
      <tbody>{parlamentos.map((p2) => (<tr>
        <td>{p2.pais}</td><td>{p2.pensoes}</td><td>{p2.fora}</td></tr>))}
      </tbody>
    </table>
    <p class="src">
      Fontes, uma por país: {parlamentos.filter((p2) => !p2.br).map((p2) => <><a href={p2.url} rel="nofollow noopener">{p2.pais}</a>{" · "}</>)}
      e, para o Brasil, {CONGRESSO_BR.fonte}. Todas são documento oficial do próprio país, verificado em 28/10/2026.
      Segurança e prédios são o segundo eixo de distorção: a polícia do Capitólio (R$ 4,6 bi em reais) e os prédios do
      Congresso americano estão <b>fora</b> das linhas das duas casas, enquanto no Reino Unido a segurança está dentro.
    </p>
  </div>

  <h2>Carga tributária: por que o número internacional é menor</h2>
  <div class="card">
    <div class="hero" style="margin:0 0 14px">
      <div class="stat"><b>{n1(cargaTotal)}%</b><span>do PIB é o que <b class="inline">União, estados e municípios</b> arrecadam juntos, pela Receita Federal ({cargaBR?.ano})</span></div>
      <div class="stat"><b>{n1(cargaWB?.brasil?.valor)}%</b><span>do PIB é o que o Banco Mundial registra para o Brasil: receita <b class="inline">tributária</b> do governo central, sem a contribuição previdenciária ({cargaWB?.brasil?.ano})</span></div>
    </div>
    <table>
      <thead><tr><th>Base de incidência</th><th class="num">% de tudo que se arrecada</th><th class="num">União</th><th class="num">Estados</th><th class="num">Municípios</th></tr></thead>
      <tbody>{bases.filter((b: any) => b.pct >= 0.0005).sort((a: any, b: any) => b.pct - a.pct).map((b: any) => (
        <tr><td>{b.base}</td><td class="num"><b>{n1(b.pct * 100)}%</b></td>
          <td class="num">{b.federal ? compact(b.federal * 1e6) : "—"}</td>
          <td class="num">{b.estadual ? compact(b.estadual * 1e6) : "—"}</td>
          <td class="num">{b.municipal ? compact(b.municipal * 1e6) : "—"}</td></tr>))}
      </tbody>
    </table>
    <h3 style="margin:18px 0 6px">Brasil e a média da OCDE, base por base</h3>
    <svg viewBox={`0 0 ${W} ${basesOcde.length * 44 + 12}`} width="100%" role="img" aria-label="Carga tributária do Brasil e média da OCDE, por base de incidência">
      {basesOcde.map((x, i) => (<g transform={`translate(0 ${i * 44 + 8})`}>
        <text x={rotuloW - 8} y="14" text-anchor="end" font-size="12.5" fill="var(--ink)">{x.base}</text>
        <text x={rotuloW - 8} y="28" text-anchor="end" font-size="10.5" fill="var(--ink-2)">% do PIB em {x.ano}</text>
        <rect x={rotuloW} y="2" width={Math.max(2, (x.br / maxOcde) * barraW)} height="14" fill="var(--s4)" rx="2">
          <title>Brasil: {n1(x.br)}% do PIB em {x.ano} (era {n1(x.br0)}% em {x.ano0})</title></rect>
        <rect x={rotuloW} y="18" width={Math.max(2, (x.oc / maxOcde) * barraW)} height="14" fill="var(--neutro)" rx="2">
          <title>Média da OCDE: {n1(x.oc)}% do PIB em {x.ano} (era {n1(x.oc0)}% em {x.ano0})</title></rect>
        <text x={rotuloW + barraW + 10} y="14" font-size="11.5" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{n1(x.br)}%</text>
        <text x={rotuloW + barraW + 10} y="30" font-size="11.5" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{n1(x.oc)}%</text>
      </g>))}
    </svg>
    <div class="legend"><span><i style="background:var(--s4)"></i>Brasil</span><span><i style="background:var(--neutro)"></i>média da OCDE</span></div>
    <p class="src">
      <b>A carga total é parecida; o que cobra é diferente.</b> A tabela é da própria Receita Federal, montada com o
      Revenue Statistics da OCDE, e mostra que o Brasil arrecada <b>mais sobre bens e serviços</b> e <b>menos sobre renda,
      lucro e ganho de capital</b> que a média de 36 países da OCDE — com carga total quase igual. É o mesmo fato que a
      aba <a href="/imposto-de-renda/">Imposto de Renda</a> mostra por dentro, na alíquota que cai no topo. Fonte:
      {" "}{ocde?.fonte}.
    </p>
    <p class="src">
      Comparar carga tributária entre países é a armadilha mais comum, e aqui a conta fecha: o indicador do Banco
      Mundial é a receita <b>tributária</b> do governo central e deixa de fora a contribuição previdenciária. A União
      sozinha arrecada {n1(uniaoPct)}% do PIB; tirando a receita previdenciária ({n1(previdPct)}% do PIB) sobram
      {" "}{n1(uniaoPct - previdPct)}%, contra os {n1(cargaWB?.brasil?.valor)}% do Banco Mundial — a {n1(Math.abs(uniaoPct - previdPct - (cargaWB?.brasil?.valor ?? 0)))} ponto
      de diferença, que não conseguimos fechar e fica declarada aqui. Estados e municípios — ICMS, ISS, IPVA, IPTU —
      ficam fora dos dois lados dessa conta. O número comparável com a OCDE é o da Receita Federal, de
      {" "}{n1(cargaTotal)}% do PIB. Fontes: Banco Mundial (GC.TAX.TOTL.GD.ZS) e Receita Federal, Carga Tributária no
      Brasil {cargaBR?.edicao}, tabela INC 01-A. Detalhe por tributo em <a href="/impostos/">Impostos</a>.
    </p>
  </div>

  <h2>O que o Brasil gasta, em reais, nas mesmas áreas</h2>
  <div class="card">
    <table>
      <thead><tr><th>Função da União (2025)</th><th class="num">Pago</th><th class="num">% do PIB</th></tr></thead>
      <tbody>{AREAS_BR.map((a) => (
        <tr><td>{a.nome}</td><td class="num">{compact(a.v)}</td><td class="num">{pibBR ? n2((a.v / pibBR) * 100) + "%" : "—"}</td></tr>))}
      </tbody>
    </table>
    <p class="src">
      É só a <b>União</b>, pela função da Lei Orçamentária (SIOP), sobre o PIB de {cargaBR?.ano}. Não bate com as colunas
      internacionais de propósito: saúde e educação no Brasil são pagas principalmente por estados e municípios, que
      aparecem em <a href="/estados/">Estados</a> e <a href="/municipios/">Municípios</a>, e o indicador do Banco Mundial
      para educação e saúde soma todos os níveis de governo, enquanto o de "despesa do governo central" não.
    </p>
  </div>


  <h2>Por que "% do PIB" engana em educação</h2>
  <div class="card">
    <p style="margin:0 0 10px">
      O Brasil gasta <b>{n1(brAluno?.pctPib ?? 0)}% do PIB</b> em educação, acima da média dos países de referência — e
      mesmo assim gasta <b>US$ {n0(brAluno?.porAluno ?? 0)} por aluno</b> do ensino fundamental, contra
      {" "}US$ {n0(alunoLinhas[0]?.porAluno ?? 0)} do país que mais gasta desta lista. Percentual do PIB não é dinheiro:
      a mesma fatia rende muito menos onde o PIB por habitante é menor — e onde há proporcionalmente mais crianças
      para dividir a conta ({n1(brAluno?.criancas ?? 0)}% da população brasileira tem até 14 anos, contra
      {" "}{n1(alunoLinhas.find((l) => l.iso === "KOR")?.criancas ?? 0)}% na Coreia e
      {" "}{n1(alunoLinhas.find((l) => l.iso === "DEU")?.criancas ?? 0)}% na Alemanha).
    </p>
    <svg viewBox={`0 0 ${W} ${alunoLinhas.length * 19 + 10}`} width="100%" role="img" aria-label="Gasto público por aluno do ensino fundamental, em dólares PPP">
      {alunoLinhas.map((l, i) => (<g transform={`translate(0 ${i * 19 + 5})`}>
        <text x={rotuloW - 8} y="11" text-anchor="end" font-size="11.5" fill={l.iso === "BRA" ? "var(--ink)" : "var(--ink-2)"} font-weight={l.iso === "BRA" ? "700" : "400"}>{l.pais}</text>
        <rect x={rotuloW} y="2" width={Math.max(2, (l.porAluno / maxAluno) * barraW)} height="12" rx="2"
          fill={l.iso === "BRA" ? "var(--s4)" : "var(--neutro)"} opacity={l.iso === "BRA" ? 1 : 0.55}>
          <title>{l.pais}: US$ {n0(l.porAluno)} por aluno por ano ({l.ano}) · {n1(l.pctPib ?? 0)}% do PIB em educação</title></rect>
        <text x={rotuloW + (l.porAluno / maxAluno) * barraW + 8} y="12" font-size="11" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">US$ {n0(l.porAluno)}</text>
      </g>))}
    </svg>
    <p class="src">
      Em dólares ajustados pelo poder de compra, por aluno do ensino fundamental, por ano.
      <b>Conta nossa, a partir de dois dados oficiais</b>: o Banco Mundial publica a despesa por aluno como percentual
      do PIB por habitante, e nós multiplicamos pelo PIB por habitante em PPP <b>do mesmo ano e do mesmo país</b>.
      <b>O ano é antigo e muda de país para país</b> — o do Brasil é {brAluno?.ano} — porque a série da UNESCO, de onde
      o Banco Mundial tira esse dado, parou de ser alimentada por boa parte dos países; o ano de cada um está na dica
      da barra. Fonte: Banco Mundial, indicador SE.XPD.PRIM.PC.ZS, combinado com NY.GDP.PCAP.PP.CD.
    </p>
  </div>

  <h2>Violência: o Brasil, os outros países e as guerras</h2>
  <div class="card">
    <p style="margin:0 0 10px">
      O Brasil teve <b>{mviBr.toLocaleString("pt-BR")}</b> mortes violentas intencionais em {(seg as any).ano}, uma
      taxa de <b>{n1(taxaMviBr)} por 100 mil habitantes</b> (Sinesp). Pela contagem da ONU que permite comparar países,
      a taxa de homicídios do Brasil é de <b>{n1(brHom?.valor ?? 0)} por 100 mil</b> ({brHom?.ano}) — a
      {" "}{(indHom.total - (brHom?.posicao ?? 0) + 1)}ª maior entre os {indHom.total} países com dado.
    </p>
    <table>
      <thead><tr><th>País</th><th class="num">Homicídios por 100 mil</th><th class="num">Ano</th></tr></thead>
      <tbody>
        {homLista.map((p) => (p.iso3 === "BRA"
          ? <tr class="destaque"><td><b>Brasil</b></td><td class="num"><b>{n1(p.valor)}</b></td><td class="num">{p.ano}</td></tr>
          : <tr><td>{p.pais}</td><td class="num">{n1(p.valor)}</td><td class="num">{p.ano}</td></tr>))}
      </tbody>
    </table>
    <p class="src">
      A lista junta os cinco países com a maior taxa do mundo e os países de referência desta página, em ordem, com o
      Brasil no lugar dele. Fonte: {indHom.fonte} (<a href={indHom.url}>indicador</a>). O ano muda de país para país porque cada um
      informa à ONU no seu tempo, e isso está em cada linha.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">E comparado com países em guerra?</h3>
    <table>
      <thead><tr><th>Lugar</th><th class="num">Mortes</th><th>Período</th><th class="num">Por 100 mil por ano</th></tr></thead>
      <tbody>
        {conflitos.map((c) => (<tr><td>{c.lugar}</td><td class="num">{c.mortes.toLocaleString("pt-BR")}</td>
          <td class="desc">{c.periodo}</td><td class="num">{n1(c.taxaAno)}</td></tr>))}
        <tr class="destaque"><td><b>Brasil (mortes violentas intencionais)</b></td><td class="num"><b>{mviBr.toLocaleString("pt-BR")}</b></td>
          <td class="desc">ano de {(seg as any).ano}</td><td class="num"><b>{n1(taxaMviBr)}</b></td></tr>
      </tbody>
    </table>
    <p class="src">
      <b>O que cada número inclui — e é aqui que a comparação costuma mentir.</b>
      {conflitos.map((c) => (<><br /><b>{c.lugar}:</b> conta {c.oQueConta}; <b>não</b> conta {c.oQueNaoConta}. Fonte: <a href={c.url}>{c.fonte}</a>, lido em {c.lido}.</>))}
      <br />Por isso a linha da Ucrânia não quer dizer que o Brasil seja "mais perigoso que a guerra": ela conta só
      civis verificados um a um, e deixa de fora os militares, que não têm número oficial. Já a de Gaza mostra a
      diferença real de ordem de grandeza: a taxa por habitante é cerca de {Math.round(conflitos[0].taxaAno / taxaMviBr)} vezes
      a brasileira. A taxa anual é conta nossa (mortes ÷ população ÷ anos do período); a população vem do Banco Mundial.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">Onde nem a ONU tem número</h3>
    <ul class="limites">{SEM_TOTAL_OFICIAL.map((t) => <li>{t}</li>)}</ul>
    <p class="src">Publicar uma estimativa de imprensa ao lado de um dado verificado faria os dois parecerem a mesma coisa. Quando não há contagem oficial, esta página diz que não há.</p>
  </div>

  <Glossario termos={["carga_tributaria", "base_incidencia", "quem_paga", "per_capita", "despesa_paga"]} />
</Base>
