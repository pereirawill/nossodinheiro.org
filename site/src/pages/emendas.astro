---
import Base from "../layouts/Base.astro";
import Termo from "../components/Termo.astro";
import Glossario from "../components/Glossario.astro";
const ANO = 2025;
const mods = import.meta.glob("../../public/data/emendas_*.json", { eager: true, import: "default" });
const porAutor = (mods[`../../public/data/emendas_por_autor_${ANO}.json`] as any[] | undefined) ?? null;

const brl0 = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
const compact = (v: number) =>
  v >= 1e9 ? `R$ ${(v / 1e9).toFixed(2).replace(".", ",")} bi` : v >= 1e6 ? `R$ ${(v / 1e6).toFixed(1).replace(".", ",")} mi` : brl0(v);
const pct = (v: number | null) => (v == null ? "—" : `${Math.round(v * 100)}%`);

const rows = porAutor ?? [];
const individuais = rows.filter((r) => /individual/i.test(r.tipo));
const totEmp = rows.reduce((s, r) => s + r.empenhado, 0);
const totPago = rows.reduce((s, r) => s + r.pago, 0);
const porTipo = Object.values(rows.reduce((acc: Record<string, any>, r) => {
  const k = r.tipo.replace(/ - .*$/, "");
  acc[k] ??= { tipo: k, empenhado: 0, pago: 0, autores: new Set() };
  acc[k].empenhado += r.empenhado; acc[k].pago += r.pago; acc[k].autores.add(r.autor); return acc;
}, {})).sort((a: any, b: any) => b.empenhado - a.empenhado) as any[];
const autoresAgg = Object.values(individuais.reduce((acc: Record<string, any>, r) => {
  acc[r.autor] ??= { autor: r.autor, partido: r.partido, uf: r.uf, casa: r.casa, em_exercicio: r.em_exercicio, match: r.match_deputado, empenhado: 0, pago: 0, emendas: 0 };
  acc[r.autor].empenhado += r.empenhado; acc[r.autor].pago += r.pago; acc[r.autor].emendas += r.emendas; return acc;
}, {})).sort((a: any, b: any) => b.empenhado - a.empenhado) as any[];
const top = autoresAgg.slice(0, 25);
// Composição dos autores: quem está em exercício hoje, quem já deixou o mandato, quem não casou com as listas
const conta = (f: (a: any) => boolean) => autoresAgg.filter(f).length;
const depEx = conta((a) => a.casa === "Câmara" && a.em_exercicio === true);
const senEx = conta((a) => a.casa === "Senado" && a.em_exercicio === true);
const foraMandato = conta((a) => a.casa && a.em_exercicio !== true);
const semId = conta((a) => !a.casa);
const max = Math.max(1, ...top.map((a) => a.empenhado));
---
<Base title="Para onde vai o dinheiro das emendas? — Nosso Dinheiro" description="Quanto cada parlamentar alocou e quanto foi pago em emendas, por autor e por tipo. Fonte: Portal da Transparência." accent="var(--s4)">
  <h1>Para onde vai o dinheiro das emendas?</h1>
  <p class="lede">
    Quanto cada deputado e senador conseguiu alocar em emendas em {ANO} (<Termo t="empenhado"><strong>empenhado</strong></Termo>) e quanto de fato saiu do caixa
    (<Termo t="pago"><strong>pago</strong></Termo>) — por autor e por tipo de emenda.
  </p>
  <p class="meta">fonte: API de Dados do Portal da Transparência (CGU) · emendas individuais, de bancada e de comissão · valores do exercício {ANO}</p>

  <div class="disclaimer"><span aria-hidden="true">ⓘ</span>
    <div><b>Emenda não é custo do deputado.</b> É orçamento público que ele direciona. Por isso este painel é separado do
    <a href="/deputados/">custo por deputado</a> e nunca é somado a ele. Só <Termo t="emenda_individual">emendas <em>individuais</em></Termo> têm autor único;
    <Termo t="emenda_bancada">de bancada</Termo> e <Termo t="emenda_comissao">de comissão</Termo> são coletivas. Senadores também têm emenda individual, com cota maior — por isso lideram a lista.</div>
  </div>

  {porAutor ? (
    <>
      <div class="hero">
        <div class="stat big"><b>{compact(totEmp)}</b><span><Termo t="empenhado">empenhado</Termo> em emendas em {ANO}</span></div>
        <div class="stat"><b>{compact(totPago)}</b><span><Termo t="pago">pago</Termo> no exercício ({pct(totEmp ? totPago / totEmp : null)} do empenhado)</span></div>
        <div class="stat"><b>{autoresAgg.length}</b><span>autores de <Termo t="emenda_individual">emendas individuais</Termo>: {depEx} deputados e {senEx} senadores em exercício, {foraMandato} que deixaram o mandato ou estão licenciados{semId ? ` e ${semId} não identificados` : ""}</span></div>
      </div>

      <h2>Por tipo de emenda</h2>
      <table>
        <thead><tr><th>Tipo</th><th class="num">Autores</th><th class="num"><Termo t="empenhado" /></th><th class="num"><Termo t="pago" /></th><th class="num">% pago</th></tr></thead>
        <tbody>{porTipo.map((t) => (
          <tr><td>{/bancada/i.test(t.tipo) ? <Termo t="emenda_bancada">{t.tipo}</Termo> : /comiss/i.test(t.tipo) ? <Termo t="emenda_comissao">{t.tipo}</Termo> : /relator/i.test(t.tipo) ? <Termo t="emenda_relator">{t.tipo}</Termo> : /individual/i.test(t.tipo) ? <Termo t="emenda_individual">{t.tipo}</Termo> : t.tipo}</td><td class="num">{t.autores.size}</td><td class="num">{brl0(t.empenhado)}</td><td class="num">{brl0(t.pago)}</td><td class="num">{pct(t.empenhado ? t.pago / t.empenhado : null)}</td></tr>
        ))}</tbody>
      </table>

      <h2>Os 25 autores com mais emendas individuais empenhadas</h2>
      <div class="card">
        <div class="legend"><span><i style="background:var(--s1)"></i><Termo t="pago" /></span><span><i style="background:var(--neutro)"></i><Termo t="empenhado">Empenhado e ainda não pago</Termo></span></div>
        <svg viewBox={`0 0 920 ${top.length * 28 + 10}`} width="100%" role="img" aria-label="Emendas por autor">
          {top.map((a, i) => (
            <g transform={`translate(0 ${i * 28 + 5})`}>
              <text x="292" y="17" text-anchor="end" font-size="12" fill="var(--ink)">{a.autor} <tspan fill="var(--ink-2)">{a.partido ? `(${a.partido}-${a.uf}${a.casa === "Senado" ? ", sen." : ""})` : ""}</tspan></text>
              <rect x="300" y="4" width={Math.max(2, (a.empenhado / max) * 480)} height="18" rx="2" fill="var(--neutro)" />
              <rect x="300" y="4" width={Math.max(0, (a.pago / max) * 480)} height="18" rx="2" fill="var(--s1)" />
              <text x={306 + (a.empenhado / max) * 480} y="17" font-size="11" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{compact(a.empenhado)}</text>
            </g>
          ))}
        </svg>
        <p class="src">Partido/UF vêm do cruzamento por nome com as listas oficiais de deputados e senadores da legislatura (inclusive quem já saiu); "sen." = senador. Nomes que não casam com nenhuma lista aparecem sem sigla.</p>
      </div>

      <h2>Todos os autores (individuais)</h2>
      <table>
        <thead><tr><th>#</th><th>Autor</th><th>Casa · situação</th><th>Partido · UF</th><th class="num">Emendas</th><th class="num"><Termo t="empenhado" /></th><th class="num"><Termo t="pago" /></th><th class="num">% pago</th></tr></thead>
        <tbody>{autoresAgg.map((a, i) => (
          <tr><td class="rank">{i + 1}</td><td>{a.autor}</td><td>{a.casa ? `${a.casa}${a.em_exercicio === true ? "" : " · fora do mandato"}` : "—"}</td><td>{a.partido ? `${a.partido} · ${a.uf}` : "—"}</td><td class="num">{a.emendas}</td>
              <td class="num">{brl0(a.empenhado)}</td><td class="num">{brl0(a.pago)}</td><td class="num">{pct(a.empenhado ? a.pago / a.empenhado : null)}</td></tr>
        ))}</tbody>
      </table>
      <Glossario termos={["emenda_individual", "emenda_bancada", "emenda_comissao", "emenda_relator", "empenhado", "liquidado", "pago", "restos_a_pagar", "alocou"]} />
    </>
  ) : (
    <div class="card">
      <h2 style="margin-top:0">Em construção — primeira carga pendente</h2>
      <p>O ETL (<code>etl/portal_transparencia/extract_emendas.py</code>) já está pronto; os dados aparecem aqui após a primeira execução agendada.</p>
    </div>
  )}
</Base>
