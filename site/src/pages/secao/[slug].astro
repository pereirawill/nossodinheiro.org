---
// Página de seção: lista os painéis do grupo com uma linha sobre cada um. Serve de porta de entrada
// (o cabeçalho leva para cá) e dá ao leitor novo uma ideia do que existe sem precisar ler 30 itens de menu.
import Base from "../../layouts/Base.astro";
import { GRUPOS } from "../../lib/menu";

export function getStaticPaths() {
  return GRUPOS.map((g) => ({ params: { slug: g.slug }, props: { grupo: g } }));
}
const { grupo } = Astro.props;
const outros = GRUPOS.filter((g) => g.slug !== grupo.slug);
---
<Base title={`${grupo.nome} — Nosso Dinheiro`} description={grupo.chamada}>
  <h1>{grupo.nome}</h1>
  <p class="lede">{grupo.chamada}</p>
  <div class="grade">
    {grupo.itens.map((i) => (
      <a class="card tile" href={i.href}><b>{i.label}</b><span>{i.nota}</span></a>))}
  </div>

  <h2>As outras seções</h2>
  <div class="card">
    <ul class="secoes">
      {outros.map((g) => (
        <li><a href={`/secao/${g.slug}/`}><b>{g.nome}</b></a> — {g.chamada}{" "}
          <span class="itens">({g.itens.map((i) => i.label).join(" · ")})</span></li>))}
    </ul>
  </div>
</Base>
<style>
  .secoes { margin: 0; padding-left: 18px; font-size: 14px; }
  .secoes li { margin: 8px 0; }
  .secoes .itens { color: var(--ink-2); font-size: 13px; }
</style>
