---
import Base from "../../layouts/Base.astro";
import Termo from "../../components/Termo.astro";
import Glossario from "../../components/Glossario.astro";
import MapaBrasil from "../../components/MapaBrasil.astro";
import d from "../../../public/data/credito.json";
import { FONTE_REF, CRITERIOS, SERIE_RISCO, RISCO, TOMADORES_POR_FAIXA, ACHADOS } from "../../lib/endividamento";

const tri = (v: number) => `R$ ${(v / 1e12).toFixed(2).replace(".", ",")} tri`;
const bi = (v: number) => v >= 1e12 ? tri(v) : `R$ ${(v / 1e9).toFixed(v >= 1e11 ? 0 : 1).replace(".", ",")} bi`;
const pct = (v: number | null | undefined) => v == null ? "—" : `${v.toFixed(2).replace(".", ",")}%`;
const quando = new Date(d.gerado_em_utc);
const fmt = new Intl.DateTimeFormat("pt-BR", { timeZone: "America/Sao_Paulo", day: "2-digit", month: "2-digit", year: "numeric" });
const [ano, mes] = d.referencia.split("-");
const MESES = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];
const ref = `${MESES[+mes - 1]}/${ano}`;
const pf = d.brasil.PF, pj = d.brasil.PJ;
const ufs = [...d.por_uf].sort((a, b) => (b.pct_pf ?? 0) - (a.pct_pf ?? 0));
const modPF = d.modalidades.filter((m) => m.cliente === "PF" && m.carteira > 1e9).map((m) => ({ ...m, modalidade: m.modalidade.replace(/\s*\(ex-.*\)/, "") }));
const modPJ = d.modalidades.filter((m) => m.cliente === "PJ" && m.carteira > 1e9).map((m) => ({ ...m, modalidade: m.modalidade.replace(/\s*\(ex-.*\)/, "") }));
const ORDEM = ["Sem rendimento", "Até 1 salário mínimo", "Mais de 1 a 2 salários mínimos", "Mais de 2 a 3 salários mínimos", "Mais de 3 a 5 salários mínimos", "Mais de 5 a 10 salários mínimos", "Mais de 10 a 20 salários mínimos", "Acima de 20 salários mínimos", "Indisponível"];
const portePF = d.porte.filter((p) => p.cliente === "PF").sort((a, b) => ORDEM.indexOf(a.porte) - ORDEM.indexOf(b.porte));
const portePJ = d.porte.filter((p) => p.cliente === "PJ").sort((a, b) => b.carteira - a.carteira);
const ocupacoes = [...(d.ocupacao ?? [])].sort((a, b) => (b.pct ?? 0) - (a.pct ?? 0));
const W = 920;
const maxUf = Math.max(...ufs.map((u) => u.pct_pf ?? 0));
// série
const SW = 920, SH = 200, padL = 48, padB = 24;
const maxS = Math.max(...d.serie.map((s) => Math.max(s.pct_pf ?? 0, s.pct_pj ?? 0))) * 1.1;
const sx = (i: number) => padL + (i * (SW - padL - 10)) / Math.max(1, d.serie.length - 1);
const sy = (v: number) => 8 + (SH - padB - 8) * (1 - v / maxS);
// endividamento de risco (REF do BC) e as duas séries agregadas do SGS
const mi = (v: number) => `${(v / 1e6).toFixed(1).replace(".", ",")} milhões`;
const n1 = (v: number) => v.toLocaleString("pt-BR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const riscoIni = SERIE_RISCO[0], riscoFim = SERIE_RISCO[SERIE_RISCO.length - 1];
const RW = 920, RH = 210, rPadL = 40, rPadB = 30;
const maxR = Math.max(...SERIE_RISCO.map((x) => x.pct)) * 1.18;
const rPasso = (RW - rPadL - 12) / SERIE_RISCO.length;
const ry = (v: number) => 12 + (RH - rPadB - 12) * (1 - v / maxR);

const fam = (d as any).familias ?? {};
const compr = fam.comprometimento?.pontos ?? {};
const endiv = fam.endividamento?.pontos ?? {};
const mesesFam = Object.keys(compr).filter((m) => m in endiv).sort();
const ultFam = mesesFam[mesesFam.length - 1];
const FW = 920, FH = 220, fPadL = 40, fPadB = 26;
const maxF = Math.max(...mesesFam.map((m) => endiv[m])) * 1.12;
const fx = (i: number) => fPadL + (i * (FW - fPadL - 12)) / Math.max(1, mesesFam.length - 1);
const fy = (v: number) => 10 + (FH - fPadB - 10) * (1 - v / maxF);
const caminhoFam = (pontos: Record<string, number>) =>
  mesesFam.map((m, i) => `${i ? "L" : "M"}${fx(i).toFixed(1)} ${fy(pontos[m]).toFixed(1)}`).join(" ");
const mesLongo = (m: string) => `${MESES[+m.slice(5) - 1]}/${m.slice(0, 4)}`;
const anosFam = [2008, 2012, 2016, 2020, 2024];

const rotulo = (m: string) => `${MESES[+m.slice(5) - 1]}/${m.slice(2, 4)}`;
---
<Base title="Inadimplência por estado — Nosso Dinheiro" accent="var(--s4)" description="Quanto do crédito a pessoas e empresas está atrasado há mais de 90 dias, por estado, tipo de crédito e faixa de renda. Banco Central, SCR.data.">
  <h1>Quanto do crédito está em atraso, em cada estado</h1>
  <p class="lede">
    De todo o dinheiro que bancos, cooperativas e financeiras emprestaram a pessoas e empresas, quanto está com parcelas vencidas há
    mais de 90 dias. Por estado, por tipo de crédito (cartão, consignado, imobiliário, rural…) e por faixa de renda do tomador.
    Fonte: o cadastro de crédito do Banco Central (SCR), em dados abertos.
  </p>
  <p class="meta">atualizado em {fmt.format(quando)} · Banco Central do Brasil, SCR.data, posição de {ref} · <a href="/metodologia/">metodologia</a></p>

  <div class="hero">
    <div class="stat big"><b>{pct(pf.pct)}</b><span><Termo t="inadimplencia_scr">inadimplência</Termo> das pessoas físicas em {ref}: {bi(pf.inadimplencia)} em atraso de uma <Termo t="carteira_ativa">carteira</Termo> de {tri(pf.carteira)}</span></div>
    <div class="stat"><b>{pct(pj.pct)}</b><span>inadimplência das empresas: {bi(pj.inadimplencia)} em atraso de {tri(pj.carteira)} emprestados</span></div>
    <div class="stat"><b>{tri(pf.carteira + pj.carteira)}</b><span>crédito total ativo no país; pessoas físicas devem {Math.round(100 * pf.carteira / (pf.carteira + pj.carteira))}% desse valor</span></div>
  </div>

  <div class="disclaimer"><span aria-hidden="true">ⓘ</span>
    <div><b>É inadimplência em reais, não em pessoas.</b> O Banco Central conta quanto do dinheiro emprestado está atrasado há mais de 90
    dias, não quantas pessoas estão com o nome sujo (isso é dado de birôs privados, que não usamos). Um estado com muito crédito
    imobiliário (quase sempre em dia) tende a ter taxa menor. O menor recorte que o BC publica é o estado: <b>não há dado oficial por
    município</b>.</div>
  </div>


  <h2>Quem está sufocado, e não só atrasado</h2>
  <div class="card">
    <div class="hero" style="margin-top:0">
      <div class="stat big"><b>{mi(RISCO.pessoas)}</b><span>de pessoas em <Termo t="endividamento_risco">endividamento de risco</Termo> em {RISCO.referencia} — {RISCO.pct_devedores}% de quem deve ao sistema financeiro</span></div>
      <div class="stat"><b>+{RISCO.variacao_5_anos}%</b><span>em cinco anos: eram {n1(riscoIni.pct)}% dos devedores em {riscoIni.periodo} e são {n1(riscoFim.pct)}% em {riscoFim.periodo}</span></div>
      <div class="stat"><b>{pct(pf.pct)}</b><span>é a nossa medida ao lado: o crédito em atraso. Quem está sufocado pode estar em dia — são contas diferentes</span></div>
    </div>
    <svg viewBox={`0 0 ${RW} ${RH}`} width="100%" role="img" aria-label="Percentual dos devedores do sistema financeiro em endividamento de risco, de seis em seis meses">
      {[5, 10, 15].map((v) => (<g><line x1={rPadL} x2={RW - 12} y1={ry(v)} y2={ry(v)} stroke="var(--line)" /><text x={rPadL - 6} y={ry(v) + 4} text-anchor="end" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{v}%</text></g>))}
      {SERIE_RISCO.map((x, i) => (<g>
        <rect x={rPadL + i * rPasso + 3} y={ry(x.pct)} width={rPasso - 6} height={ry(0) - ry(x.pct)} fill={i === SERIE_RISCO.length - 1 ? "#a3302a" : "var(--s4)"} opacity={i === SERIE_RISCO.length - 1 ? 1 : 0.8}>
          <title>{x.periodo}: {n1(x.pct)}% dos devedores</title></rect>
        <text x={rPadL + i * rPasso + rPasso / 2} y={ry(x.pct) - 5} text-anchor="middle" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{n1(x.pct)}</text>
        <text x={rPadL + i * rPasso + rPasso / 2} y={RH - 10} text-anchor="middle" font-size="9.5" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{x.periodo}</text>
      </g>))}
    </svg>
    <p class="src">
      <b>Por que isto não é a mesma coisa que a inadimplência desta página.</b> O número de cima é de pessoas e é
      calculado pelo Banco Central dentro do SCR, com a renda de cada tomador — informação que o BC tem e não
      publica aberta. O resto da página é de reais em atraso, que é o que está nos arquivos públicos. As duas
      medidas apontam para o mesmo lado, mas não se somam nem se substituem.
      Fonte: {FONTE_REF.nome}, {FONTE_REF.edicao}, p. {RISCO.pagina} (lido em {FONTE_REF.lido}).
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">Os quatro sinais que o Banco Central conta</h3>
    <p class="explica" style="margin:0 0 10px">
      É endividado de risco quem atende a <b>dois ou mais</b> destes critérios. Todos são objetivos, tirados do
      cadastro de crédito — ninguém é entrevistado, nem se declara endividado:
    </p>
    <ol class="criterios">
      {CRITERIOS.map((c) => (<li><b>{c.titulo}.</b> {c.detalhe}</li>))}
    </ol>
    <p class="src">
      Definição da nota 70, p. 72 do relatório, que remete ao estudo <i>Endividamento de Risco no Brasil</i> (BC, 2023).
      Repare no desenho: <b>atraso é só um dos quatro sinais</b> — dá para entrar na conta sem nunca ter deixado de
      pagar, bastando comprometer mais da metade da renda e usar as três modalidades caras ao mesmo tempo.
    </p>
  </div>

  <h2>O peso da dívida em todas as famílias</h2>
  <div class="card">
    <div class="legend"><span><i style="background:var(--s4)"></i>Dívida total ÷ renda de um ano</span><span><i style="background:var(--s1)"></i>Pagamento do mês ÷ renda do mês</span></div>
    <svg viewBox={`0 0 ${FW} ${FH}`} width="100%" role="img" aria-label="Endividamento e comprometimento de renda das famílias brasileiras, desde 2005">
      {[10, 20, 30, 40, 50].map((v) => (<g><line x1={fPadL} x2={FW - 12} y1={fy(v)} y2={fy(v)} stroke="var(--line)" /><text x={fPadL - 6} y={fy(v) + 4} text-anchor="end" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{v}%</text></g>))}
      {anosFam.map((a) => { const i = mesesFam.indexOf(`${a}-01`); return i >= 0 && <text x={fx(i)} y={FH - 8} text-anchor="middle" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{a}</text>; })}
      <path d={caminhoFam(endiv)} fill="none" stroke="var(--s4)" stroke-width="2.5" />
      <path d={caminhoFam(compr)} fill="none" stroke="var(--s1)" stroke-width="2.5" />
    </svg>
    <p class="src">
      Em {mesLongo(ultFam)}, a dívida das famílias brasileiras equivale a <b>{n1(endiv[ultFam])}% da renda de um ano</b>
      e o pagamento mensal consome <b>{n1(compr[ultFam])}% da renda do mês</b> —
      <Termo t="comprometimento_renda">comprometimento de renda</Termo>. As duas são o
      <b> maior nível de toda a série</b>, que começa em {mesLongo(mesesFam[0])}, quando eram {n1(endiv[mesesFam[0]])}% e
      {" "}{n1(compr[mesesFam[0]])}%. São médias do país inteiro: contam quem tem financiamento imobiliário em dia do
      mesmo jeito que contam quem só tem rotativo de cartão. Fonte: Banco Central, SGS séries 29037 e 29034 — as mesmas
      que o relatório usa.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">Quem deve, por faixa de renda</h3>
    <table>
      <thead><tr><th>Faixa de renda</th><th class="num">Tomadores de crédito</th><th class="num">% do total</th></tr></thead>
      <tbody>{TOMADORES_POR_FAIXA.map((f) => (<tr><td>{f.faixa}</td><td class="num">{n1(f.milhoes)} mi</td>
        <td class="num">{n1(100 * f.milhoes / TOMADORES_POR_FAIXA.reduce((s, x) => s + x.milhoes, 0))}%</td></tr>))}</tbody>
    </table>
    <p class="src">
      Quem toma crédito no Brasil é, em grande maioria, quem ganha pouco:
      {" "}{n1(100 * TOMADORES_POR_FAIXA[0].milhoes / TOMADORES_POR_FAIXA.reduce((s, x) => s + x.milhoes, 0))}% dos
      tomadores ganham até dois salários mínimos. <b>Este universo é diferente</b> do dos {mi(RISCO.pessoas)} acima:
      aqui entram só os tomadores com renda conhecida e carteira acima de R$ 200, que é o recorte do cálculo de
      comprometimento de renda — por isso a soma não bate com o total de devedores do sistema. Boxe 3, p. 37–38.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">O que o relatório diz, nas palavras dele</h3>
    <ul class="citacoes">
      {ACHADOS.map((a) => (<li>“{a.texto}” <span class="pg">p. {a.pagina}</span></li>))}
    </ul>
    <p class="src">
      Citações do próprio relatório, com a página, porque aqui a análise é do Banco Central e não nossa. O documento
      inteiro está em <a href={FONTE_REF.url}>{FONTE_REF.nome}</a>. Este site não escreve se o crédito deveria ser mais
      caro, mais barato ou mais restrito.
    </p>
  </div>

  <h2>Por estado: pessoas físicas e empresas ({ref})</h2>
  <div class="card">
    <MapaBrasil valores={Object.fromEntries(d.por_uf.map((u) => [u.uf, u.pct_pf]))} formato={(v) => pct(v)}
      titulo={`Inadimplência das pessoas físicas em cada estado, ${ref}`} legenda="do crédito a pessoas físicas vencido há mais de 90 dias" melhorMenor={true} />
  </div>
  <div class="card" style="margin-top:14px">
    <svg viewBox={`0 0 ${W} ${ufs.length * 22 + 10}`} width="100%" role="img" aria-label="Inadimplência de pessoas físicas por estado">
      {ufs.map((u, i) => (<g transform={`translate(0 ${i * 22 + 5})`}>
        <text x="150" y="14" text-anchor="end" font-size="12" fill="var(--ink)">{u.nome}</text>
        <rect x="160" y="2" width={Math.max(1, ((u.pct_pf ?? 0) / maxUf) * 560)} height="16" fill="var(--s4)" rx="2" />
        <rect x="160" y="2" width={Math.max(1, ((u.pct_pj ?? 0) / maxUf) * 560)} height="16" fill="var(--s1)" rx="2" opacity=".55" />
        <text x={166 + ((u.pct_pf ?? 0) / maxUf) * 560} y="14" font-size="11.5" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{pct(u.pct_pf)} PF · {pct(u.pct_pj)} PJ</text>
      </g>))}
    </svg>
    <div class="legend"><span><i style="background:var(--s4)"></i>Pessoas físicas</span><span><i style="background:var(--s1);opacity:.55"></i>Empresas (PJ)</span></div>
    <table style="margin-top:12px">
      <thead><tr><th>Estado</th><th class="num">Crédito a pessoas</th><th class="num">Inadimplência PF</th><th class="num">Crédito a empresas</th><th class="num">Inadimplência PJ</th></tr></thead>
      <tbody>{ufs.map((u) => (<tr><td>{u.nome}</td><td class="num">{bi(u.carteira_pf)}</td><td class="num">{pct(u.pct_pf)}</td><td class="num">{bi(u.carteira_pj)}</td><td class="num">{pct(u.pct_pj)}</td></tr>))}</tbody>
    </table>
    <p class="src">Fonte: Banco Central, SCR.data, {ref}. UF = endereço do tomador no cadastro do banco. Clique no cabeçalho para ordenar.</p>
  </div>

  <h2>Por tipo de crédito ({ref})</h2>
  <div class="card duas">
    <div>
      <h3>Pessoas físicas</h3>
      <table><thead><tr><th><Termo t="modalidade_credito">Modalidade</Termo></th><th class="num">Carteira</th><th class="num">Inadimplência</th></tr></thead>
        <tbody>{modPF.map((m) => (<tr><td>{m.modalidade}</td><td class="num">{bi(m.carteira)}</td><td class="num">{pct(m.pct)}</td></tr>))}</tbody></table>
    </div>
    <div>
      <h3>Empresas</h3>
      <table><thead><tr><th>Modalidade</th><th class="num">Carteira</th><th class="num">Inadimplência</th></tr></thead>
        <tbody>{modPJ.map((m) => (<tr><td>{m.modalidade}</td><td class="num">{bi(m.carteira)}</td><td class="num">{pct(m.pct)}</td></tr>))}</tbody></table>
    </div>
    <p class="src" style="grid-column:1/-1">"Empréstimos" reúne cartão de crédito, crédito pessoal e consignado; "Financiamentos", sobretudo veículos. Modalidades com menos de R$ 1 bi omitidas.</p>
  </div>

  <h2>Por faixa de renda do tomador (pessoas físicas, {ref})</h2>
  <div class="card duas">
    <div>
      <table><thead><tr><th>Renda declarada ao banco</th><th class="num">Carteira</th><th class="num">Inadimplência</th></tr></thead>
        <tbody>{portePF.map((p) => (<tr><td>{p.porte}</td><td class="num">{bi(p.carteira)}</td><td class="num">{pct(p.pct)}</td></tr>))}</tbody></table>
    </div>
    <div>
      <h3>Empresas, por porte</h3>
      <table><thead><tr><th>Porte</th><th class="num">Carteira</th><th class="num">Inadimplência</th></tr></thead>
        <tbody>{portePJ.map((p) => (<tr><td>{p.porte}</td><td class="num">{bi(p.carteira)}</td><td class="num">{pct(p.pct)}</td></tr>))}</tbody></table>
    </div>
    <p class="src" style="grid-column:1/-1">Faixa de renda é a informada pelo tomador à instituição (campo "porte" do SCR); "Indisponível" = instituição não informou.</p>
  </div>

  <h2>Por ocupação de quem tomou o crédito (pessoas físicas, {ref})</h2>
  <div class="card">
    <table>
      <thead><tr><th>Ocupação informada ao banco</th><th class="num">Carteira</th><th class="num">Inadimplência</th></tr></thead>
      <tbody>{ocupacoes.map((o) => (<tr><td>{o.ocupacao}</td><td class="num">{bi(o.carteira)}</td><td class="num"><b>{pct(o.pct)}</b></td></tr>))}</tbody>
    </table>
    <p class="src">
      <b>Não há recorte por idade.</b> O Banco Central não publica a inadimplência por faixa etária; o mais próximo é a ocupação
      declarada pelo tomador, que inclui "aposentado/pensionista" — o grupo com acesso ao crédito consignado, de juro menor e
      desconto em folha, o que ajuda a explicar a inadimplência mais baixa. "Outros" reúne quem não se encaixa nas categorias do
      cadastro. Fonte: Banco Central, SCR.data, {ref}.
    </p>
  </div>

  <h2>Evolução mensal</h2>
  <div class="card">
    <svg viewBox={`0 0 ${SW} ${SH}`} width="100%" role="img" aria-label="Inadimplência mensal PF e PJ">
      {[2, 4, 6, 8].filter((p) => p < maxS).map((p) => (<g><line x1={padL} x2={SW - 10} y1={sy(p)} y2={sy(p)} stroke="var(--line)" /><text x={padL - 6} y={sy(p) + 4} text-anchor="end" font-size="11" fill="var(--ink-2)">{p}%</text></g>))}
      <polyline points={d.serie.map((s, i) => `${sx(i).toFixed(1)},${sy(s.pct_pf ?? 0).toFixed(1)}`).join(" ")} fill="none" stroke="var(--s4)" stroke-width="2.5" />
      <polyline points={d.serie.map((s, i) => `${sx(i).toFixed(1)},${sy(s.pct_pj ?? 0).toFixed(1)}`).join(" ")} fill="none" stroke="var(--s1)" stroke-width="2.5" />
      {d.serie.map((s, i) => (i % Math.ceil(d.serie.length / 12) === 0 || i === d.serie.length - 1) && <text x={sx(i)} y={SH - 6} text-anchor={i === d.serie.length - 1 ? "end" : "middle"} font-size="11" fill="var(--ink-2)">{rotulo(s.mes)}</text>)}
    </svg>
    <div class="legend"><span><i style="background:var(--s4)"></i>Pessoas físicas: {pct(d.serie[0].pct_pf)} → {pct(pf.pct)}</span><span><i style="background:var(--s1)"></i>Empresas: {pct(d.serie[0].pct_pj)} → {pct(pj.pct)}</span></div>
    <p class="src">Série dos arquivos anuais do SCR.data disponíveis ({d.serie[0].mes} a {d.referencia}). Séries mais longas: Banco Central, SGS.</p>
  </div>

  <Glossario termos={["endividamento_risco", "comprometimento_renda", "inadimplencia_scr", "carteira_ativa", "modalidade_credito"]} />
</Base>
<style>
  ol.criterios { margin: 0; padding-left: 20px; } ol.criterios li { margin: 6px 0; }
  ul.citacoes { margin: 0; padding-left: 18px; list-style: none; }
  ul.citacoes li { margin: 8px 0; padding-left: 10px; border-left: 3px solid var(--line); color: var(--ink-2); }
  ul.citacoes .pg { font-family: IBM Plex Mono, monospace; font-size: 11.5px; white-space: nowrap; }
  td.num { white-space: nowrap; }       /* th quebra linha no celular (Base.astro) */
  .duas { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; } .duas h3 { margin: 0 0 8px; font-size: 15px; }
  @media (max-width: 720px) { .duas { grid-template-columns: 1fr; } }
</style>
