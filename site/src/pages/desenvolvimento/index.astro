---
import Base from "../../layouts/Base.astro";
import Termo from "../../components/Termo.astro";
import Glossario from "../../components/Glossario.astro";
import rankings from "../../../public/data/rankings.json";
import educacao from "../../../public/data/educacao.json";
import saneamento from "../../../public/data/saneamento.json";
import uf from "../../../public/data/desenvolvimento.json";
import despesaEstados from "../../../public/data/estados_2025.json";
import obras from "../../../public/data/obras.json";
import { JUDICIARIO_BR } from "../../lib/comparacao";
import MapaBrasil from "../../components/MapaBrasil.astro";
import ind from "../../../public/data/industria.json";

const n1 = (v: number) => v.toLocaleString("pt-BR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const brl0 = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
const compact = (v: number) => Math.abs(v) >= 1e9 ? `R$ ${n1(v / 1e9)} bi` : `R$ ${Math.round(v / 1e6)} mi`;
const n0 = (v: number) => Math.round(v).toLocaleString("pt-BR");
const pct = (v: number) => `${n1(v)}%`;
const sinal = (v: number) => `${v > 0 ? "+" : "−"}${n1(Math.abs(v))}`;

const indices = rankings.indices as any[];
const idx = (id: string) => indices.find((i) => i.id === id);

// Para cada indicador: onde começou, onde está, e como mudou a posição do Brasil no mundo. A posição bruta não
// serve para comparar épocas (o número de países muda), então usamos o percentil: quantos por cento dos países
// estão à frente do Brasil naquele ano.
const ESCOLHIDOS = [
  "mortalidade_infantil", "expectativa_vida", "medio_completo_pct", "internet_pct", "eletricidade_pct",
  "gini", "pib_per_capita_ppp", "produtividade", "investimento_pct_pib", "comercio_pct_pib", "idh", "corrupcao",
];
// Quanto o mundo melhorou no mesmo período: sem isso, uma melhora de 40 anos parece conquista quando pode ser a
// maré geral. Os grupos são os que o próprio Banco Mundial publica. (Pedido do dono em 29/10/2026.)
const agr = (rankings as any).agregados ?? { grupos: {}, indicadores: {} };
const GRUPOS_MOSTRA = ["WLD", "LCN", "HIC"];
const noAno = (serie: any[], ano: number) => {
  if (!serie?.length) return null;
  return serie.reduce((m, p) => (Math.abs(p.ano - ano) < Math.abs(m.ano - ano) ? p : m), serie[0]);
};
const variacaoGrupo = (id: string, grupo: string, de: number, ate: number) => {
  const serie = (agr.indicadores?.[id] ?? {})[grupo];
  const a = noAno(serie, de), b = noAno(serie, ate);
  if (!a || !b || !a.valor || a.ano === b.ano) return null;
  return { pct: ((b.valor - a.valor) / Math.abs(a.valor)) * 100, de: a.ano, ate: b.ano, vDe: a.valor, vAte: b.valor };
};

const linhas = ESCOLHIDOS.map((id) => {
  const i = idx(id);
  if (!i || !(i.serie || []).length) return null;
  const s = i.serie as any[];
  const a = s[0], b = s[s.length - 1];
  const dezAnos = s.find((x) => x.ano >= b.ano - 10) ?? a;
  const variacao = a.valor ? ((b.valor - a.valor) / Math.abs(a.valor)) * 100 : 0;
  const var10 = dezAnos.valor ? ((b.valor - dezAnos.valor) / Math.abs(dezAnos.valor)) * 100 : 0;
  // percentil dentro do MESMO grupo de países (os que têm dado no primeiro e no último ano): é o único que
  // compara épocas. O percentil solto cresce ou encolhe só porque a lista de países muda.
  const pctl = (x: any) => (x.posicao_fixa && x.total_fixo ? (x.posicao_fixa / x.total_fixo) * 100 : null);
  const pctlSolto = (x: any) => (x.posicao && x.total ? (x.posicao / x.total) * 100 : null);
  // "melhorou" é o dado que decide, não nós: depende de o indicador ser melhor quando sobe ou quando desce
  const melhorou = i.maior_melhor ? variacao > 0 : variacao < 0;
  const melhorou10 = i.maior_melhor ? var10 > 0 : var10 < 0;
  const mundo = Object.fromEntries(GRUPOS_MOSTRA.map((g) => [g, variacaoGrupo(id, g, a.ano, b.ano)]));
  return { ...i, a, b, variacao, var10, melhorou, melhorou10, pctlDe: pctl(a), pctlPara: pctl(b),
           soltoDe: pctlSolto(a), soltoPara: pctlSolto(b), serie: s, mundo };
}).filter(Boolean) as any[];

const melhoraram = linhas.filter((l) => l.melhorou).sort((a, b) => Math.abs(b.variacao) - Math.abs(a.variacao));
const pioraram = linhas.filter((l) => !l.melhorou).sort((a, b) => Math.abs(b.variacao) - Math.abs(a.variacao));
const perderamPosicao = linhas.filter((l) => l.pctlDe != null && l.pctlPara != null && l.pctlPara > l.pctlDe)
  .sort((a, b) => (b.pctlPara - b.pctlDe) - (a.pctlPara - a.pctlDe));

const mortInf = idx("mortalidade_infantil"), prod = idx("produtividade"), inv = idx("investimento_pct_pib");
const idh = idx("idh"), pibpc = idx("pib_per_capita_ppp");
const prodVar = prod ? ((prod.serie[prod.serie.length - 1].valor / prod.serie[0].valor) - 1) * 100 : 0;
const anosProd = prod ? prod.serie[prod.serie.length - 1].ano - prod.serie[0].ano : 0;

// nossos próprios painéis, que medem a mesma coisa por dentro
const escLongo = (educacao as any).escolaridade.longo;
const semFund91 = escLongo?.censos?.[0]?.ate_fundamental_incompleto;
const semFundHoje = escLongo?.pnadc?.[escLongo.pnadc.length - 1]?.ate_fundamental_incompleto;
const esgoto91 = (saneamento as any).censo["1991"].esgoto.pct;
const esgoto22 = (saneamento as any).censo["2022"].esgoto.pct;

// Gráfico de trajetória: onde o Brasil estava no primeiro ano da série e onde está hoje, em percentil.
// Uma linha por indicador, com a seta apontando o sentido — responde "subiu ou caiu" sem precisar ler tabela.
const TW = 920, TL = 250, TR = 120;
const trajeto = linhas.filter((l) => l.pctlDe != null && l.pctlPara != null)
  .map((l) => ({ ...l, delta: (l.pctlPara as number) - (l.pctlDe as number) }))
  .sort((a, b) => a.delta - b.delta);
const tx = (p: number) => TL + (p / 100) * (TW - TL - TR);
const anoMaisAntigo = Math.min(...trajeto.map((l) => l.a.ano));

// ── Por estado: quem mudou mais, e desde quando dá para medir ────────────────────────────────────────────────────
const edu = (uf as any).educacao, hom = (uf as any).homicidios;
const eduDe = edu.anos[0], eduPara = edu.anos[edu.anos.length - 1];
const homDe = hom.anos?.[0], homPara = hom.anos?.[hom.anos.length - 1];
const sanUf = (saneamento as any).censo_uf as Record<string, any[]>;
const sanDe = "1991", sanPara = "2022";
const mapaSan = (ano: string) => Object.fromEntries((sanUf[ano] ?? []).map((x: any) => [x.uf, x.esgoto]));
const sanA = mapaSan(sanDe), sanB = mapaSan(sanPara);

const estados = Object.keys(edu.por_uf[eduPara] ?? {}).sort();
const porEstado = estados.map((u) => {
  const eduVar = edu.por_uf[eduPara][u] - (edu.por_uf[eduDe]?.[u] ?? 0);
  const sanVar = sanB[u] != null && sanA[u] != null ? sanB[u] - sanA[u] : null;
  const homVar = hom.por_uf?.[homPara]?.[u] != null && hom.por_uf?.[homDe]?.[u] != null
    ? hom.por_uf[homPara][u] - hom.por_uf[homDe][u] : null;
  return { uf: u, eduDe: edu.por_uf[eduDe]?.[u], eduPara: edu.por_uf[eduPara][u], eduVar,
           sanDe: sanA[u], sanPara: sanB[u], sanVar,
           homDe: hom.por_uf?.[homDe]?.[u], homPara: hom.por_uf?.[homPara]?.[u], homVar };
});
const nomeUf = Object.fromEntries((sanUf[sanPara] ?? []).map((x: any) => [x.uf, x.nome]));
const topEdu = [...porEstado].sort((a, b) => b.eduVar - a.eduVar);
const topHom = porEstado.filter((e) => e.homVar != null).sort((a, b) => (a.homVar as number) - (b.homVar as number));
const topSan = porEstado.filter((e) => e.sanVar != null).sort((a, b) => (b.sanVar as number) - (a.sanVar as number));

// ── Quanto custa e o que entrega ─────────────────────────────────────────────────────────────────────────────────
// Não é nota de eficiência: é o gasto e o resultado lado a lado, cada um com a sua fonte e o seu ano. A razão entre
// os dois depende de preço, de ponto de partida e de coisas que não estão no dado — e a página diz isso.
const REF_EF = ["BRA", "KOR", "USA", "DEU", "FRA", "ESP", "PRT", "CHL", "MEX", "ARG", "COL", "ZAF", "JPN"];
const porAlunoInd = idx("gasto_aluno_fundamental"), medioInd = idx("medio_completo_pct");
const saudeInd = idx("saude_pct_pib"), vidaInd = idx("expectativa_vida"), mortInfInd = idx("mortalidade_infantil");
const valorPais = (ind: any, iso: string) => (ind?.paises as any[])?.find((p) => p.iso3 === iso) ?? null;
const paresEducacao = REF_EF.map((iso) => {
  const g = valorPais(porAlunoInd, iso), r = valorPais(medioInd, iso);
  return g && r ? { iso, pais: g.pais, gasto: g.valor, anoGasto: g.ano, resultado: r.valor, anoRes: r.ano } : null;
}).filter(Boolean).sort((a: any, b: any) => b.gasto - a.gasto) as any[];
const paresSaude = REF_EF.map((iso) => {
  const g = valorPais(saudeInd, iso), v = valorPais(vidaInd, iso), m = valorPais(mortInfInd, iso);
  return g && v ? { iso, pais: g.pais, gasto: g.valor, anoGasto: g.ano, vida: v.valor, mort: m?.valor ?? null } : null;
}).filter(Boolean).sort((a: any, b: any) => b.gasto - a.gasto) as any[];

// Segurança por estado: gasto por habitante (SICONFI, função 06) × taxa de homicídios (ODS 16.1.1)
const homUltimo = hom.anos?.[hom.anos.length - 1];
const segUf = (despesaEstados as any[]).map((e) => {
  const taxa = hom.por_uf?.[homUltimo]?.[e.uf];
  const porHab = e.populacao ? (e.pago_seguranca ?? 0) / e.populacao : null;
  return porHab && taxa != null ? { uf: e.uf, nome: e.nome, porHab, taxa } : null;
}).filter(Boolean) as any[];
const maxGastoSeg = Math.max(...segUf.map((e) => e.porHab), 1);
const maxTaxaSeg = Math.max(...segUf.map((e) => e.taxa), 1);
const SW = 920, SHt = 420, SPAD = 54;
const sx = (v: number) => SPAD + (v / maxGastoSeg) * (SW - SPAD * 2);
const sy = (v: number) => SHt - SPAD - (v / maxTaxaSeg) * (SHt - SPAD * 2);

// gráfico do percentil ao longo do tempo (quanto menor, melhor colocado)
const W = 920, L = 44, R = 170, H = 300, T = 16, B = 30;
const NO_GRAFICO = ["pib_per_capita_ppp", "produtividade", "investimento_pct_pib", "idh", "mortalidade_infantil"];
const CORES = ["#1d5a8a", "#c2185b", "#e07b00", "#1f9d55", "#6a1b9a"];
const curvas = NO_GRAFICO.map((id, i) => {
  const l = linhas.find((x) => x.id === id);
  if (!l) return null;
  const pts = l.serie.filter((x: any) => x.posicao_fixa && x.total_fixo)
    .map((x: any) => ({ ano: x.ano, p: (x.posicao_fixa / x.total_fixo) * 100 }));
  return pts.length ? { id, titulo: l.titulo, cor: CORES[i], pts } : null;
}).filter(Boolean) as any[];
const anoMin = Math.min(...curvas.flatMap((c) => c.pts.map((p: any) => p.ano)));
const anoMax = Math.max(...curvas.flatMap((c) => c.pts.map((p: any) => p.ano)));
const x = (ano: number) => L + ((ano - anoMin) / (anoMax - anoMin)) * (W - L - R);
const y = (p: number) => T + (p / 100) * (H - T - B);
// Indústria: quatro medidas que não respondem a mesma pergunta
const indSerie = (ind as any).indicadores ?? {};
const anoOk = String((ind as any).ano_confiavel ?? 1995);
const pim = (ind as any).producao_fisica ?? {};
const nI = (v: number, c = 1) => v.toLocaleString("pt-BR", { minimumFractionDigits: c, maximumFractionDigits: c });
const serieDe = (k: string) => {
  const s = indSerie[k]; if (!s) return null;
  const anos = Object.keys(s.brasil).sort();
  const util = s.precos_correntes ? anos.filter((a) => a >= anoOk) : anos;
  const pico = util.reduce((m, a) => (s.brasil[a] > s.brasil[m] ? a : m), util[0]);
  const picoTudo = anos.reduce((m, a) => (s.brasil[a] > s.brasil[m] ? a : m), anos[0]);
  return { ...s, anos, util, ini: util[0], fim: util[util.length - 1], pico, picoTudo,
           vIni: s.brasil[util[0]], vFim: s.brasil[util[util.length - 1]], vPico: s.brasil[pico] };
};
const transf = serieDe("transformacao_pct_va");
const expManuf = serieDe("manufaturados_pct_exp");
const empIndustria = serieDe("emprego_industria_pct");
const tecnologia = serieDe("tecnologia_pct_va_ind");
const pimTransf = pim["129316"] ?? null;
const pimAnos = pimTransf ? Object.keys(pimTransf.anual).sort() : [];
const pimPico = pimAnos.length ? pimAnos.reduce((m, a) => (pimTransf.anual[a] > pimTransf.anual[m] ? a : m), pimAnos[0]) : null;
// gráfico da participação, Brasil contra os agregados do próprio Banco Mundial
const CORES_AGG: Record<string, string> = { "Mundo": "var(--ink-2)", "Países de renda alta": "var(--s2)", "América Latina e Caribe": "var(--s5)" };
const IW = 920, IH = 250, iPadL = 44, iPadB = 26;
const anosG = transf ? transf.util : [];
// só os anos desenhados entram na escala: os agregados têm série anterior a 1995, com valores bem maiores
const todosV = transf ? [...anosG.map((a: string) => transf.brasil[a]),
  ...Object.entries(transf.agregados).flatMap(([n, s]: [string, any]) =>
    (n in CORES_AGG ? Object.entries(s).filter(([a]) => a >= anosG[0]).map(([, v]) => v as number) : []))] : [1];
const maxI = Math.max(...todosV as number[]) * 1.1;
const ix = (a: string) => iPadL + ((+a - +anosG[0]) / Math.max(1, +anosG[anosG.length - 1] - +anosG[0])) * (IW - iPadL - 12);
const iy = (v: number) => 10 + (IH - iPadB - 10) * (1 - v / maxI);
const caminhoI = (pontos: Record<string, number>) => Object.keys(pontos).filter((a) => a >= anosG[0])
  .sort().map((a, i) => `${i ? "L" : "M"}${ix(a).toFixed(1)} ${iy(pontos[a]).toFixed(1)}`).join(" ");
// gráfico da produção física
const PW2 = 920, PH2 = 200, pPad2 = 44;
const pimMax = pimAnos.length ? Math.max(...pimAnos.map((a) => pimTransf.anual[a])) * 1.12 : 120;
const pxx = (i: number) => pPad2 + (i * (PW2 - pPad2 - 12)) / Math.max(1, pimAnos.length - 1);
const pyy = (v: number) => 10 + (PH2 - 24 - 10) * (1 - v / pimMax);

---
<Base title="O Brasil está se desenvolvendo? — Nosso Dinheiro" accent="var(--s1)"
  description="Doze indicadores de desenvolvimento, da mortalidade infantil à produtividade, com a trajetória do Brasil desde 1960 e a posição do país no mundo ao longo do tempo.">
  <h1>O Brasil está se desenvolvendo?</h1>
  <p class="lede">
    Desenvolvimento não é um número, e é por isso que a resposta parece contraditória: o Brasil <strong>melhorou muito
    quase tudo que se mede por pessoa</strong> — morre-se menos criança, vive-se mais, estuda-se mais, há luz e
    internet onde não havia — e <strong>parou no que se mede por produção</strong>. A produtividade do trabalhador
    brasileiro cresceu {n1(prodVar)}% em {anosProd} anos. E, no ranking mundial, o país <strong>perdeu posição relativa em {perderamPosicao.length} dos
    {linhas.filter((l) => l.pctlDe != null && l.pctlPara != null).length} indicadores</strong> com série comparável —
    inclusive em renda por pessoa, produtividade e investimento: melhorou, mas os outros melhoraram mais rápido.
  </p>
  <p class="meta">fontes: Banco Mundial, PNUD, Transparência Internacional e IBGE · <a href="/metodologia/">metodologia</a> · <a href="/conferir/">como conferir</a></p>

  <div class="hero">
    <div class="stat big"><b>−{n1(Math.abs(mortInf.serie[0].valor - mortInf.serie[mortInf.serie.length - 1].valor) / mortInf.serie[0].valor * 100)}%</b>
      <span>a mortalidade infantil desde {mortInf.serie[0].ano}: de {n1(mortInf.serie[0].valor)} para {n1(mortInf.serie[mortInf.serie.length - 1].valor)} mortes por mil nascidos — a maior melhora de todas</span></div>
    <div class="stat"><b>+{n1(prodVar)}%</b><span>a produtividade do trabalho em {anosProd} anos; o Brasil saiu do {prod.serie[0].posicao}º para o {prod.serie[prod.serie.length - 1].posicao}º lugar</span></div>
    <div class="stat"><b>{n1(inv.b ?? inv.serie[inv.serie.length - 1].valor)}%</b><span>do PIB vira <Termo t="investimento">investimento</Termo> — era {n1(inv.serie[0].valor)}% em {inv.serie[0].ano}, e hoje é o {inv.serie[inv.serie.length - 1].posicao}º de {inv.serie[inv.serie.length - 1].total} países</span></div>
  </div>

  <div class="disclaimer"><span aria-hidden="true">ⓘ</span>
    <div><b>Esta página não diz por quê.</b> Explicar <i>por que</i> a produtividade parou ou por que o investimento
    caiu é disputa entre economistas, não dado — e aqui só entra o que está medido, com a fonte ao lado.
    <b>Posição bruta não compara épocas</b>: o número de países com dado muda de um ano para outro. Por isso usamos o
    <Termo t="percentil_pais">percentil</Termo> dentro de um <b>grupo fixo de países</b>: os que têm dado no primeiro
    e no último ano de cada série. Sem isso a conta engana — no acesso a energia elétrica a lista do Banco Mundial vai
    de 98 países em 1990 a 215 em 2024, e o Brasil "subiria" 36 pontos sem ter feito nada, só porque países mais pobres
    entraram na lista depois. Com o grupo fixo, a melhora real é de 3 pontos. A tabela traz sempre a posição bruta ao
    lado, para quem quiser conferir.</div>
  </div>

  <h2>O que melhorou</h2>
  <div class="card">
    <table>
      <thead><tr><th>Indicador</th><th class="num">Começo</th><th class="num">Hoje</th><th class="num">Brasil</th>
        {GRUPOS_MOSTRA.map((g) => <th class="num">{agr.grupos[g]}</th>)}</tr></thead>
      <tbody>{melhoraram.map((l) => (<tr>
        <td>{l.titulo}<br /><span class="sub">{l.unidade}</span></td>
        <td class="num">{n1(l.a.valor)}<br /><span class="sub">{l.a.ano}</span></td>
        <td class="num">{n1(l.b.valor)}<br /><span class="sub">{l.b.ano}</span></td>
        <td class="num"><b>{sinal(l.variacao)}%</b><br /><span class="sub" title={`últimos 10 anos: ${sinal(l.var10)}%`}>10 anos: {sinal(l.var10)}%</span></td>
        {GRUPOS_MOSTRA.map((g) => (<td class="num">{l.mundo[g]
          ? <span title={`${agr.grupos[g]}: de ${n1(l.mundo[g].vDe)} (${l.mundo[g].de}) para ${n1(l.mundo[g].vAte)} (${l.mundo[g].ate})`}>{sinal(l.mundo[g].pct)}%</span>
          : "—"}</td>))}</tr>))}
      </tbody>
    </table>
    <p class="src">
      <b>As três últimas colunas são a mesma conta feita para o mundo</b>, no mesmo período de cada linha: se o
      Brasil melhorou 50% e o mundo melhorou 60%, o avanço era a maré e não a remada. Os grupos são os que o Banco
      Mundial publica; passe o mouse para ver os valores e os anos de cada um. Abaixo do número do Brasil está a
      variação dos últimos 10 anos, porque uma melhora de 40 anos pode esconder uma década parada.
      Dois números nossos, que não vêm do Banco Mundial e contam a mesma história: os adultos sem o ensino fundamental
      caíram de {n1(semFund91)}% em 1991 para {n1(semFundHoje)}% hoje (<a href="/educacao/">Educação</a>) e os
      domicílios com esgoto ligado à rede subiram de {n1(esgoto91)}% para {n1(esgoto22)}% (<a href="/saneamento/">Saneamento</a>).
    </p>
  </div>

  <h2>O que parou ou piorou</h2>
  <div class="card">
    <table>
      <thead><tr><th>Indicador</th><th class="num">Começo</th><th class="num">Hoje</th><th class="num">Brasil</th>
        {GRUPOS_MOSTRA.map((g) => <th class="num">{agr.grupos[g]}</th>)}</tr></thead>
      <tbody>{pioraram.map((l) => (<tr>
        <td>{l.titulo}<br /><span class="sub">{l.unidade}</span></td>
        <td class="num">{n1(l.a.valor)}<br /><span class="sub">{l.a.ano}</span></td>
        <td class="num">{n1(l.b.valor)}<br /><span class="sub">{l.b.ano}</span></td>
        <td class="num neg"><b>{sinal(l.variacao)}%</b><br /><span class="sub">10 anos: {sinal(l.var10)}%</span></td>
        {GRUPOS_MOSTRA.map((g) => (<td class="num">{l.mundo[g]
          ? <span title={`${agr.grupos[g]}: de ${n1(l.mundo[g].vDe)} (${l.mundo[g].de}) para ${n1(l.mundo[g].vAte)} (${l.mundo[g].ate})`}>{sinal(l.mundo[g].pct)}%</span>
          : "—"}</td>))}</tr>))}
      </tbody>
    </table>
    <p class="src">
      "Piorou" aqui é o próprio dado que decide: cada indicador traz, na fonte, se é melhor quando sobe (investimento,
      abertura) ou quando desce (mortalidade, desigualdade). Nenhuma dessas linhas é opinião nossa sobre o que o país
      deveria fazer. As colunas do mundo usam o mesmo período de cada linha; onde o grupo não tem dado no ano inicial,
      a conta usa o ano mais próximo e o mostra na dica. Fontes de cada indicador na tabela do fim da página.
    </p>
  </div>

  <h2>Melhorou e mesmo assim caiu de posição</h2>
  <div class="card">
    <div class="legend">{curvas.map((c) => <span><i style={`background:${c.cor}`}></i>{c.titulo}</span>)}</div>
    <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label="Percentil do Brasil no mundo ao longo do tempo, em cinco indicadores">
      {[0, 25, 50, 75, 100].map((t) => <g>
        <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} stroke="var(--line)" />
        <text x={L - 6} y={y(t) + 4} text-anchor="end" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{t === 0 ? "1º" : `${t}%`}</text></g>)}
      {curvas.map((c) => (<g>
        <polyline points={c.pts.map((p: any) => `${x(p.ano).toFixed(1)},${y(p.p).toFixed(1)}`).join(" ")} fill="none" stroke={c.cor} stroke-width="2" />
        <text x={W - R + 8} y={y(c.pts[c.pts.length - 1].p) + 4} font-size="11" fill={c.cor}>{c.titulo}</text>
        {c.pts.filter((_: any, i: number) => i % 5 === 0).map((p: any) => <circle cx={x(p.ano)} cy={y(p.p)} r="2.5" fill={c.cor}><title>{c.titulo} · {p.ano}: o Brasil estava à frente de {n1(100 - p.p)}% dos países do grupo fixo</title></circle>)}
      </g>))}
      {[anoMin, Math.round((anoMin + anoMax) / 2), anoMax].map((a) => <text x={x(a)} y={H - 10} text-anchor="middle" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{a}</text>)}
    </svg>
    <p class="src">
      Quanto <b>mais baixa</b> a linha, melhor colocado o Brasil. O eixo é o percentil: 0 é o primeiro lugar do mundo,
      100 é o último. Como o número de países com dado muda a cada ano, essa é a única forma honesta de comparar a
      posição de 1990 com a de hoje. As linhas subindo mostram o ponto central desta página: <b>o Brasil melhorou em
      valor absoluto e perdeu posição relativa</b>, porque outros países melhoraram mais depressa.
    </p>
  </div>

  <h2>Subiu ou caiu? A posição do Brasil, do começo da série até hoje</h2>
  <div class="card">
    <svg viewBox={`0 0 ${TW} ${trajeto.length * 30 + 44}`} width="100%" role="img" aria-label="Posição do Brasil no mundo, do primeiro ano de cada série até hoje">
      {[0, 25, 50, 75, 100].map((t) => (<g>
        <line x1={tx(t)} x2={tx(t)} y1="20" y2={trajeto.length * 30 + 14} stroke="var(--line)" />
        <text x={tx(t)} y="13" text-anchor="middle" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{t === 0 ? "1º do mundo" : t === 100 ? "último" : `${t}%`}</text>
      </g>))}
      {trajeto.map((l, i) => {
        const y0 = i * 30 + 36;
        const de = tx(l.pctlDe as number), para = tx(l.pctlPara as number);
        const melhorou = (l.delta as number) < 0;
        const cor = melhorou ? "var(--s2)" : "#a3302a";
        return (<g>
          <text x={TL - 10} y={y0 + 4} text-anchor="end" font-size="12" fill="var(--ink)">{l.titulo}</text>
          <text x={TL - 10} y={y0 + 15} text-anchor="end" font-size="9.5" fill="var(--ink-2)">{l.a.ano} → {l.b.ano}</text>
          <line x1={de} x2={para} y1={y0} y2={y0} stroke={cor} stroke-width="3" opacity="0.5" />
          <circle cx={de} cy={y0} r="5" fill="var(--card)" stroke="var(--ink-2)" stroke-width="1.5">
            <title>{l.titulo} em {l.a.ano}: melhor que {n1(100 - (l.pctlDe as number))}% do grupo fixo de {l.a.total_fixo} países · no total daquele ano era {l.a.posicao}º de {l.a.total}</title></circle>
          <circle cx={para} cy={y0} r="6" fill={cor}>
            <title>{l.titulo} em {l.b.ano}: melhor que {n1(100 - (l.pctlPara as number))}% do grupo fixo de {l.b.total_fixo} países · no total de hoje é {l.b.posicao}º de {l.b.total}</title></circle>
          <text x={TW - TR + 10} y={y0 + 4} font-size="11" font-family="IBM Plex Mono, monospace" fill={cor}>
            {melhorou ? "subiu" : "caiu"} {n0(Math.abs(l.delta as number))} pts
          </text>
        </g>);
      })}
    </svg>
    <p class="src">
      Cada linha é um indicador. O <b>círculo vazio</b> é onde o Brasil estava no primeiro ano com dado comparável; o
      <b>círculo cheio</b>, onde está hoje. Quanto mais à <b>esquerda</b>, melhor colocado. Verde = o país ganhou
      posição; vermelho = perdeu. A série mais antiga começa em {anoMaisAntigo}, antes da Constituição, porque o Banco
      Mundial publica alguns indicadores desde 1960 — e não existe nada comparável entre países antes disso.
      A posição é medida <b>sempre dentro do mesmo grupo de países</b> (os que têm dado nas duas pontas da série), e
      não entre todos os que existem em cada ano: é o que impede que o Brasil pareça subir só porque a lista mudou.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <table>
      <thead><tr><th>Indicador</th><th class="num">No começo</th><th class="num">Era melhor que</th><th class="num">Hoje</th><th class="num">Posição hoje</th><th class="num">É melhor que</th></tr></thead>
      <tbody>{trajeto.map((l) => (<tr>
        <td>{l.titulo}<br /><span class="sub">{l.unidade}</span></td>
        <td class="num">{n1(l.a.valor)}<br /><span class="sub">{l.a.posicao}º de {l.a.total} · {l.a.ano}</span></td>
        <td class="num">{l.pctlDe != null ? pct(100 - (l.pctlDe as number)) : "—"}<br /><span class="sub">do grupo fixo</span></td>
        <td class="num">{n1(l.b.valor)}<br /><span class="sub">{l.b.ano}</span></td>
        <td class="num">{l.b.posicao}º de {l.b.total}</td>
        <td class="num">{l.pctlPara != null ? pct(100 - (l.pctlPara as number)) : "—"}</td></tr>))}
      </tbody>
    </table>
    <p class="src">
      "À frente de" é quantos por cento dos países o Brasil supera naquele indicador. Em alguns, estar bem colocado é
      ruim: a lista ordena pelo que o indicador considera melhor, e isso está na própria fonte. O ranking completo,
      com todos os países, está em <a href="/rankings/">Rankings</a>.
    </p>
  </div>




  <h2>Indústria: estamos industrializando ou perdendo indústria?</h2>
  <div class="card">
    <p style="margin:0 0 10px">
      A resposta depende de qual pergunta se faz, e as quatro medidas abaixo dão respostas diferentes — por isso
      estão todas aqui. Começando pela que mais se cita e que, justamente, é a que <b>menos</b> mostra o problema.
    </p>
    <div class="legend"><span><i style="background:var(--accent)"></i>Brasil</span>{Object.keys(CORES_AGG).map((n) => <span><i style={`background:${CORES_AGG[n]}`}></i>{n}</span>)}</div>
    {transf && <svg viewBox={`0 0 ${IW} ${IH}`} width="100%" role="img" aria-label={`Participação da indústria de transformação no valor adicionado, Brasil e grupos de países, de ${transf.ini} a ${transf.fim}`}>
      {[5, 10, 15, 20].filter((v) => v < maxI).map((v) => (<g><line x1={iPadL} x2={IW - 12} y1={iy(v)} y2={iy(v)} stroke="var(--line)" /><text x={iPadL - 6} y={iy(v) + 4} text-anchor="end" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{v}%</text></g>))}
      {anosG.filter((a: string) => +a % 5 === 0).map((a: string) => <text x={ix(a)} y={IH - 8} text-anchor="middle" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{a}</text>)}
      {Object.entries(transf.agregados).filter(([n]) => n in CORES_AGG).map(([n, s]: [string, any]) =>
        <path d={caminhoI(s)} fill="none" stroke={CORES_AGG[n]} stroke-width="1.8" opacity="0.8" />)}
      <path d={caminhoI(transf.brasil)} fill="none" stroke="var(--accent)" stroke-width="3" />
    </svg>}
    {transf && <p class="src">
      A indústria de transformação era <b>{nI(transf.vIni)}%</b> do valor adicionado em {transf.ini} e é
      {" "}<b>{nI(transf.vFim)}%</b> em {transf.fim}. <b>Mas o mundo inteiro andou na mesma direção</b>: no mesmo
      período os países de renda alta caíram de {nI(transf.agregados["Países de renda alta"]?.["2000"] ?? 0)}% (2000)
      para {nI(transf.agregados["Países de renda alta"]?.["2024"] ?? 0)}% (2024) e a média mundial, de
      {" "}{nI(transf.agregados["Mundo"]?.["2000"] ?? 0)}% para {nI(transf.agregados["Mundo"]?.["2024"] ?? 0)}%.
      A queda brasileira nesse trecho foi <b>menor</b> que a deles — o grosso da perda de participação aconteceu
      <b> antes</b> desta série.
      <b>Por que o gráfico começa em {anoOk} e não há 50 anos aqui:</b> a participação é medida a preços correntes,
      e sob inflação alta ela oscila com o preço relativo em vez da produção. A mesma fonte dá
      {" "}{nI(transf.brasil[transf.picoTudo])}% em {transf.picoTudo} e {nI(transf.brasil["1980"] ?? 0)}% no ano
      seguinte — isso não é indústria aparecendo e sumindo, é ruído. O arquivo guarda a série inteira; o gráfico usa
      a parte que mede o que diz medir.
    </p>}
  </div>

  {pimTransf && pimPico && <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">A medida sem preço nenhum: quanta coisa sai da fábrica</h3>
    <svg viewBox={`0 0 ${PW2} ${PH2}`} width="100%" role="img" aria-label="Índice de produção física da indústria de transformação, média anual, 2022 = 100">
      {[80, 100, 120].map((v) => (<g><line x1={pPad2} x2={PW2 - 12} y1={pyy(v)} y2={pyy(v)} stroke="var(--line)" /><text x={pPad2 - 6} y={pyy(v) + 4} text-anchor="end" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{v}</text></g>))}
      <path d={pimAnos.map((a, i) => `${i ? "L" : "M"}${pxx(i).toFixed(1)} ${pyy(pimTransf.anual[a]).toFixed(1)}`).join(" ")} fill="none" stroke="var(--accent)" stroke-width="3" />
      {pimAnos.map((a, i) => (+a % 3 === 0 || a === pimPico) && (<g>
        <circle cx={pxx(i)} cy={pyy(pimTransf.anual[a])} r={a === pimPico ? 4 : 2.5} fill={a === pimPico ? "#a3302a" : "var(--accent)"}>
          <title>{a}: índice {nI(pimTransf.anual[a])}</title></circle>
        <text x={pxx(i)} y={PH2 - 6} text-anchor="middle" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{a}</text></g>))}
    </svg>
    <p class="src">
      Este índice conta <b>volume produzido</b>, não valor: não tem preço nem inflação na conta. A indústria de
      transformação chegou ao topo em <b>{pimPico}</b> (índice {nI(pimTransf.anual[pimPico])}) e está em
      {" "}{nI(pimTransf.anual[pimAnos[pimAnos.length - 1]])} em {pimAnos[pimAnos.length - 1]} — ou seja,
      <b> {nI(100 * (1 - pimTransf.anual[pimAnos[pimAnos.length - 1]] / pimTransf.anual[pimPico]))}% abaixo do pico</b>,
      e apenas {nI(100 * (pimTransf.anual[pimAnos[pimAnos.length - 1]] / pimTransf.anual[pimAnos[0]] - 1))}% acima de
      {" "}{pimAnos[0]}. <b>É aqui que a perda aparece</b>: em mais de vinte anos, o volume produzido praticamente não
      cresceu. Fonte: IBGE, Pesquisa Industrial Mensal — Produção Física (2022 = 100), média dos doze meses de cada ano.
    </p>
  </div>}

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">O que o Brasil vende, e quem trabalha nisso</h3>
    <table>
      <thead><tr><th>Medida</th><th class="num">No começo da série</th><th class="num">No melhor momento</th><th class="num">Hoje</th><th class="num">Do pico até hoje</th></tr></thead>
      <tbody>
        {[expManuf, empIndustria, tecnologia].filter(Boolean).map((s: any) => (<tr>
          <td>{s.nome} <span class="un">{s.unidade}</span></td>
          <td class="num">{nI(s.vIni)}% <span class="un">{s.ini}</span></td>
          <td class="num">{nI(s.vPico)}% <span class="un">{s.pico}</span></td>
          <td class="num">{nI(s.vFim)}% <span class="un">{s.fim}</span></td>
          <td class="num"><b>−{nI(100 * (1 - s.vFim / s.vPico))}%</b></td></tr>))}
      </tbody>
    </table>
    <p class="src">
      {expManuf && <span>Os <b>manufaturados</b> eram {nI(expManuf.vPico)}% de tudo que o Brasil exportava em
      {" "}{expManuf.pico} e são {nI(expManuf.vFim)}% em {expManuf.fim}: voltamos a vender sobretudo produto
      primário. </span>}
      {tecnologia && <span>Dentro da própria indústria, a fatia de <b>média e alta tecnologia</b> caiu de
      {" "}{nI(tecnologia.vPico)}% em {tecnologia.pico} para {nI(tecnologia.vFim)}% em {tecnologia.fim} — a indústria
      que restou é menos sofisticada que a de trinta anos atrás. </span>}
      {empIndustria && <span>E a indústria emprega {nI(empIndustria.vFim)}% dos ocupados, contra
      {" "}{nI(empIndustria.vPico)}% em {empIndustria.pico}.</span>}
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">Juntando as quatro: a resposta honesta</h3>
    <ul class="limites">
      <li><b>Pela participação no PIB, a resposta é "quase não mudou" desde {anoOk}</b> — e a queda brasileira foi
        menor que a do mundo rico. Quem usa só esse número para falar em desindustrialização está usando o indicador
        mais fraco dos quatro.</li>
      <li><b>Pela produção física, a resposta é "paramos"</b>: o volume produzido está abaixo do que era em
        {" "}{pimPico} e mal passa do de {pimAnos[0] ?? "2002"}. Não é que a indústria encolheu de repente — é que ela
        deixou de crescer enquanto o resto da economia cresceu.</li>
      <li><b>Pela pauta de exportação e pelo conteúdo tecnológico, a resposta é "retrocedemos"</b>: vendemos menos
        manufaturado e, dentro da indústria, menos tecnologia.</li>
      <li><b>O que este site não diz:</b> se isso é bom ou ruim, e por que aconteceu. Câmbio, juro, carga tributária,
        energia, infraestrutura e acordos comerciais são citados como causa por quem estuda o assunto; separar o peso
        de cada um não é dado público, é pesquisa. Os preços relativos entre indústria e serviços estão em
        {" "}<a href="/economia/poder-de-compra/">Poder de compra</a>, e a carga sobre bens e serviços, em
        {" "}<a href="/impostos/">Impostos</a>.</li>
    </ul>
  </div>

  <h2>Quanto custa e o que entrega</h2>
  <div class="card">
    <p style="margin:0">
      <b>Isto não é uma nota de eficiência.</b> É o gasto e o resultado lado a lado, cada um com a sua fonte e o seu
      ano. Dividir um pelo outro daria um número fácil e enganoso: o resultado de hoje vem de décadas de gasto, o preço
      de um professor ou de um hospital é diferente em cada país, e o ponto de partida importa — sair de 60 para 70
      anos de expectativa de vida custa menos que sair de 80 para 81. O que dá para fazer honestamente é mostrar os
      dois números e deixar a comparação à vista.
    </p>
  </div>

  {paresEducacao.length > 0 && <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 2px">Educação: o que se gasta por aluno e quantos adultos terminaram o médio</h3>
    <p class="sub" style="margin:0 0 10px">gasto por aluno em dólares PPP por ano · adultos de 25+ com ensino médio completo</p>
    <table>
      <thead><tr><th>País</th><th class="num">Gasto por aluno</th><th class="num">Ano</th><th class="num">Adultos com médio completo</th><th class="num">Ano</th></tr></thead>
      <tbody>{paresEducacao.map((p) => (<tr class={p.iso === "BRA" ? "destaque" : undefined}>
        <td>{p.iso === "BRA" ? <b>{p.pais}</b> : p.pais}</td>
        <td class="num">US$ {n0(p.gasto)}</td><td class="num">{p.anoGasto}</td>
        <td class="num">{n1(p.resultado)}%</td><td class="num">{p.anoRes}</td></tr>))}
      </tbody>
    </table>
    <p class="src">
      O Brasil gasta US$ {n0(paresEducacao.find((p) => p.iso === "BRA")?.gasto ?? 0)} por aluno e tem
      {" "}{n1(paresEducacao.find((p) => p.iso === "BRA")?.resultado ?? 0)}% dos adultos com o médio completo. Portugal,
      que gasta {n1((valorPais(porAlunoInd, "PRT")?.valor ?? 0) / (valorPais(porAlunoInd, "BRA")?.valor ?? 1))} vezes
      mais por aluno, tem {n1(valorPais(medioInd, "PRT")?.valor ?? 0)}%. <b>Os anos são diferentes</b> e estão na
      tabela — a série de gasto por aluno parou de ser alimentada por muitos países. A qualidade do que se aprende
      (IDEB, PISA) é outra conta: o IDEB por estado está em <a href="/educacao/">Educação</a>.
    </p>
  </div>}

  {paresSaude.length > 0 && <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 2px">Saúde: o que o governo gasta e quanto se vive</h3>
    <p class="sub" style="margin:0 0 10px">gasto público em saúde como % do PIB · expectativa de vida e mortalidade infantil</p>
    <table>
      <thead><tr><th>País</th><th class="num">Gasto público (% do PIB)</th><th class="num">Expectativa de vida</th><th class="num">Mortalidade infantil</th></tr></thead>
      <tbody>{paresSaude.map((p) => (<tr class={p.iso === "BRA" ? "destaque" : undefined}>
        <td>{p.iso === "BRA" ? <b>{p.pais}</b> : p.pais}</td>
        <td class="num">{n1(p.gasto)}%</td><td class="num">{n1(p.vida)} anos</td>
        <td class="num">{p.mort != null ? `${n1(p.mort)} por mil` : "—"}</td></tr>))}
      </tbody>
    </table>
    <p class="src">
      O gasto <b>público</b> do Brasil em saúde ({n1(valorPais(saudeInd, "BRA")?.valor ?? 0)}% do PIB) é menor que o da
      maioria desta lista, enquanto o gasto <b>total</b>, somando planos e desembolso das famílias, chega a
      {" "}{n1(valorPais(idx("saude_total_pct_pib"), "BRA")?.valor ?? 0)}% — ou seja, boa parte do dinheiro da saúde
      brasileira não passa pelo governo. A comparação completa está em <a href="/comparacao/">Comparação</a> e o
      detalhe do SUS em <a href="/saude/">Saúde</a>.
    </p>
  </div>}

  {segUf.length > 0 && <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 2px">Segurança: o que cada estado gasta e quantos homicídios tem</h3>
    <p class="sub" style="margin:0 0 10px">despesa estadual na função Segurança Pública por habitante (2025) · homicídios por 100 mil ({homUltimo})</p>
    <svg viewBox={`0 0 ${SW} ${SHt}`} width="100%" role="img" aria-label="Gasto estadual em segurança por habitante e taxa de homicídios, por estado">
      {[0, 0.25, 0.5, 0.75, 1].map((t) => (<g>
        <line x1={SPAD} x2={SW - SPAD} y1={sy(maxTaxaSeg * t)} y2={sy(maxTaxaSeg * t)} stroke="var(--line)" />
        <text x={SPAD - 8} y={sy(maxTaxaSeg * t) + 4} text-anchor="end" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{n0(maxTaxaSeg * t)}</text>
        <text x={sx(maxGastoSeg * t)} y={SHt - SPAD + 16} text-anchor="middle" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{brl0(maxGastoSeg * t)}</text>
      </g>))}
      <text x={SW / 2} y={SHt - 8} text-anchor="middle" font-size="11" fill="var(--ink-2)">gasto estadual em segurança por habitante, por ano →</text>
      <text x="14" y={SHt / 2} text-anchor="middle" font-size="11" fill="var(--ink-2)" transform={`rotate(-90 14 ${SHt / 2})`}>↑ homicídios por 100 mil</text>
      {segUf.map((e) => (<g>
        <circle cx={sx(e.porHab)} cy={sy(e.taxa)} r="5" fill="var(--s1)" opacity="0.75">
          <title>{e.nome}: {brl0(e.porHab)} por habitante em segurança e {n1(e.taxa)} homicídios por 100 mil</title></circle>
        <text x={sx(e.porHab) + 8} y={sy(e.taxa) + 4} font-size="10" fill="var(--ink-2)">{e.uf}</text>
      </g>))}
    </svg>
    <p class="src">
      Cada ponto é um estado. <b>Não há linha de tendência aqui de propósito</b>: gastar mais não garante menos
      homicídio, e gastar menos não causa mais — a violência depende de muita coisa que não está neste gráfico, e os
      estados partem de pontos muito diferentes. O que o gráfico mostra é que estados com gasto parecido têm taxas
      muito diferentes, e vice-versa. Fontes: SICONFI (função 06, despesa paga em 2025) e {hom.fonte}.
    </p>
  </div>}

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">Judiciário e obras: onde o dado é mais fraco</h3>
    <ul class="limites">
      <li><b>Judiciário:</b> o Brasil gasta {n1(JUDICIARIO_BR.pct_pib)}% do PIB com tribunais, contra uma mediana europeia de 0,19% — mas o que se compara do outro lado (tempo de tramitação, casos resolvidos por magistrado) vem do próprio Judiciário, que é parte interessada. A comparação de gasto está em <a href="/comparacao/">Comparação</a>.</li>
      <li><b>Obras:</b> há {obras.paradas.n.toLocaleString("pt-BR")} obras paralisadas ou inacabadas no cadastro federal, com {compact(obras.paradas.previsto)} previstos nelas — mas "previsto" não é gasto, e a situação de cada obra é declarada pelo próprio órgão. É o par gasto × resultado mais frágil do site, e está em <a href="/obras/">Obras</a>.</li>
      <li><b>O que falta para fechar qualquer conta de eficiência:</b> preço unitário do que o Estado compra. Sem saber quanto custa uma vaga de creche ou um quilômetro de asfalto em cada lugar, comparar gasto com resultado mede também a diferença de preço — e não só a de gestão.</li>
    </ul>
  </div>

  <h2>Por estado: quem mudou mais</h2>
  <div class="card">
    <p style="margin:0 0 10px">
      Três dimensões têm série estadual comparável ao longo do tempo. Os mapas mostram a <b>mudança</b>, não o nível
      de hoje: quanto mais forte a cor, maior o avanço do estado no período.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 2px">Educação — adultos com ensino médio completo ou mais</h3>
    <p class="sub" style="margin:0 0 10px">variação em pontos percentuais, Censo de {eduDe} a {eduPara}</p>
    <MapaBrasil valores={Object.fromEntries(porEstado.map((e) => [e.uf, Number(e.eduVar.toFixed(1))]))}
      formato={(v) => `+${n1(v)} p.p.`} titulo={`Avanço na escolaridade por estado, de ${eduDe} a ${eduPara}`}
      legenda={`pontos percentuais a mais de adultos com médio completo (${eduDe}→${eduPara})`} cor="var(--s1)" />
    <p class="src">
      Todos os 27 estados avançaram. O maior avanço é {nomeUf[topEdu[0].uf] ?? topEdu[0].uf}
      ({n1(topEdu[0].eduDe)}% → {n1(topEdu[0].eduPara)}%, +{n1(topEdu[0].eduVar)} pontos) e o menor é
      {" "}{nomeUf[topEdu[topEdu.length - 1].uf] ?? topEdu[topEdu.length - 1].uf}
      ({n1(topEdu[topEdu.length - 1].eduDe)}% → {n1(topEdu[topEdu.length - 1].eduPara)}%).
      {" "}{edu.ressalva} Fonte: {edu.fonte}.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 2px">Saneamento — domicílios com esgoto ligado à rede</h3>
    <p class="sub" style="margin:0 0 10px">variação em pontos percentuais, Censo de {sanDe} a {sanPara}</p>
    <MapaBrasil valores={Object.fromEntries(porEstado.filter((e) => e.sanVar != null).map((e) => [e.uf, Number((e.sanVar as number).toFixed(1))]))}
      formato={(v) => `${v > 0 ? "+" : ""}${n1(v)} p.p.`} titulo={`Avanço no esgoto ligado à rede por estado, de ${sanDe} a ${sanPara}`}
      legenda={`pontos percentuais a mais de domicílios com esgoto na rede (${sanDe}→${sanPara})`} cor="var(--s5)" />
    <p class="src">
      Maior avanço: {nomeUf[topSan[0].uf] ?? topSan[0].uf} ({n1(topSan[0].sanDe)}% → {n1(topSan[0].sanPara)}%).
      Menor: {nomeUf[topSan[topSan.length - 1].uf] ?? topSan[topSan.length - 1].uf}
      ({n1(topSan[topSan.length - 1].sanDe)}% → {n1(topSan[topSan.length - 1].sanPara)}%). Detalhe em
      {" "}<a href="/saneamento/">Saneamento</a>.
    </p>
  </div>

  {topHom.length > 0 && <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 2px">Segurança — homicídios por 100 mil habitantes</h3>
    <p class="sub" style="margin:0 0 10px">queda da taxa, de {homDe} a {homPara} (cor mais forte = caiu mais; valor negativo = subiu)</p>
    <MapaBrasil valores={Object.fromEntries(topHom.map((e) => [e.uf, Number((-(e.homVar as number)).toFixed(1))]))}
      formato={(v) => `${v > 0 ? "−" : "+"}${n1(Math.abs(v))}`} titulo={`Queda da taxa de homicídios por estado, de ${homDe} a ${homPara}`}
      legenda={`queda da taxa de homicídios por 100 mil (${homDe}→${homPara})`} cor="var(--s2)" />
    <p class="src">
      {nomeUf[topHom[0].uf] ?? topHom[0].uf} teve a maior queda: de {n1(topHom[0].homDe as number)} para
      {" "}{n1(topHom[0].homPara as number)} por 100 mil. Na outra ponta,
      {" "}{nomeUf[topHom[topHom.length - 1].uf] ?? topHom[topHom.length - 1].uf} foi de
      {" "}{n1(topHom[topHom.length - 1].homDe as number)} para {n1(topHom[topHom.length - 1].homPara as number)}.
      {" "}{hom.ressalva} Fonte: {hom.fonte}. As mortes violentas registradas pelas polícias, com recorte mais recente
      e por município, estão em <a href="/seguranca/">Segurança</a>.
    </p>
  </div>}

  <div class="card" style="margin-top:14px">
    <table>
      <thead><tr><th>Estado</th>
        <th class="num">Médio completo {eduDe}</th><th class="num">{eduPara}</th><th class="num">Variação</th>
        <th class="num">Esgoto {sanDe}</th><th class="num">{sanPara}</th><th class="num">Variação</th>
        <th class="num">Homicídios {homDe}</th><th class="num">{homPara}</th><th class="num">Variação</th></tr></thead>
      <tbody>{[...porEstado].sort((a, b) => b.eduVar - a.eduVar).map((e) => (<tr>
        <td>{nomeUf[e.uf] ?? e.uf}</td>
        <td class="num">{n1(e.eduDe)}%</td><td class="num">{n1(e.eduPara)}%</td><td class="num">+{n1(e.eduVar)}</td>
        <td class="num">{e.sanDe != null ? `${n1(e.sanDe)}%` : "—"}</td><td class="num">{e.sanPara != null ? `${n1(e.sanPara)}%` : "—"}</td>
        <td class="num">{e.sanVar != null ? `+${n1(e.sanVar)}` : "—"}</td>
        <td class="num">{e.homDe != null ? n1(e.homDe) : "—"}</td><td class="num">{e.homPara != null ? n1(e.homPara) : "—"}</td>
        <td class={`num${(e.homVar ?? 0) > 0 ? " neg" : ""}`}>{e.homVar != null ? `${e.homVar > 0 ? "+" : "−"}${n1(Math.abs(e.homVar))}` : "—"}</td></tr>))}
      </tbody>
    </table>
    <p class="src">Ordenado pelo avanço na escolaridade. Clique no cabeçalho para ordenar por outra coluna.</p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">O que não dá para medir por estado desde 1991</h3>
    <ul class="limites">{((uf as any).fora as string[]).map((t) => <li>{t}</li>)}</ul>
    <p class="src">Faltar fonte comparável não é o mesmo que ir bem ou mal: é não saber. Quando existe série mais curta, ela está no painel próprio de cada assunto.</p>
  </div>

  <h2>O que este painel não responde</h2>
  <div class="card">
    <ul class="limites">
      <li><b>Por que parou.</b> Produtividade e investimento são o centro do debate econômico brasileiro há 40 anos; atribuir causa seria opinião.</li>
      <li><b>Se os indicadores medem a coisa certa.</b> PIB por pessoa não vê desigualdade; o IDH junta três coisas numa só; o índice de percepção da corrupção mede percepção, não corrupção.</li>
      <li><b>O ano de cada um é diferente</b>, porque cada país e cada instituição publicam no seu tempo. A tabela sempre diz qual é.</li>
      <li><b>O que não está em base internacional comparável</b> — qualidade da escola, tempo de espera no SUS, segurança jurídica — não aparece aqui, e a ausência não é sinal de que vai bem.</li>
    </ul>
  </div>

  <Glossario termos={["percentil_pais", "investimento", "produtividade_trabalho", "idh_indice", "gini"]} />
