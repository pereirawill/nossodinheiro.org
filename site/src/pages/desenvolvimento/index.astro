---
import Base from "../../layouts/Base.astro";
import Termo from "../../components/Termo.astro";
import Glossario from "../../components/Glossario.astro";
import rankings from "../../../public/data/rankings.json";
import educacao from "../../../public/data/educacao.json";
import saneamento from "../../../public/data/saneamento.json";
import uf from "../../../public/data/desenvolvimento.json";
import MapaBrasil from "../../components/MapaBrasil.astro";

const n1 = (v: number) => v.toLocaleString("pt-BR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const n0 = (v: number) => Math.round(v).toLocaleString("pt-BR");
const pct = (v: number) => `${n1(v)}%`;
const sinal = (v: number) => `${v > 0 ? "+" : "−"}${n1(Math.abs(v))}`;

const indices = rankings.indices as any[];
const idx = (id: string) => indices.find((i) => i.id === id);

// Para cada indicador: onde começou, onde está, e como mudou a posição do Brasil no mundo. A posição bruta não
// serve para comparar épocas (o número de países muda), então usamos o percentil: quantos por cento dos países
// estão à frente do Brasil naquele ano.
const ESCOLHIDOS = [
  "mortalidade_infantil", "expectativa_vida", "medio_completo_pct", "internet_pct", "eletricidade_pct",
  "gini", "pib_per_capita_ppp", "produtividade", "investimento_pct_pib", "comercio_pct_pib", "idh", "corrupcao",
];
const linhas = ESCOLHIDOS.map((id) => {
  const i = idx(id);
  if (!i || !(i.serie || []).length) return null;
  const s = i.serie as any[];
  const a = s[0], b = s[s.length - 1];
  const dezAnos = s.find((x) => x.ano >= b.ano - 10) ?? a;
  const variacao = a.valor ? ((b.valor - a.valor) / Math.abs(a.valor)) * 100 : 0;
  const var10 = dezAnos.valor ? ((b.valor - dezAnos.valor) / Math.abs(dezAnos.valor)) * 100 : 0;
  // percentil dentro do MESMO grupo de países (os que têm dado no primeiro e no último ano): é o único que
  // compara épocas. O percentil solto cresce ou encolhe só porque a lista de países muda.
  const pctl = (x: any) => (x.posicao_fixa && x.total_fixo ? (x.posicao_fixa / x.total_fixo) * 100 : null);
  const pctlSolto = (x: any) => (x.posicao && x.total ? (x.posicao / x.total) * 100 : null);
  // "melhorou" é o dado que decide, não nós: depende de o indicador ser melhor quando sobe ou quando desce
  const melhorou = i.maior_melhor ? variacao > 0 : variacao < 0;
  const melhorou10 = i.maior_melhor ? var10 > 0 : var10 < 0;
  return { ...i, a, b, variacao, var10, melhorou, melhorou10, pctlDe: pctl(a), pctlPara: pctl(b),
           soltoDe: pctlSolto(a), soltoPara: pctlSolto(b), serie: s };
}).filter(Boolean) as any[];

const melhoraram = linhas.filter((l) => l.melhorou).sort((a, b) => Math.abs(b.variacao) - Math.abs(a.variacao));
const pioraram = linhas.filter((l) => !l.melhorou).sort((a, b) => Math.abs(b.variacao) - Math.abs(a.variacao));
const perderamPosicao = linhas.filter((l) => l.pctlDe != null && l.pctlPara != null && l.pctlPara > l.pctlDe)
  .sort((a, b) => (b.pctlPara - b.pctlDe) - (a.pctlPara - a.pctlDe));

const mortInf = idx("mortalidade_infantil"), prod = idx("produtividade"), inv = idx("investimento_pct_pib");
const idh = idx("idh"), pibpc = idx("pib_per_capita_ppp");
const prodVar = prod ? ((prod.serie[prod.serie.length - 1].valor / prod.serie[0].valor) - 1) * 100 : 0;
const anosProd = prod ? prod.serie[prod.serie.length - 1].ano - prod.serie[0].ano : 0;

// nossos próprios painéis, que medem a mesma coisa por dentro
const escLongo = (educacao as any).escolaridade.longo;
const semFund91 = escLongo?.censos?.[0]?.ate_fundamental_incompleto;
const semFundHoje = escLongo?.pnadc?.[escLongo.pnadc.length - 1]?.ate_fundamental_incompleto;
const esgoto91 = (saneamento as any).censo["1991"].esgoto.pct;
const esgoto22 = (saneamento as any).censo["2022"].esgoto.pct;

// Gráfico de trajetória: onde o Brasil estava no primeiro ano da série e onde está hoje, em percentil.
// Uma linha por indicador, com a seta apontando o sentido — responde "subiu ou caiu" sem precisar ler tabela.
const TW = 920, TL = 250, TR = 120;
const trajeto = linhas.filter((l) => l.pctlDe != null && l.pctlPara != null)
  .map((l) => ({ ...l, delta: (l.pctlPara as number) - (l.pctlDe as number) }))
  .sort((a, b) => a.delta - b.delta);
const tx = (p: number) => TL + (p / 100) * (TW - TL - TR);
const anoMaisAntigo = Math.min(...trajeto.map((l) => l.a.ano));

// ── Por estado: quem mudou mais, e desde quando dá para medir ────────────────────────────────────────────────────
const edu = (uf as any).educacao, hom = (uf as any).homicidios;
const eduDe = edu.anos[0], eduPara = edu.anos[edu.anos.length - 1];
const homDe = hom.anos?.[0], homPara = hom.anos?.[hom.anos.length - 1];
const sanUf = (saneamento as any).censo_uf as Record<string, any[]>;
const sanDe = "1991", sanPara = "2022";
const mapaSan = (ano: string) => Object.fromEntries((sanUf[ano] ?? []).map((x: any) => [x.uf, x.esgoto]));
const sanA = mapaSan(sanDe), sanB = mapaSan(sanPara);

const estados = Object.keys(edu.por_uf[eduPara] ?? {}).sort();
const porEstado = estados.map((u) => {
  const eduVar = edu.por_uf[eduPara][u] - (edu.por_uf[eduDe]?.[u] ?? 0);
  const sanVar = sanB[u] != null && sanA[u] != null ? sanB[u] - sanA[u] : null;
  const homVar = hom.por_uf?.[homPara]?.[u] != null && hom.por_uf?.[homDe]?.[u] != null
    ? hom.por_uf[homPara][u] - hom.por_uf[homDe][u] : null;
  return { uf: u, eduDe: edu.por_uf[eduDe]?.[u], eduPara: edu.por_uf[eduPara][u], eduVar,
           sanDe: sanA[u], sanPara: sanB[u], sanVar,
           homDe: hom.por_uf?.[homDe]?.[u], homPara: hom.por_uf?.[homPara]?.[u], homVar };
});
const nomeUf = Object.fromEntries((sanUf[sanPara] ?? []).map((x: any) => [x.uf, x.nome]));
const topEdu = [...porEstado].sort((a, b) => b.eduVar - a.eduVar);
const topHom = porEstado.filter((e) => e.homVar != null).sort((a, b) => (a.homVar as number) - (b.homVar as number));
const topSan = porEstado.filter((e) => e.sanVar != null).sort((a, b) => (b.sanVar as number) - (a.sanVar as number));

// gráfico do percentil ao longo do tempo (quanto menor, melhor colocado)
const W = 920, L = 44, R = 170, H = 300, T = 16, B = 30;
const NO_GRAFICO = ["pib_per_capita_ppp", "produtividade", "investimento_pct_pib", "idh", "mortalidade_infantil"];
const CORES = ["#1d5a8a", "#c2185b", "#e07b00", "#1f9d55", "#6a1b9a"];
const curvas = NO_GRAFICO.map((id, i) => {
  const l = linhas.find((x) => x.id === id);
  if (!l) return null;
  const pts = l.serie.filter((x: any) => x.posicao_fixa && x.total_fixo)
    .map((x: any) => ({ ano: x.ano, p: (x.posicao_fixa / x.total_fixo) * 100 }));
  return pts.length ? { id, titulo: l.titulo, cor: CORES[i], pts } : null;
}).filter(Boolean) as any[];
const anoMin = Math.min(...curvas.flatMap((c) => c.pts.map((p: any) => p.ano)));
const anoMax = Math.max(...curvas.flatMap((c) => c.pts.map((p: any) => p.ano)));
const x = (ano: number) => L + ((ano - anoMin) / (anoMax - anoMin)) * (W - L - R);
const y = (p: number) => T + (p / 100) * (H - T - B);
---
<Base title="O Brasil está se desenvolvendo? — Nosso Dinheiro" accent="var(--s1)"
  description="Doze indicadores de desenvolvimento, da mortalidade infantil à produtividade, com a trajetória do Brasil desde 1960 e a posição do país no mundo ao longo do tempo.">
  <h1>O Brasil está se desenvolvendo?</h1>
  <p class="lede">
    Desenvolvimento não é um número, e é por isso que a resposta parece contraditória: o Brasil <strong>melhorou muito
    quase tudo que se mede por pessoa</strong> — morre-se menos criança, vive-se mais, estuda-se mais, há luz e
    internet onde não havia — e <strong>parou no que se mede por produção</strong>. A produtividade do trabalhador
    brasileiro cresceu {n1(prodVar)}% em {anosProd} anos. E, no ranking mundial, o país <strong>perdeu posição relativa em {perderamPosicao.length} dos
    {linhas.filter((l) => l.pctlDe != null && l.pctlPara != null).length} indicadores</strong> com série comparável —
    inclusive em renda por pessoa, produtividade e investimento: melhorou, mas os outros melhoraram mais rápido.
  </p>
  <p class="meta">fontes: Banco Mundial, PNUD, Transparência Internacional e IBGE · <a href="/metodologia/">metodologia</a> · <a href="/conferir/">como conferir</a></p>

  <div class="hero">
    <div class="stat big"><b>−{n1(Math.abs(mortInf.serie[0].valor - mortInf.serie[mortInf.serie.length - 1].valor) / mortInf.serie[0].valor * 100)}%</b>
      <span>a mortalidade infantil desde {mortInf.serie[0].ano}: de {n1(mortInf.serie[0].valor)} para {n1(mortInf.serie[mortInf.serie.length - 1].valor)} mortes por mil nascidos — a maior melhora de todas</span></div>
    <div class="stat"><b>+{n1(prodVar)}%</b><span>a produtividade do trabalho em {anosProd} anos; o Brasil saiu do {prod.serie[0].posicao}º para o {prod.serie[prod.serie.length - 1].posicao}º lugar</span></div>
    <div class="stat"><b>{n1(inv.b ?? inv.serie[inv.serie.length - 1].valor)}%</b><span>do PIB vira <Termo t="investimento">investimento</Termo> — era {n1(inv.serie[0].valor)}% em {inv.serie[0].ano}, e hoje é o {inv.serie[inv.serie.length - 1].posicao}º de {inv.serie[inv.serie.length - 1].total} países</span></div>
  </div>

  <div class="disclaimer"><span aria-hidden="true">ⓘ</span>
    <div><b>Esta página não diz por quê.</b> Explicar <i>por que</i> a produtividade parou ou por que o investimento
    caiu é disputa entre economistas, não dado — e aqui só entra o que está medido, com a fonte ao lado.
    <b>Posição bruta não compara épocas</b>: o número de países com dado muda de um ano para outro. Por isso usamos o
    <Termo t="percentil_pais">percentil</Termo> dentro de um <b>grupo fixo de países</b>: os que têm dado no primeiro
    e no último ano de cada série. Sem isso a conta engana — no acesso a energia elétrica a lista do Banco Mundial vai
    de 98 países em 1990 a 215 em 2024, e o Brasil "subiria" 36 pontos sem ter feito nada, só porque países mais pobres
    entraram na lista depois. Com o grupo fixo, a melhora real é de 3 pontos. A tabela traz sempre a posição bruta ao
    lado, para quem quiser conferir.</div>
  </div>

  <h2>O que melhorou</h2>
  <div class="card">
    <table>
      <thead><tr><th>Indicador</th><th class="num">Começo</th><th class="num">Hoje</th><th class="num">Variação</th><th class="num">Últimos 10 anos</th><th>Fonte</th></tr></thead>
      <tbody>{melhoraram.map((l) => (<tr>
        <td>{l.titulo}<br /><span class="sub">{l.unidade}</span></td>
        <td class="num">{n1(l.a.valor)}<br /><span class="sub">{l.a.ano}</span></td>
        <td class="num">{n1(l.b.valor)}<br /><span class="sub">{l.b.ano}</span></td>
        <td class="num">{sinal(l.variacao)}%</td>
        <td class={`num${l.melhorou10 ? "" : " neg"}`}>{sinal(l.var10)}%</td>
        <td class="desc">{l.fonte}</td></tr>))}
      </tbody>
    </table>
    <p class="src">
      A coluna "últimos 10 anos" existe porque uma melhora de 40 anos pode esconder uma década parada: quando ela
      aparece em vermelho, o indicador andou para trás no período recente mesmo tendo melhorado no total.
      Dois números nossos, que não vêm do Banco Mundial e contam a mesma história: os adultos sem o ensino fundamental
      caíram de {n1(semFund91)}% em 1991 para {n1(semFundHoje)}% hoje (<a href="/educacao/">Educação</a>) e os
      domicílios com esgoto ligado à rede subiram de {n1(esgoto91)}% para {n1(esgoto22)}% (<a href="/saneamento/">Saneamento</a>).
    </p>
  </div>

  <h2>O que parou ou piorou</h2>
  <div class="card">
    <table>
      <thead><tr><th>Indicador</th><th class="num">Começo</th><th class="num">Hoje</th><th class="num">Variação</th><th class="num">Últimos 10 anos</th><th>Fonte</th></tr></thead>
      <tbody>{pioraram.map((l) => (<tr>
        <td>{l.titulo}<br /><span class="sub">{l.unidade}</span></td>
        <td class="num">{n1(l.a.valor)}<br /><span class="sub">{l.a.ano}</span></td>
        <td class="num">{n1(l.b.valor)}<br /><span class="sub">{l.b.ano}</span></td>
        <td class="num neg">{sinal(l.variacao)}%</td>
        <td class={`num${l.melhorou10 ? "" : " neg"}`}>{sinal(l.var10)}%</td>
        <td class="desc">{l.fonte}</td></tr>))}
      </tbody>
    </table>
    <p class="src">
      "Piorou" aqui é o próprio dado que decide: cada indicador traz, na fonte, se é melhor quando sobe (investimento,
      abertura) ou quando desce (mortalidade, desigualdade). Nenhuma dessas linhas é opinião nossa sobre o que o país
      deveria fazer.
    </p>
  </div>

  <h2>Melhorou e mesmo assim caiu de posição</h2>
  <div class="card">
    <div class="legend">{curvas.map((c) => <span><i style={`background:${c.cor}`}></i>{c.titulo}</span>)}</div>
    <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label="Percentil do Brasil no mundo ao longo do tempo, em cinco indicadores">
      {[0, 25, 50, 75, 100].map((t) => <g>
        <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} stroke="var(--line)" />
        <text x={L - 6} y={y(t) + 4} text-anchor="end" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{t === 0 ? "1º" : `${t}%`}</text></g>)}
      {curvas.map((c) => (<g>
        <polyline points={c.pts.map((p: any) => `${x(p.ano).toFixed(1)},${y(p.p).toFixed(1)}`).join(" ")} fill="none" stroke={c.cor} stroke-width="2" />
        <text x={W - R + 8} y={y(c.pts[c.pts.length - 1].p) + 4} font-size="11" fill={c.cor}>{c.titulo}</text>
        {c.pts.filter((_: any, i: number) => i % 5 === 0).map((p: any) => <circle cx={x(p.ano)} cy={y(p.p)} r="2.5" fill={c.cor}><title>{c.titulo} · {p.ano}: o Brasil estava à frente de {n1(100 - p.p)}% dos países do grupo fixo</title></circle>)}
      </g>))}
      {[anoMin, Math.round((anoMin + anoMax) / 2), anoMax].map((a) => <text x={x(a)} y={H - 10} text-anchor="middle" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{a}</text>)}
    </svg>
    <p class="src">
      Quanto <b>mais baixa</b> a linha, melhor colocado o Brasil. O eixo é o percentil: 0 é o primeiro lugar do mundo,
      100 é o último. Como o número de países com dado muda a cada ano, essa é a única forma honesta de comparar a
      posição de 1990 com a de hoje. As linhas subindo mostram o ponto central desta página: <b>o Brasil melhorou em
      valor absoluto e perdeu posição relativa</b>, porque outros países melhoraram mais depressa.
    </p>
  </div>

  <h2>Subiu ou caiu? A posição do Brasil, do começo da série até hoje</h2>
  <div class="card">
    <svg viewBox={`0 0 ${TW} ${trajeto.length * 30 + 44}`} width="100%" role="img" aria-label="Posição do Brasil no mundo, do primeiro ano de cada série até hoje">
      {[0, 25, 50, 75, 100].map((t) => (<g>
        <line x1={tx(t)} x2={tx(t)} y1="20" y2={trajeto.length * 30 + 14} stroke="var(--line)" />
        <text x={tx(t)} y="13" text-anchor="middle" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{t === 0 ? "1º do mundo" : t === 100 ? "último" : `${t}%`}</text>
      </g>))}
      {trajeto.map((l, i) => {
        const y0 = i * 30 + 36;
        const de = tx(l.pctlDe as number), para = tx(l.pctlPara as number);
        const melhorou = (l.delta as number) < 0;
        const cor = melhorou ? "var(--s2)" : "#a3302a";
        return (<g>
          <text x={TL - 10} y={y0 + 4} text-anchor="end" font-size="12" fill="var(--ink)">{l.titulo}</text>
          <text x={TL - 10} y={y0 + 15} text-anchor="end" font-size="9.5" fill="var(--ink-2)">{l.a.ano} → {l.b.ano}</text>
          <line x1={de} x2={para} y1={y0} y2={y0} stroke={cor} stroke-width="3" opacity="0.5" />
          <circle cx={de} cy={y0} r="5" fill="var(--card)" stroke="var(--ink-2)" stroke-width="1.5">
            <title>{l.titulo} em {l.a.ano}: melhor que {n1(100 - (l.pctlDe as number))}% do grupo fixo de {l.a.total_fixo} países · no total daquele ano era {l.a.posicao}º de {l.a.total}</title></circle>
          <circle cx={para} cy={y0} r="6" fill={cor}>
            <title>{l.titulo} em {l.b.ano}: melhor que {n1(100 - (l.pctlPara as number))}% do grupo fixo de {l.b.total_fixo} países · no total de hoje é {l.b.posicao}º de {l.b.total}</title></circle>
          <text x={TW - TR + 10} y={y0 + 4} font-size="11" font-family="IBM Plex Mono, monospace" fill={cor}>
            {melhorou ? "subiu" : "caiu"} {n0(Math.abs(l.delta as number))} pts
          </text>
        </g>);
      })}
    </svg>
    <p class="src">
      Cada linha é um indicador. O <b>círculo vazio</b> é onde o Brasil estava no primeiro ano com dado comparável; o
      <b>círculo cheio</b>, onde está hoje. Quanto mais à <b>esquerda</b>, melhor colocado. Verde = o país ganhou
      posição; vermelho = perdeu. A série mais antiga começa em {anoMaisAntigo}, antes da Constituição, porque o Banco
      Mundial publica alguns indicadores desde 1960 — e não existe nada comparável entre países antes disso.
      A posição é medida <b>sempre dentro do mesmo grupo de países</b> (os que têm dado nas duas pontas da série), e
      não entre todos os que existem em cada ano: é o que impede que o Brasil pareça subir só porque a lista mudou.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <table>
      <thead><tr><th>Indicador</th><th class="num">No começo</th><th class="num">Era melhor que</th><th class="num">Hoje</th><th class="num">Posição hoje</th><th class="num">É melhor que</th></tr></thead>
      <tbody>{trajeto.map((l) => (<tr>
        <td>{l.titulo}<br /><span class="sub">{l.unidade}</span></td>
        <td class="num">{n1(l.a.valor)}<br /><span class="sub">{l.a.posicao}º de {l.a.total} · {l.a.ano}</span></td>
        <td class="num">{l.pctlDe != null ? pct(100 - (l.pctlDe as number)) : "—"}<br /><span class="sub">do grupo fixo</span></td>
        <td class="num">{n1(l.b.valor)}<br /><span class="sub">{l.b.ano}</span></td>
        <td class="num">{l.b.posicao}º de {l.b.total}</td>
        <td class="num">{l.pctlPara != null ? pct(100 - (l.pctlPara as number)) : "—"}</td></tr>))}
      </tbody>
    </table>
    <p class="src">
      "À frente de" é quantos por cento dos países o Brasil supera naquele indicador. Em alguns, estar bem colocado é
      ruim: a lista ordena pelo que o indicador considera melhor, e isso está na própria fonte. O ranking completo,
      com todos os países, está em <a href="/rankings/">Rankings</a>.
    </p>
  </div>


  <h2>Por estado: quem mudou mais</h2>
  <div class="card">
    <p style="margin:0 0 10px">
      Três dimensões têm série estadual comparável ao longo do tempo. Os mapas mostram a <b>mudança</b>, não o nível
      de hoje: quanto mais forte a cor, maior o avanço do estado no período.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 2px">Educação — adultos com ensino médio completo ou mais</h3>
    <p class="sub" style="margin:0 0 10px">variação em pontos percentuais, Censo de {eduDe} a {eduPara}</p>
    <MapaBrasil valores={Object.fromEntries(porEstado.map((e) => [e.uf, Number(e.eduVar.toFixed(1))]))}
      formato={(v) => `+${n1(v)} p.p.`} titulo={`Avanço na escolaridade por estado, de ${eduDe} a ${eduPara}`}
      legenda={`pontos percentuais a mais de adultos com médio completo (${eduDe}→${eduPara})`} cor="var(--s1)" />
    <p class="src">
      Todos os 27 estados avançaram. O maior avanço é {nomeUf[topEdu[0].uf] ?? topEdu[0].uf}
      ({n1(topEdu[0].eduDe)}% → {n1(topEdu[0].eduPara)}%, +{n1(topEdu[0].eduVar)} pontos) e o menor é
      {" "}{nomeUf[topEdu[topEdu.length - 1].uf] ?? topEdu[topEdu.length - 1].uf}
      ({n1(topEdu[topEdu.length - 1].eduDe)}% → {n1(topEdu[topEdu.length - 1].eduPara)}%).
      {" "}{edu.ressalva} Fonte: {edu.fonte}.
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 2px">Saneamento — domicílios com esgoto ligado à rede</h3>
    <p class="sub" style="margin:0 0 10px">variação em pontos percentuais, Censo de {sanDe} a {sanPara}</p>
    <MapaBrasil valores={Object.fromEntries(porEstado.filter((e) => e.sanVar != null).map((e) => [e.uf, Number((e.sanVar as number).toFixed(1))]))}
      formato={(v) => `${v > 0 ? "+" : ""}${n1(v)} p.p.`} titulo={`Avanço no esgoto ligado à rede por estado, de ${sanDe} a ${sanPara}`}
      legenda={`pontos percentuais a mais de domicílios com esgoto na rede (${sanDe}→${sanPara})`} cor="var(--s5)" />
    <p class="src">
      Maior avanço: {nomeUf[topSan[0].uf] ?? topSan[0].uf} ({n1(topSan[0].sanDe)}% → {n1(topSan[0].sanPara)}%).
      Menor: {nomeUf[topSan[topSan.length - 1].uf] ?? topSan[topSan.length - 1].uf}
      ({n1(topSan[topSan.length - 1].sanDe)}% → {n1(topSan[topSan.length - 1].sanPara)}%). Detalhe em
      {" "}<a href="/saneamento/">Saneamento</a>.
    </p>
  </div>

  {topHom.length > 0 && <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 2px">Segurança — homicídios por 100 mil habitantes</h3>
    <p class="sub" style="margin:0 0 10px">queda da taxa, de {homDe} a {homPara} (cor mais forte = caiu mais; valor negativo = subiu)</p>
    <MapaBrasil valores={Object.fromEntries(topHom.map((e) => [e.uf, Number((-(e.homVar as number)).toFixed(1))]))}
      formato={(v) => `${v > 0 ? "−" : "+"}${n1(Math.abs(v))}`} titulo={`Queda da taxa de homicídios por estado, de ${homDe} a ${homPara}`}
      legenda={`queda da taxa de homicídios por 100 mil (${homDe}→${homPara})`} cor="var(--s2)" />
    <p class="src">
      {nomeUf[topHom[0].uf] ?? topHom[0].uf} teve a maior queda: de {n1(topHom[0].homDe as number)} para
      {" "}{n1(topHom[0].homPara as number)} por 100 mil. Na outra ponta,
      {" "}{nomeUf[topHom[topHom.length - 1].uf] ?? topHom[topHom.length - 1].uf} foi de
      {" "}{n1(topHom[topHom.length - 1].homDe as number)} para {n1(topHom[topHom.length - 1].homPara as number)}.
      {" "}{hom.ressalva} Fonte: {hom.fonte}. As mortes violentas registradas pelas polícias, com recorte mais recente
      e por município, estão em <a href="/seguranca/">Segurança</a>.
    </p>
  </div>}

  <div class="card" style="margin-top:14px">
    <table>
      <thead><tr><th>Estado</th>
        <th class="num">Médio completo {eduDe}</th><th class="num">{eduPara}</th><th class="num">Variação</th>
        <th class="num">Esgoto {sanDe}</th><th class="num">{sanPara}</th><th class="num">Variação</th>
        <th class="num">Homicídios {homDe}</th><th class="num">{homPara}</th><th class="num">Variação</th></tr></thead>
      <tbody>{[...porEstado].sort((a, b) => b.eduVar - a.eduVar).map((e) => (<tr>
        <td>{nomeUf[e.uf] ?? e.uf}</td>
        <td class="num">{n1(e.eduDe)}%</td><td class="num">{n1(e.eduPara)}%</td><td class="num">+{n1(e.eduVar)}</td>
        <td class="num">{e.sanDe != null ? `${n1(e.sanDe)}%` : "—"}</td><td class="num">{e.sanPara != null ? `${n1(e.sanPara)}%` : "—"}</td>
        <td class="num">{e.sanVar != null ? `+${n1(e.sanVar)}` : "—"}</td>
        <td class="num">{e.homDe != null ? n1(e.homDe) : "—"}</td><td class="num">{e.homPara != null ? n1(e.homPara) : "—"}</td>
        <td class={`num${(e.homVar ?? 0) > 0 ? " neg" : ""}`}>{e.homVar != null ? `${e.homVar > 0 ? "+" : "−"}${n1(Math.abs(e.homVar))}` : "—"}</td></tr>))}
      </tbody>
    </table>
    <p class="src">Ordenado pelo avanço na escolaridade. Clique no cabeçalho para ordenar por outra coluna.</p>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin:0 0 8px">O que não dá para medir por estado desde 1991</h3>
    <ul class="limites">{((uf as any).fora as string[]).map((t) => <li>{t}</li>)}</ul>
    <p class="src">Faltar fonte comparável não é o mesmo que ir bem ou mal: é não saber. Quando existe série mais curta, ela está no painel próprio de cada assunto.</p>
  </div>

  <h2>O que este painel não responde</h2>
  <div class="card">
    <ul class="limites">
      <li><b>Por que parou.</b> Produtividade e investimento são o centro do debate econômico brasileiro há 40 anos; atribuir causa seria opinião.</li>
      <li><b>Se os indicadores medem a coisa certa.</b> PIB por pessoa não vê desigualdade; o IDH junta três coisas numa só; o índice de percepção da corrupção mede percepção, não corrupção.</li>
      <li><b>O ano de cada um é diferente</b>, porque cada país e cada instituição publicam no seu tempo. A tabela sempre diz qual é.</li>
      <li><b>O que não está em base internacional comparável</b> — qualidade da escola, tempo de espera no SUS, segurança jurídica — não aparece aqui, e a ausência não é sinal de que vai bem.</li>
    </ul>
  </div>

  <Glossario termos={["percentil_pais", "investimento", "produtividade_trabalho", "idh_indice", "gini"]} />
</Base>
