---
import Base from "../layouts/Base.astro";
import Termo from "../components/Termo.astro";
import Glossario from "../components/Glossario.astro";
import imp from "../../public/data/impostos.json";
const ANO = 2025;
const mods = import.meta.glob("../../public/data/poderes_*.json", { eager: true, import: "default" });
const poderes = (mods[`../../public/data/poderes_${ANO}.json`] as any[] | undefined) ?? null;
const orgaos = (mods[`../../public/data/poderes_orgaos_${ANO}.json`] as any[] | undefined) ?? [];
const categorias = (mods[`../../public/data/poderes_categoria_${ANO}.json`] as any[] | undefined) ?? [];
// Execução do ano corrente (parcial), para o quadro "orçamento atualizado × empenhado × pago".
const ANO_EXEC = new Date().getFullYear();
const execAtual = (mods[`../../public/data/poderes_${ANO_EXEC}.json`] as any[] | undefined) ?? null;

const brl0 = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
const compact = (v: number) =>
  v >= 1e12 ? `R$ ${(v / 1e12).toFixed(2).replace(".", ",")} tri`
  : v >= 1e9 ? `R$ ${(v / 1e9).toFixed(1).replace(".", ",")} bi` : v >= 1e6 ? `R$ ${(v / 1e6).toFixed(0)} mi` : brl0(v);
const pct = (a: number, b: number) => (b > 0 ? `${Math.round((a / b) * 100)}%` : "–");
const POP = 212_600_000; // IBGE, estimativa 2024 arredondada (ver metodologia)

const cores: Record<string, string> = { Legislativo: "var(--s1)", "Judiciário": "var(--s3)", Executivo: "var(--s2)",
  "Funções essenciais": "var(--s5)", "Dívida/Transferências": "var(--neutro)" };
const ORDEM = ["Executivo", "Judiciário", "Legislativo", "Funções essenciais"];

// Por Poder: máquina (e seu detalhe), políticas públicas, encargos especiais.
const soma = (f: (c: any) => boolean) => categorias.filter(f).reduce((s, c) => s + c.pago, 0);
const SUBS = ["Pessoal ativo e encargos", "Aposentados e pensionistas", "Custeio", "Investimento", "Outros"];
const coresSub = ["var(--s1)", "var(--s3)", "var(--s2)", "var(--s4)", "var(--neutro)"];
const resumo = ORDEM.map((p) => {
  const maquina = soma((c) => c.poder === p && c.categoria === "Manter a máquina");
  const politicas = soma((c) => c.poder === p && c.categoria === "Políticas públicas");
  const encargos = soma((c) => c.poder === p && c.categoria === "Encargos especiais");
  const subs = SUBS.map((s) => soma((c) => c.poder === p && c.categoria === "Manter a máquina" && c.subcategoria === s));
  return { poder: p, maquina, politicas, encargos, total: maquina + politicas + encargos, subs };
}).filter((r) => r.total > 0);
const maxMaquina = Math.max(1, ...resumo.map((r) => r.maquina));
const tres = resumo.filter((r) => ["Executivo", "Judiciário", "Legislativo"].includes(r.poder));
const previdencia = orgaos.filter((o) => o.cod_superior === "33000").reduce((s, o) => s + o.pago, 0);

// --- orçamento inteiro da União: dotação atualizada, empenhado e pago -------------------------------------
const somaCol = (arr: any[] | null, k: string) => (arr ?? []).reduce((t, x) => t + (x[k] ?? 0), 0);
const etapas = [
  { rotulo: "Orçamento atualizado da despesa", termo: "dotacao", chave: "dotacao" },
  { rotulo: "Empenhado", termo: "empenhado", chave: "empenhado" },
  { rotulo: "Pago", termo: "pago", chave: "pago" },
];
const dividaDe = (arr: any[] | null, k: string) => (arr ?? []).filter((x) => x.poder === "Dívida/Transferências").reduce((t, x) => t + (x[k] ?? 0), 0);
const pibSerie = (imp as any).carga?.serie ?? {};
const anoPib = Object.keys(pibSerie).sort().pop();
const pib = anoPib ? pibSerie[anoPib].pib * 1e9 : 0;          // a série do estudo vem em R$ milhões de milhão (bilhões)
const pagoTotal = somaCol(execAtual ?? poderes, "pago");
const pagoDivida = dividaDe(execAtual ?? poderes, "pago");
const pagoSemDivida = pagoTotal - pagoDivida;
// Para comparar com o PIB usamos só o ANO FECHADO: o ano em curso é despesa parcial contra PIB de 12 meses.
const fechadoSemDivida = somaCol(poderes, "pago") - dividaDe(poderes, "pago");

const maxP = Math.max(1, ...(poderes ?? []).map((p) => p.pago));
const topOrgaos = [...orgaos].filter((o) => o.poder !== "Dívida/Transferências").sort((a, b) => b.pago - a.pago).slice(0, 25);
const maxO = Math.max(1, ...topOrgaos.map((o) => o.pago));
---
<Base title="Quanto custa cada Poder da União? — Nosso Dinheiro" description="Despesa paga por Legislativo, Judiciário e Executivo, órgão por órgão. Fonte: Portal da Transparência." accent="var(--s2)">
  <h1>Quanto custa manter cada Poder da União?</h1>
  <p class="lede">
    O que Legislativo, Judiciário e Executivo gastaram em {ANO} para <Termo t="maquina"><strong>manter a própria máquina</strong></Termo>
    (salários, aposentados, prédios, custeio), separado do que o Executivo paga em <Termo t="politicas_publicas"><strong>políticas públicas</strong></Termo>
    (Previdência, SUS, Bolsa Família). Valores <Termo t="pago">pagos</Termo> no ano.
  </p>
  <p class="meta">fonte: SIOP (Ministério do Planejamento e Orçamento), execução orçamentária da União · valores pagos no ano</p>

  <div class="disclaimer"><span aria-hidden="true">ⓘ</span>
    <div><b>A divisão é a da própria Lei Orçamentária, não nossa.</b> Cada Poder tem um "Programa de Gestão e Manutenção"
    (pessoal ativo, aposentadorias e pensões do órgão, custeio, investimento). Tudo fora dele é programa finalístico
    (política pública) ou encargo especial (sentenças judiciais, por exemplo). Juros, amortização e transferências a
    estados e municípios ficam fora, em "Dívida/Transferências". <a href="/metodologia/">Metodologia</a>.</div>
  </div>


  <h2>O orçamento inteiro da União, do autorizado ao pago</h2>
  <div class="card">
    <table>
      <thead><tr><th>Etapa</th>{execAtual && <th class="num">{ANO_EXEC} (ano em curso)</th>}<th class="num">{ANO} (ano fechado)</th></tr></thead>
      <tbody>
        {etapas.map((e) => (<tr>
          <td><Termo t={e.termo}>{e.rotulo}</Termo></td>
          {execAtual && <td class="num"><b>{compact(somaCol(execAtual, e.chave))}</b></td>}
          <td class="num">{compact(somaCol(poderes, e.chave))}</td></tr>))}
        <tr><td class="sub">do pago, dívida e transferências a estados e municípios</td>
          {execAtual && <td class="num">{compact(dividaDe(execAtual, "pago"))}</td>}
          <td class="num">{compact(dividaDe(poderes, "pago"))}</td></tr>
        <tr class="destaque"><td>Pago sem dívida nem transferências</td>
          {execAtual && <td class="num"><b>{compact(somaCol(execAtual, "pago") - dividaDe(execAtual, "pago"))}</b></td>}
          <td class="num">{compact(somaCol(poderes, "pago") - dividaDe(poderes, "pago"))}</td></tr>
      </tbody>
    </table>
    <p class="src">
      <b>Por que o número é maior que o PIB brasileiro.</b> Mais da metade do orçamento da União é
      {" "}<Termo t="divida_transferencias">dívida e transferência</Termo>: o Tesouro emite título novo para pagar título que
      venceu (refinanciamento), e o mesmo dinheiro passa duas vezes pelo orçamento; e repassa aos estados e municípios
      recursos que eles tornam a gastar nos orçamentos deles. Tirando essas duas coisas, a União pagou
      {" "}<b>{compact(fechadoSemDivida)}</b> em {ANO}, o último ano fechado{pib ? <>, o equivalente a {pct(fechadoSemDivida, pib)} do PIB de {anoPib} ({compact(pib)}), que é o último com valor fechado no estudo da Receita</> : null}.{execAtual ? <> Em {ANO_EXEC} o pago sem dívida nem transferências vai em {compact(pagoSemDivida)}, com o ano ainda em curso.</> : null}
      {" "}Cuidado também com a unidade: o PIB que aparece em rankings internacionais costuma estar <b>em dólares</b> (US$ 2,28
      trilhões em 2024, no painel <a href="/rankings/">Rankings</a>), e não em reais.
    </p>
    <p class="src">
      Fonte: SIOP, execução orçamentária da União, grafo de {execAtual ? ANO_EXEC : ANO}. O ano em curso é <b>parcial</b>:
      o orçamento é do ano inteiro e o pago vai até a última atualização do SIOP. O painel "Despesas Públicas do Governo
      Federal" do Portal da Transparência publica os mesmos conceitos com números próximos, porém não idênticos (R$ 6,43
      trilhões de orçamento atualizado e R$ 4,76 trilhões pagos quando consultado em 27/10/2026, contra
      {" "}{compact(somaCol(execAtual ?? poderes, "dotacao"))} e {compact(pagoTotal)} aqui): são sistemas diferentes, o
      Portal lê o Siafi e o SIOP tem data de atualização própria. A diferença, de 2% a 4%, está registrada como pendência
      na <a href="/metodologia/">metodologia</a>; não a explicamos ainda e não ajustamos nada para fechar a conta.
    </p>
  </div>

  {poderes && resumo.length ? (
    <>
      <div class="hero">
        {tres.map((r) => (
          <div class="stat"><b>{compact(r.maquina)}</b>
            <span><strong>{r.poder}</strong> · manter a máquina · <Termo t="per_capita">{brl0(r.maquina / POP)}/habitante</Termo>
              {r.politicas > 1e9 ? ` · mais ${compact(r.politicas)} em políticas públicas` : ""}</span></div>
        ))}
      </div>

      <h2>Do que é feita a máquina de cada Poder</h2>
      <div class="card">
        <div class="legend">{SUBS.map((s, i) => <span><i style={`background:${coresSub[i]}`}></i>{["pessoal_ativo", "aposentados", "custeio", "investimento"][i] ? <Termo t={["pessoal_ativo", "aposentados", "custeio", "investimento"][i]}>{s}</Termo> : s}</span>)}</div>
        <svg viewBox={`0 0 920 ${resumo.length * 40 + 10}`} width="100%" role="img" aria-label="Composição da despesa de manutenção por Poder">
          {resumo.map((r, i) => {
            let x = 220;
            return (
              <g transform={`translate(0 ${i * 40 + 5})`}>
                <text x="212" y="19" text-anchor="end" font-size="13" fill="var(--ink)">{r.poder}</text>
                {r.subs.map((v, j) => {
                  const w = (v / maxMaquina) * 560; const x0 = x; x += w;
                  return <rect x={x0} y="4" width={Math.max(0, w)} height="22" fill={coresSub[j]} />;
                })}
                <text x={x + 6} y="19" font-size="12" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{compact(r.maquina)}</text>
              </g>
            );
          })}
        </svg>
        <table style="margin-top:14px">
          <thead><tr><th>Poder</th><th class="num"><Termo t="pessoal_ativo">Pessoal ativo</Termo></th><th class="num"><Termo t="aposentados">Aposentados e pensões</Termo></th><th class="num"><Termo t="custeio" /></th><th class="num"><Termo t="investimento" /></th><th class="num"><Termo t="maquina">Máquina</Termo></th><th class="num">% pessoal</th></tr></thead>
          <tbody>
            {resumo.map((r) => (
              <tr><td>{r.poder}</td><td class="num">{compact(r.subs[0])}</td><td class="num">{compact(r.subs[1])}</td>
                <td class="num">{compact(r.subs[2])}</td><td class="num">{compact(r.subs[3])}</td>
                <td class="num"><strong>{compact(r.maquina)}</strong></td><td class="num">{pct(r.subs[0] + r.subs[1], r.maquina)}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="src">Pessoal ativo inclui encargos patronais; no Executivo inclui militares ativos, e "aposentados" inclui inativos e pensões militares.
          Aposentadorias de órgãos extintos (Encargos Previdenciários da União, 72000) estão em Dívida/Transferências.</p>
      </div>

      <h2>Máquina × políticas públicas: a parte de cada um</h2>
      <div class="card">
        <div class="legend"><span><i style="background:var(--s1)"></i><Termo t="maquina" /></span><span><i style="background:var(--s4)"></i><Termo t="politicas_publicas" /></span><span><i style="background:var(--neutro)"></i><Termo t="encargos_especiais" /></span></div>
        <svg viewBox={`0 0 920 ${resumo.length * 40 + 10}`} width="100%" role="img" aria-label="Proporção entre manutenção e políticas públicas por Poder">
          {resumo.map((r, i) => {
            const partes = [[r.maquina, "var(--s1)"], [r.politicas, "var(--s4)"], [r.encargos, "var(--neutro)"]] as const;
            let x = 220;
            return (
              <g transform={`translate(0 ${i * 40 + 5})`}>
                <text x="212" y="19" text-anchor="end" font-size="13" fill="var(--ink)">{r.poder}</text>
                {partes.map(([v, c]) => { const w = (v / r.total) * 560; const x0 = x; x += w;
                  return <rect x={x0} y="4" width={Math.max(0, w)} height="22" fill={c} />; })}
                <text x="786" y="19" font-size="12" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{pct(r.maquina, r.total)} máquina</text>
              </g>
            );
          })}
        </svg>
        <p class="src">Total do Executivo inclui {compact(previdencia)} de Previdência Social. Base: despesa paga no ano, sem Dívida/Transferências.</p>
      </div>

      <h2><Termo t="despesa_paga">Despesa total paga</Termo>, por Poder</h2>
      <div class="card">
        <svg viewBox={`0 0 920 ${poderes.length * 34 + 10}`} width="100%" role="img" aria-label="Despesa paga por Poder">
          {poderes.map((p, i) => (
            <g transform={`translate(0 ${i * 34 + 5})`}>
              <text x="212" y="19" text-anchor="end" font-size="13" fill="var(--ink)">{p.poder}</text>
              <rect x="220" y="5" width={Math.max(2, (p.pago / maxP) * 560)} height="20" rx="2" fill={cores[p.poder] ?? "var(--s4)"} />
              <text x={226 + (p.pago / maxP) * 560} y="19" font-size="12" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{compact(p.pago)}</text>
            </g>
          ))}
        </svg>
        <p class="src">Dívida/Transferências = encargos financeiros e previdenciários da União, transferências a estados e municípios, operações oficiais de crédito e dívida pública (órgãos 71000–75000). Órgão = unidade orçamentária da LOA.</p>
      </div>

      <h2>Os 25 órgãos que mais gastaram</h2>
      <div class="card">
        <svg viewBox={`0 0 920 ${topOrgaos.length * 28 + 10}`} width="100%" role="img" aria-label="Despesa paga por órgão">
          {topOrgaos.map((o, i) => (
            <g transform={`translate(0 ${i * 28 + 5})`}>
              <text x="332" y="17" text-anchor="end" font-size="12" fill="var(--ink)">{(o.orgao ?? o.orgao_superior ?? "").slice(0, 48)}</text>
              <rect x="340" y="4" width={Math.max(2, (o.pago / maxO) * 440)} height="18" rx="2" fill={cores[o.poder] ?? "var(--s4)"} />
              <text x={346 + (o.pago / maxO) * 440} y="17" font-size="11" font-family="IBM Plex Mono, monospace" fill="var(--ink)">{compact(o.pago)}</text>
            </g>
          ))}
        </svg>
        <div class="legend" style="margin-top:12px">{Object.entries(cores).map(([k, c]) => <span><i style={`background:${c}`}></i>{k}</span>)}</div>
      </div>

      <h2>Todos os órgãos</h2>
      <table>
        <thead><tr><th>Poder</th><th><Termo t="orgao_superior" /></th><th><Termo t="unidade_orcamentaria">Órgão</Termo></th><th class="num"><Termo t="empenhado" /></th><th class="num"><Termo t="pago" /></th></tr></thead>
        <tbody>
          {[...orgaos].sort((a, b) => b.pago - a.pago).map((o) => (
            <tr><td>{o.poder}</td><td>{o.orgao_superior}</td><td>{o.orgao}</td><td class="num">{brl0(o.empenhado)}</td><td class="num">{brl0(o.pago)}</td></tr>
          ))}
        </tbody>
      </table>
      <Glossario termos={["maquina", "politicas_publicas", "encargos_especiais", "divida_transferencias", "funcoes_essenciais", "pessoal_ativo", "aposentados", "custeio", "investimento", "empenhado", "liquidado", "pago", "dotacao", "orgao_superior", "unidade_orcamentaria", "despesa_paga", "per_capita"]} />
    </>
  ) : (
    <div class="card">
      <h2 style="margin-top:0">Em construção — primeira carga pendente</h2>
      <p>O ETL (<code>etl/portal_transparencia/extract_poderes.py</code>) já está pronto; os dados aparecem aqui após a primeira execução agendada.</p>
    </div>
  )}
</Base>
