---
/**
 * Tabela de parlamentares + filtros estáticos (links) por UF e por partido. Zero JS: cada filtro é uma página
 * gerada no build (/deputados/uf/sp/, /senadores/partido/pt/).
 * Props: rows (já filtradas), todos (todas as linhas, p/ montar os links), proj (sufixo " (projeção)"),
 *        ufAtiva?, partidoAtivo?, base? ("/deputados" | "/senadores"), raiz? ("/" | "/senadores/"),
 *        rotuloNome? ("Deputado(a)" | "Senador(a)"), cotaKey? ("ceap" | "ceaps"), rotuloCota?.
 * A foto aparece quando o id está no manifesto `fotos.json` — os arquivos ficam em site/public/fotos, baixados por
 * `python -m etl.fotos.baixar` (reduzidas a 96 px) das fotos oficiais da Câmara e do Senado.
 */
import { slug } from "../lib/slug";
import fotos from "../../public/data/fotos.json";
const { rows, todos, proj = "", ufAtiva, partidoAtivo, base = "/deputados", raiz = "/deputados/",
        rotuloNome = "Deputado(a)", cotaKey = "ceap", rotuloCota = "Cota parlamentar" } = Astro.props;
const brl0 = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
// As fotos são servidas por este site (site/public/fotos), e não pelo servidor da Câmara ou do Senado: a Câmara
// devolve 503 quando o navegador pede as 513 de uma vez, e a URL do Senado é http, bloqueada dentro de página https.
// O manifesto diz quais ids já foram baixados — sem ele, sairia uma imagem quebrada para quem faltasse.
const casa = base.includes("senador") ? "senado" : "camara";
const comFoto = new Set<number>(((fotos as any)[casa] ?? []) as number[]);
const idDe = (r: any) => r.id_deputado ?? r.id_senador;
const fotoDe = (r: any) => (comFoto.has(idDe(r)) ? `/fotos/${casa}/${idDe(r)}.jpg` : null);
const temFoto = rows.some((r: any) => fotoDe(r));
const ufs = [...new Set<string>(todos.map((r: any) => r.uf))].sort();
const partidos = [...new Set<string>(todos.map((r: any) => r.partido))].sort();
---
<div class="filtros">
  <div><span class="rotulo">Estado</span>
    <a href={raiz} aria-current={!ufAtiva && !partidoAtivo ? "page" : undefined}>Todos</a>
    {ufs.map((uf) => <a href={`${base}/uf/${slug(uf)}/`} aria-current={ufAtiva === uf ? "page" : undefined}>{uf}</a>)}
  </div>
  <div><span class="rotulo">Partido</span>
    {partidos.map((p) => <a href={`${base}/partido/${slug(p)}/`} aria-current={partidoAtivo === p ? "page" : undefined}>{p}</a>)}
  </div>
</div>
<table>
  <thead><tr><th>#</th>{temFoto ? <th class="col-foto"><span class="vis-oculto">Foto</span></th> : null}<th>{rotuloNome}</th><th>Partido · UF</th><th class="num">{rotuloCota}</th><th class="num">Custo / mês</th><th class="num">Custo / ano{proj}</th></tr></thead>
  <tbody>
    {rows.map((r: any, i: number) => (
      <tr><td class="rank">{i + 1}</td>
          {temFoto ? <td class="cel-foto">{fotoDe(r) ? <img src={fotoDe(r)} alt="" width="36" height="48" loading="lazy" decoding="async" /> : null}</td> : null}
          <td>{r.nome}</td>
          <td><a href={`${base}/partido/${slug(r.partido)}/`}>{r.partido}</a> · <a href={`${base}/uf/${slug(r.uf)}/`}>{r.uf}</a></td>
          <td class="num">{brl0(r[cotaKey])}</td><td class="num">{brl0(r.custo_mensal_medio)}</td><td class="num">{brl0(r.custo_anual_projetado)}</td></tr>
    ))}
  </tbody>
</table>
<style>
  .filtros { display: flex; flex-direction: column; gap: 8px; margin: 0 0 12px; font-size: 13px; }
  .filtros > div { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
  .filtros .rotulo { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-2); margin-right: 6px; }
  .filtros a { text-decoration: none; color: var(--ink-2); font-weight: 600; padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line); background: var(--card); }
  .filtros a[aria-current] { background: var(--accent); color: #fff; border-color: var(--accent); }
  .filtros a:hover { border-color: var(--accent); color: var(--accent); }
  td a { color: inherit; text-decoration: none; border-bottom: 1px dotted var(--line); }
  .col-foto { width: 44px; } .cel-foto { padding: 2px 6px 2px 0; }
  .cel-foto img { display: block; width: 36px; height: 48px; object-fit: cover; border-radius: 4px; background: var(--line); }
  .vis-oculto { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
