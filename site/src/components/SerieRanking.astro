---
/**
 * Linha da posição do Brasil ao longo dos anos (SVG estático, zero JS). Eixo Y invertido: 1º no topo.
 * Props: serie [{ano, posicao, total, valor}], cor, fmt (função valor → texto), rotulo (nome do índice).
 */
const { serie, cor = "var(--s1)", fmt = (v: number) => String(v), rotulo = "" } = Astro.props as
  { serie: { ano: number; posicao: number; total: number; valor: number }[]; cor?: string; fmt?: (v: number) => string; rotulo?: string };
const W = 520, H = 150, L = 34, R = 14, T = 14, B = 26;
const anos = serie.map((p) => p.ano);
const a0 = Math.min(...anos), a1 = Math.max(...anos);
const maxPos = Math.max(...serie.map((p) => p.posicao)) * 1.08;
const x = (ano: number) => L + ((ano - a0) / Math.max(1, a1 - a0)) * (W - L - R);
const y = (pos: number) => T + ((pos - 1) / Math.max(1, maxPos - 1)) * (H - T - B);
const pts = serie.map((p) => `${x(p.ano).toFixed(1)},${y(p.posicao).toFixed(1)}`).join(" ");
const area = `${x(a0).toFixed(1)},${(H - B).toFixed(1)} ${pts} ${x(a1).toFixed(1)},${(H - B).toFixed(1)}`;
const ini = serie[0], fim = serie[serie.length - 1];
const melhor = serie.reduce((m, p) => (p.posicao < m.posicao ? p : m), serie[0]);
const pior = serie.reduce((m, p) => (p.posicao > m.posicao ? p : m), serie[0]);
const decadas = Array.from({ length: Math.floor(a1 / 10) - Math.floor(a0 / 10) + 1 }, (_, i) => (Math.floor(a0 / 10) + i) * 10).filter((d) => d >= a0 && d <= a1);
const ticks = [1, Math.round(maxPos / 2), Math.round(maxPos)].filter((v, i, arr) => arr.indexOf(v) === i);
---
{serie.length >= 3 ? (
  <figure class="serie">
    <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label={`Posição do Brasil em ${rotulo}, de ${a0} a ${a1}`}>
      {ticks.map((t) => (<g><line x1={L} x2={W - R} y1={y(t)} y2={y(t)} stroke="var(--line)" /><text x={L - 4} y={y(t) + 4} text-anchor="end" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{t}º</text></g>))}
      {decadas.map((d) => (<text x={x(d)} y={H - 8} text-anchor="middle" font-size="10" font-family="IBM Plex Mono, monospace" fill="var(--ink-2)">{d}</text>))}
      <polygon points={area} fill={cor} opacity=".08" />
      <polyline points={pts} fill="none" stroke={cor} stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" />
      {serie.map((p) => (<circle cx={x(p.ano)} cy={y(p.posicao)} r="3.5" fill={cor} opacity="0"><title>{p.ano}: {p.posicao}º de {p.total} · {fmt(p.valor)}</title></circle>))}
      <circle cx={x(ini.ano)} cy={y(ini.posicao)} r="3.5" fill={cor} /><circle cx={x(fim.ano)} cy={y(fim.posicao)} r="3.5" fill={cor} />
      <text x={x(ini.ano) + 6} y={y(ini.posicao) - 7} font-size="11" font-weight="700" fill="var(--ink)">{ini.ano}: {ini.posicao}º</text>
      <text x={x(fim.ano) - 6} y={y(fim.posicao) - 7} text-anchor="end" font-size="11" font-weight="700" fill="var(--ink)">{fim.ano}: {fim.posicao}º</text>
    </svg>
    <figcaption>Posição do Brasil entre os países com dado em cada ano ({ini.total} em {ini.ano}, {fim.total} em {fim.ano}). Melhor: {melhor.posicao}º em {melhor.ano}; pior: {pior.posicao}º em {pior.ano}. Valor: {fmt(ini.valor)} → {fmt(fim.valor)}.</figcaption>
  </figure>
) : null}
<style>
  .serie { margin: 10px 0 12px; }
  .serie svg { display: block; }
  .serie figcaption { font-size: 12px; color: var(--ink-2); margin-top: 4px; }
</style>
